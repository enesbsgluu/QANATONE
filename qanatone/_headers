# QANATONE — güvenlik başlıkları (Netlify bu dosyayı kendiliğinden okur)
#
# X-Frame-Options SAMEORIGIN: siteyi başka bir alan adı iframe'e alamaz.
#   Yönetim paneli (admin.html) siteyi kendi iframe'inde gösteriyor, o aynı
#   kaynakta olduğu için SAMEORIGIN yeterli. Bu başlık aynı zamanda
#   postMessage saldırısının en kolay yolunu kapatır.
# nosniff: tarayıcı içerik türünü tahmin etmeye çalışmaz.
# Referrer-Policy: dış sitelere tam adres sızmaz.
# Permissions-Policy: kullanmadığımız donanım izinleri kapalı.
#
# CSP şimdilik YALNIZCA RAPOR modunda. Sebebi: site tek dosya mimarisinde,
# bütün betik ve stiller satır içi ('unsafe-inline' zorunlu) ve web tasarım
# vitrini müşteri sitelerini canlı iframe'de gösteriyor (frame-src listesi
# içerikle birlikte değişiyor). Önce tarayıcı konsolunda ihlalleri izle;
# liste oturunca başlığın adını Content-Security-Policy yapıp raporu kaldır.

# shell.html'e ayrica noindex basligi: robots.txt taramayi engeller ama
# baska bir yerden baglanti gelirse yine de indekslenebilir. Baslik kesin.
/shell.html
  X-Robots-Tag: noindex

# Yonetim paneli: indekslenmesin. (Erisim korumasi DEGIL — Yayinla dugmesi
# gelince panele gercek bir giris ekrani gerekecek.)
/admin.html
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex

# Ortak varlıklar (2a): ana betik varlik/app.<hash>.js — ad İÇERİKTEN
# türetilen hash taşıdığı için sonsuz önbellek güvenli: içerik değişince
# ad değişir, eski ad zaten hiçbir sayfadan çağrılmaz. varlik/ ayrı klasör
# BİLEREK: Netlify kısmi dosya jokeri desteklemez; js/*'a immutable
# bassak hash'siz gsap/lenis de kapsanır ve güncellenemez olurdu.
/varlik/*
  Cache-Control: public, max-age=31536000, immutable

# Yeni kabuk (Astro, Faz 0): _astro varliklari icerik-hash'li — sonsuz onbellek
/yeni/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# PENCERE POLITIKASI (1 Eyl 2026, olculdu): film klipleri /yeni/varlik/
# altinda ve BU DOSYADA KAPSANMIYORDU (/varlik/* deseni /yeni/... yollarini
# kapsamaz). Sonuc: prolog geri sarildiginda pencere disina atilan klip
# TAM GOVDEYLE yeniden iniyordu — tam turda 39 klip/238 MiB yerine 75
# istek/456 MiB (35 klip iki kez). Tarayicinin disk onbellegi bu isin
# dogru araci. SURE 1 GUN, immutable DEGIL — bilerek: klip adlari
# icerik-hash'li degil (sahne34.mp4), yeniden encode ayni ada yazar;
# immutable bassak istemci bir yil bayat kalirdi. Adlar hash'lenirse
# (uretim zinciri karari) bu deger immutable'a cekilebilir. */
/yeni/varlik/*
  Cache-Control: public, max-age=86400

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; media-src 'self' blob:; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; frame-src https:; form-action 'self'

# SOKUM VE TASIMA TURU (4 Eyl 2026) — TUR4 §4 kesfinin uc boslugu:
# /yeni/404.html kok /404.html deseninin disindaydi (noindex yalniz meta),
# /yeni/font ve /yeni/img hicbir onbellek desenine girmiyordu. Font ve
# gorsel adlari hash'siz: 1 gun, immutable DEGIL (klip politikasiyla ayni).
/yeni/404.html
  X-Robots-Tag: noindex

/yeni/font/*
  Cache-Control: public, max-age=86400

/yeni/img/*
  Cache-Control: public, max-age=86400
