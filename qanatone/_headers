# QANATONE — güvenlik başlıkları (Netlify bu dosyayı kendiliğinden okur)
#
# X-Frame-Options SAMEORIGIN: siteyi başka bir alan adı iframe'e alamaz.
#   Yönetim paneli (admin.html) siteyi kendi iframe'inde gösteriyor, o aynı
#   kaynakta olduğu için SAMEORIGIN yeterli. Bu başlık aynı zamanda
#   postMessage saldırısının en kolay yolunu kapatır.
# nosniff: tarayıcı içerik türünü tahmin etmeye çalışmaz.
# Referrer-Policy: dış sitelere tam adres sızmaz.
# Permissions-Policy: kullanmadığımız donanım izinleri kapalı.
#
# CSP şimdilik YALNIZCA RAPOR modunda. Sebebi: site tek dosya mimarisinde,
# bütün betik ve stiller satır içi ('unsafe-inline' zorunlu) ve web tasarım
# vitrini müşteri sitelerini canlı iframe'de gösteriyor (frame-src listesi
# içerikle birlikte değişiyor). Önce tarayıcı konsolunda ihlalleri izle;
# liste oturunca başlığın adını Content-Security-Policy yapıp raporu kaldır.

# shell.html'e ayrica noindex basligi: robots.txt taramayi engeller ama
# baska bir yerden baglanti gelirse yine de indekslenebilir. Baslik kesin.
/shell.html
  X-Robots-Tag: noindex

# Yonetim paneli: indekslenmesin. (Erisim korumasi DEGIL — Yayinla dugmesi
# gelince panele gercek bir giris ekrani gerekecek.)
/admin.html
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex

# Ortak varlıklar (2a): ana betik varlik/app.<hash>.js — ad İÇERİKTEN
# türetilen hash taşıdığı için sonsuz önbellek güvenli: içerik değişince
# ad değişir, eski ad zaten hiçbir sayfadan çağrılmaz. varlik/ ayrı klasör
# BİLEREK: Netlify kısmi dosya jokeri desteklemez; js/*'a immutable
# bassak hash'siz gsap/lenis de kapsanır ve güncellenemez olurdu.
/varlik/*
  Cache-Control: public, max-age=31536000, immutable

# Yeni kabuk (Astro, Faz 0): _astro varliklari icerik-hash'li — sonsuz onbellek
/yeni/_astro/*
  Cache-Control: public, max-age=31536000, immutable

