---
/* S4 · Kanıt — iş kartları (Produx dizilimi: iş adı + ne yaptığımız
   etiketleri). RAKAM YOK, UYDURMA SÖZ YOK (kırmızı çizgi): kartta yalnız
   content.json'daki ad/etiket/anlatım var; res/metrik alanları BİLEREK
   basılmıyor. Yorum bloğu yapı olarak var, içerik `settings.testi.on`
   bayrağı panelden açılana dek kendini gizler; göründüğünde metin +
   unvan taşır, İSİM ALANI YOK (talimat). Görseller kökteki -k-640
   türevleri; boyutlar derleme anında sharp'la okunur (G1: width+height,
   ekran dışı lazy). Hareket yok (H1). */
import { icerik, T, kes } from '../icerik';
import sharp from 'sharp';
import { join } from 'node:path';

const projeler = [];
for (const p of (icerik.projects || [])) {
  if (!p.imgk6) continue;
  const yol = join(process.cwd(), '..', p.imgk6);
  const m = await sharp(yol).metadata();
  projeler.push({ ...p, gw: m.width, gh: m.height });
}
const yorumAcik = !!(icerik.settings && icerik.settings.testi && icerik.settings.testi.on);
const yorumlar = yorumAcik ? (icerik.testimonials || []).filter((t: any) => t.q && t.role) : [];
---
<section data-sahne="4">
  <div class="icgen">
    <p class="kunye"><i>04</i>KANIT</p>
    <h2 class="s1-buyuk" style="font-size:clamp(1.6rem,5vw,2.6rem)">Kurduğumuz sistemler.</h2>
    <p class="s1-alt" style="margin-bottom:44px">Her kartta işin adı ve o işte NE yaptığımız — süs değil, iş.</p>
    <div class="s4-kartlar">
      {projeler.map(p => (
        <article class="s4-kart">
          <img src={'/' + p.imgk6} width={p.gw} height={p.gh} loading="lazy"
            alt={p.name + ' — ' + T(p.tag)} />
          <div class="s4-icerik">
            <h3>{p.name}<span>{p.year}</span></h3>
            <div class="s4-cipler">
              {T(p.tag).split('·').map((c: string) => <span class="s4-cip">{c.trim()}</span>)}
            </div>
            <p>{kes(p.text, 'tr', 180)}</p>
          </div>
        </article>
      ))}
    </div>
    {yorumlar.length > 0 && <div class="s4-yorumlar">
      {yorumlar.map((y: any) => (
        <blockquote class="s4-yorum">
          <p>“{T(y.q)}”</p>
          <span>{T(y.role)}</span>
        </blockquote>
      ))}
    </div>}
  </div>
</section>
