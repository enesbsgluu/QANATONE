---
/* PROLOG · 1. DURAK — DAĞ.  A YAKLAŞIMI (gerçek 3B).
   Künye ve gerekçeler `src/stil/prolog.css` başında ve `src/prolog/gl.ts`
   başında; burada yalnız markup, "Geç" adası ve 3B'yi çağıran ada.

   MALZEME: `gorsel-kaynak/prolog/dag-ham.jpg` (4392×3095, siyah-beyaz
   Everest). Fotoğrafçı adı künyeye konmayacak (talimat).
   ÜRETEÇ: `prolog-derinlik.py` (harita) → `prolog-katman.py` (kesim +
   genişlik hesabı + `kunye.json`). ÖLÇÜ HİÇBİR YERDE ELLE YAZILMIYOR:
   dosya adları, kutular, oranlar, hızlar aşağıda künyeden okunuyor.

   İKİ YOL, TEK VARLIK KÜMESİ:
     A (işçi + OffscreenCanvas + WebGL2, hareket açık) — buradaki
       `<img>`ler HİÇ İNMEZ (`display:none` + lazy); aynı yedi dosyayı
       işçi kendisi çeker, sahneyi tuvale çizer, kamera vadiye iner.
     B (WebGL/işçi yok · hareket azaltma · JS yok) — `<img>`ler görünür,
       CSS katmanlı paralaks çalışır. Yedek yol için FAZLADAN BAYT YOK.

   İLK BOYA HER İKİ YOLDA DA CÜMLE: LCP elemanı tam ekran bir görsel
   değil, metin olarak kalır (tuval zaten LCP adayı değildir). Cümle,
   sahne hazır olduğunda görünmez-erişilebilir hâle geçer — ekran
   okuyucu ve bot onu okumaya devam eder.

   BOT PROLOGU DEĞİL GÖVDEYİ GÖRÜR: sahnede tek bir cümle var ve o
   cümle `<p>`; sayfanın `h1`i gövdede (hero) kalır. Katman görselleri
   `alt=""` + `aria-hidden` — anlam taşımıyorlar, sahne süs. */
import '../stil/prolog.css';
import KUNYE from '../prolog/kunye.json';
import SAHNE from '../prolog/sahne.json';

interface Props { dil?: 'tr' | 'en' }
const { dil = 'tr' } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const soz = dil === 'en' ? 'The source was always there.' : 'Kaynak hep vardı.';
const gec = dil === 'en' ? 'Skip' : 'Geç';

const MD = KUNYE.varyant.masaustu;
const MB = KUNYE.varyant.mobil;
const bul = (v: typeof MD, ad: string) => v.katman.find((k) => k.ad === ad)!;
/* Sıra ARKADAN ÖNE; hız yalnız yedek yolun (CSS paralaks) girdisi. */
const KATMANLAR = SAHNE.katman.map((k) => ({
  ad: k.ad, hiz: k.hiz, d: bul(MD, k.ad), m: bul(MB, k.ad),
}));
const kutu = (k: { kutu: number[] }, o: string) =>
  `--${o}x:${k.kutu[0]};--${o}y:${k.kutu[1]};` +
  `--${o}w:${(k.kutu[2] - k.kutu[0]).toFixed(5)};--${o}h:${(k.kutu[3] - k.kutu[1]).toFixed(5)}`;
/* Cümlenin dikey merkezi 3B'dekiyle AYNI noktadan gelir: sahne hazır
   olduğunda DOM cümlesi sönüp yerini tuvaldekine bırakıyor, ikisi
   farklı yerde dursa o an bir sıçrama olurdu. */
const sozY = ((1 - SAHNE.soz.merkez[1]) / 2 * 100).toFixed(2);
---
<section class="pr" aria-label={dil === 'en' ? 'Prologue' : 'Prolog'} data-kok={B}
  style={`--pr-oran-d:${MD.oran};--pr-oran-m:${MB.oran};--pr-soz-y:${sozY}%;` +
    `--pr-oncu-d:url(${B}/img/prolog/${MD.oncu.dosya});` +
    `--pr-oncu-m:url(${B}/img/prolog/${MB.oncu.dosya})`}>
  <div class="pr-yapis">
    <div class="pr-kare">
      {KATMANLAR.map((k) => (
        <div class={`pr-sar pr-${k.ad}`} style={`--hiz:${k.hiz}`}>
          <picture>
            <source media="(max-width: 760px)" type="image/webp"
              srcset={`${B}/img/prolog/${k.m.dosya}`} />
            <img class="pr-kat" data-kat={k.ad} src={`${B}/img/prolog/${k.d.dosya}`}
              width={k.d.gen} height={k.d.yuk} alt="" aria-hidden="true"
              loading="lazy" decoding="async" fetchpriority="low"
              style={`${kutu(k.d, 'd')};${kutu(k.m, 'm')}`} />
          </picture>
        </div>
      ))}
    </div>

    <p class="pr-soz">{soz}</p>

    {/* ATLANABİLİR: küçük "Geç" düğmesi sağ üstte, oturumda bir kez
        (sessionStorage). Düğme JS'siz de anlamlı olsun diye <button>;
        betik inmezse hiç basılmaz (aşağıdaki ada onu görünür yapıyor).
        Kaydırma sırasında düzen OKUMASI yok — tek iş `scrollIntoView`. */}
    <button class="pr-gec" type="button" hidden>{gec}</button>
  </div>
</section>

{/* SATIR İÇİ VE ERKEN: `<img>`lerin ayrıştırılmasından ÖNCE koşmalı,
    yoksa katmanlar bir kare boyanır ve LCP elemanı büyük bir görsel
    olur. WebGL yoklaması burada YAPILMIYOR — bağlam açmak ilk boyanın
    yoluna 2-10 ms koyuyor; WebGL çıkmazsa `gl.ts` sınıfı geri alır ve
    sahne yedek yola düşer. J1 tavanına giren tek satır bu. */}
<script is:inline>
  try {
    if (sessionStorage.getItem('pr1') === '1')
      document.documentElement.classList.add('pr-atla');
    else if (!matchMedia('(prefers-reduced-motion:reduce)').matches)
      document.documentElement.classList.add('pr-gl');
  } catch (e) { /* gizli sekme: yedek yol çalışır */ }
</script>

{/* ADA MODULE TASINDI (gece TUR 2b): src/prolog/ada.ts — J1 disi
    dinamik modul, Film surucusu kurulumda import eder. pr-atla erken
    gizleme yukaridaki is:inline'da (tekrar ziyarette tek kare flas
    olmasin). */}
