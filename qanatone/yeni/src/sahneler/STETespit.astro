---
/* S-TE · TESPİT (ücretsiz teşhis aracı) — göçün yedinci sahnesi.
   Kaynak: kök index.html · markup 4945-4980 · sonuç üreteci `render()`
   12240 · kota/hata yolu 12220 · CSS `.dg*` 4290-4380.
   Sapmalar ve gerekçeler stil/tespit.css başında.

   Anayasa: "form ve sonuç iskeleti statik HTML, etkileşim JS'i
   client:visible. Bu bizim canlı demomuz: ada bütçesi cömert olabilir
   ama YALNIZ kendi sahnesinde."

   Faz 2'nin S7Arac sahnesinin yerini alır: aynı aracı iki kez göstermek
   içeriği ikilerdi. Künye numarası (07) burada yaşıyor.

   İÇERİK: başlık/alt metin/düğme/not content.json `strings`ten
   (dge · dgh · dgp · dgbtn · dgnote) — eski tarafta da öyleydi, parite
   korundu. Sonuç iskeleti (halka, künye, ızgara) HTML'de doğar; JS
   yalnız DEĞER yazar, yapı kurmaz.

   ADA JS'İ: tek submit dinleyicisi. `fetch` KULLANICI EYLEMİYLE koşar —
   V1'in adıyla yazılmış istisnası. Açılışta hiçbir iş yapmaz: sınıf
   yazmaz, düzen okumaz (S-K turunun 158 ms'lik dersi). */
import '../stil/tespit.css';
import { icerik, T, suz } from '../icerik';

interface Props { dil?: 'tr' | 'en' }
const { dil = 'tr' } = Astro.props;
const s = (icerik.strings && (icerik.strings[dil] || icerik.strings.tr)) || {};
const g = (k: string): string => T(s[k], dil);
const en = dil === 'en';
/* Halkanın çevresi: r=43 → 2πr. JS aynı sayıyı yeniden hesaplamasın diye
   burada bir kez yazılır ve stroke-dasharray olarak basılır. */
const CEVRE = (2 * Math.PI * 43).toFixed(1);
/* DUZELTME LISTESI (sokum turu, 4 Eyl) — kaynak render() 11406-11416:
   kirmizi/sari kalemler PRIO sirasinda ilk uc. Sozluk (kaynak L.tr.f /
   L.en.f, PRIO) kabuk/tespit-fix.mjs'te; kabuk-derle varlik/
   tespit-fix.<dil>.json yazar, ada GONDERIMDE indirir (olculdu: HTML
   <template> hali gzip'e 1,3 KB ekliyor ve H18'i asiyordu). */
const WA = String((icerik.settings || {}).whatsapp || '').replace(/\D/g, '');

/* KAYNAK VERİSİNDE BOZULMA — `strings.tr.dgh` 2.825 BAYT (31 karakterlik
   cümle için). İçinde eski sitenin harf-harf düşme iskelesi var ve İKİ
   KEZ İÇ İÇE: `<span class="lt"><i style="--k: 0;"><span class="lt">
   <i style="--k: 0;">Ö</i></span></i></span>` — yani eski istemci kendi
   DOM'unu content.json'a geri yazmış. EN karşılığı temiz (69 bayt).
   Bozulma TEK anahtarda (tarandı); onarımı panelin işi, rapora yazıldı.
   Burada iskele AYIKLANIR: `lt` span'ları ve `--k` taşıyan `<i>`ler
   atılır, tasarımın kendi etiketleri (`<br>`, `span.thin`) KALIR.
   Yığın tutulur çünkü `</span>` iki farklı açılışı kapatabiliyor. */
const iskeleAyikla = (m: string): string => {
  const yigin: string[] = [];
  return String(m ?? '').replace(/<[^>]+>/g, (etiket) => {
    if (/^<span class="lt">$/.test(etiket)) { yigin.push('lt'); return ''; }
    if (/^<span class="thin">$/.test(etiket)) { yigin.push('thin'); return etiket; }
    if (/^<\/span>$/.test(etiket)) return yigin.pop() === 'thin' ? etiket : '';
    if (/^<i style="--k/.test(etiket) || /^<\/i>$/.test(etiket)) return '';
    return etiket;
  });
};
/* ============ B3 · HARF HARF DİKEY KAYMA (giydirme turu) ============
   Görev belgesi B3: "vertical text clip slide-down animation letter by
   letter". Kaynakta zaten vardı (`#tespit h2 .lt i` + `ltdrop`, kök
   4314-4324) ve iskelet turunda giydirmeye ertelenmişti — bu adanın
   sapma listesinin 1. maddesi. Şimdi geliyor.

   HARFLER DERLEMEDE BÖLÜNÜR, İÇERİKTEN DEĞİL: `strings.tr.dgh` eski
   istemcinin kendi DOM'unu geri yazdığı için bozuk (2.825 bayt, iç içe
   iki iskele). Bileşen o iskeleyi zaten ayıklıyordu; harfleri şimdi
   TEMİZ metinden kendisi üretiyor. Panel metni düzeldiğinde de çalışır.

   ERİŞİLEBİLİRLİK (görev belgesinin şartı): başlık tam metni
   `aria-label` ile taşır, parçalanmış gövde `aria-hidden`.

   H2/H5: harf OPAKLIĞA DOKUNMAZ. Kaynak `opacity:0`la başlıyordu; burada
   yalnız `transform` ve kapın `overflow:hidden`i — taban her zaman opak,
   destekleyemeyen tarayıcıda başlık yerinde ve tam. */
const harfle = (m: string): { html: string; n: number; duz: string } => {
  let k = 0, duz = '';
  const html = String(m ?? '').replace(/(<[^>]+>)|([^<]+)/g, (_t, etiket, metin) => {
    /* <br> düz metinde BOŞLUK sayılır; öteki etiketler geçer */
    if (etiket) { if (/^<br\s*\/?>/i.test(etiket)) duz += ' '; return etiket; }
    /* TEK GEÇİŞ: zincirlenmiş ikinci replace üretilmiş HTML'in üzerinde
       koşuyor ve öznitelik boşluklarını düz metne karıştırıyordu
       (aria-label "Öncekonuşmayalım." çıkıyordu — ölçüm yakaladı). */
    return [...String(metin)].map((ch) => {
      duz += ch;
      return /\s/u.test(ch) ? ch
        : `<span class="ste-lt"><i style="--k:${k++}">${ch}</i></span>`;
    }).join('');
  });
  return { html, n: Math.max(1, k), duz: duz.replace(/\s+/g, ' ').trim() };
};

---
<section class="ste-sahne" data-sahne="te" id="tespit" data-anlati>
  <div class="ste-ic">
    <div class="ste-bas">
      <p class="kunye">{g('dge')}</p>
      {(() => {
        const H = harfle(suz(iskeleAyikla(g('dgh')), ['em', 'b', 'br', 'span.thin']));
        /* adım: kaskadın toplam boyu 24vh; harf başına pay harf sayısına
           bölünür — TR 29, EN 38 harfte de aynı pencereye sığar (kaynakta
           sabit .028 sn'ydi ve uzun başlıkta taşıyordu) */
        return <h2 class="s1-buyuk ste-h2" aria-label={H.duz}
          style={`--adim:${(24 / H.n).toFixed(3)}`}>
          <span aria-hidden="true" set:html={H.html} />
        </h2>;
      })()}
      <p class="s1-alt">{g('dgp')}</p>
    </div>

    <div class="ste-kutu">
      <form class="ste-form" id="steForm">
        <label class="ste-giris">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
            stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg>
          <input id="steUrl" name="url" type="text" inputmode="url" autocomplete="url"
            spellcheck="false" required placeholder={en ? 'yoursite.com' : 'siteniz.com'}
            aria-label={en ? 'Site address' : 'Site adresi'} />
        </label>
        <button class="dugme" type="submit" id="steGo">{g('dgbtn')}</button>
      </form>
      <p class="ste-not" set:html={suz(g('dgnote'), ['em', 'b'])} />

      {/* Durum satırı: tarama, hata ve kota mesajları burada yaşar.
          `aria-live` ile ekran okuyucu sonucu duyar. */}
      <p class="ste-durum" id="steDurum" role="status" aria-live="polite"></p>

      {/* SONUÇ İSKELETİ — HTML'de doğar, `hidden` ile bekler. JS yalnız
          değer yazar ve `hidden`i kaldırır; yapı kurmaz (Anayasa). */}
      <div class="ste-sonuc" id="steSonuc" hidden>
        <div class="ste-ust">
          <div class="ste-halka">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <circle class="ste-halka-zemin" cx="50" cy="50" r="43" />
              <circle class="ste-halka-yay" id="steYay" cx="50" cy="50" r="43"
                stroke-dasharray={CEVRE} stroke-dashoffset={CEVRE} />
            </svg>
            <b id="steSkor">0</b>
          </div>
          <div class="ste-kunye">
            <span class="ste-host" id="steHost"></span>
            <h3 id="steHuküm"></h3>
            <p id="steOzet"></p>
            <p class="ste-meta" id="steMeta"></p>
          </div>
        </div>
        <p class="ste-uyari" id="steUyari" hidden></p>
        <ul class="ste-izgara" id="steIzgara"></ul>
        {/* DUZELTME LISTESI — iskelet HTML'de, `hidden`; ada secip klonlar. */}
        <div class="ste-fix" id="steFix" hidden data-wa={WA} data-sozluk={`/yeni/varlik/tespit-fix.${dil}.json`}
          data-msg={en ? 'Hi, I ran the check for {host} — score {skor}.' : 'Merhaba, {host} için kontrolü yaptım — skor {skor}. Bunları konuşmak istiyorum.'}>
          <p class="ste-fix-bas">{en ? 'Start with these three' : 'Önce şu üçü'}</p>
          <ol class="ste-fix-liste" id="steFixListe"></ol>
          <a class="dugme" id="steFixCta" target="_blank" rel="noopener" hidden>{en ? 'Have us fix these three' : 'Bu üçünü biz düzeltelim'}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* ADA — yalnız bu sahnenin işi. Açılışta SIFIR iş: tek dinleyici
     bağlanır, o kadar. `fetch` submit içinde (V1 istisnası). */
  const form = document.getElementById('steForm') as HTMLFormElement | null;
  if (form) {
    const url = document.getElementById('steUrl') as HTMLInputElement;
    const dugme = document.getElementById('steGo') as HTMLButtonElement;
    const durum = document.getElementById('steDurum') as HTMLElement;
    const sonuc = document.getElementById('steSonuc') as HTMLElement;
    const yay = document.getElementById('steYay') as unknown as SVGCircleElement;
    const skor = document.getElementById('steSkor') as HTMLElement;
    const host = document.getElementById('steHost') as HTMLElement;
    const hukum = document.getElementById('steHuküm') as HTMLElement;
    const ozet = document.getElementById('steOzet') as HTMLElement;
    const meta = document.getElementById('steMeta') as HTMLElement;
    const uyari = document.getElementById('steUyari') as HTMLElement;
    const izgara = document.getElementById('steIzgara') as HTMLElement;

    /* Kalem adları — kaynaktaki sözlüğün taşınan hâli. */
    const AD: Record<string, string> = {
      https: 'HTTPS', title: 'Başlık', desc: 'Açıklama', h1: 'H1', canonical: 'Canonical',
      schema: 'Şema', og: 'Paylaşım kartı', lang: 'Dil', robots: 'robots.txt',
      sitemap: 'Sitemap', alt: 'Görsel alt metni', imgdim: 'Görsel ölçüsü',
      imgfmt: 'Görsel biçimi', fonts: 'Yazı tipi', inline: 'Satır içi yük',
      blocking: 'Engelleyici kaynak', compress: 'Sıkıştırma', cache: 'Önbellek',
      reqs: 'İstek sayısı', analytics: 'Ölçümleme', contact: 'İletişim',
      local: 'Yerel işaret', viewport: 'Viewport', favicon: 'Favicon',
      hreflang: 'hreflang', ssl: 'Sertifika',
    };
    /* Hüküm eşikleri kaynaktan (12244): 85/70/50/0. */
    const HUKUM: [number, string, string][] = [
      [85, 'Sistem çalışıyor.', 'Yapı sağlam. Buradan sonrası hız ve içerik işi.'],
      [70, 'İyi ama açık var.', 'Temel yerinde; birkaç kalem talebi kaçırıyor.'],
      [50, 'Yarısı eksik.', 'Site duruyor ama seni bulan da bulamayan da var.'],
      [0, 'Talebi kaçırıyor.', 'Bu hâliyle gelen kişi seni bulamıyor ya da ulaşamıyor.'],
    ];
    const SEBEP: Record<string, string> = {
      blocked: 'Bu adres taranamıyor (site otomatik erişimi engelliyor).',
      unreachable: 'Siteye ulaşılamadı — adresi kontrol eder misin?',
      quota: 'Günlük tarama hakkı doldu. Yarın yine dene.',
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (dugme.disabled) return;
      dugme.disabled = true;
      sonuc.hidden = true;
      durum.textContent = 'Taranıyor…';
      try {
        const r = await fetch('/.netlify/functions/diagnose', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ url: url.value }),
        });
        const j = await r.json();
        if (!j.ok) {
          durum.textContent = SEBEP[j.reason] || 'Tarama tamamlanamadı.';
          return;
        }
        durum.textContent = typeof j.kalan === 'number'
          ? `Bugün ${j.kalan} tarama hakkın kaldı.` : '';
        host.textContent = j.finalUrl || j.host;
        const h = HUKUM.find(([n]) => j.score >= n)!;
        hukum.textContent = h[1];
        ozet.textContent = h[2];
        meta.textContent = `Ağırlık ${j.kb} KB · Kontrol ${(j.items || []).length}`
          + (j.cdn ? ` · ${j.cdn}` : '');
        uyari.hidden = !j.cfEylul;
        if (j.cfEylul) uyari.textContent =
          'robots.txt yapay zekâ tarayıcılarına kapalı — site sağlıklı olsa bile AI yanıtlarında görünmezsin.';
        /* Halka ve sayı: renk eşikleri kaynaktan (70/45). */
        const cevre = Number(yay.getAttribute('stroke-dasharray'));
        yay.style.stroke = j.score >= 70 ? '#22c55e' : j.score >= 45 ? '#f59e0b' : 'var(--red)';
        yay.setAttribute('stroke-dashoffset', (cevre * (1 - j.score / 100)).toFixed(1));
        skor.textContent = String(j.score);
        /* Sıra kaynaktaki gibi: önce kırmızılar, sonra sarılar, sonra yeşiller. */
        const sira: Record<string, number> = { fail: 0, warn: 1, ok: 2 };
        izgara.textContent = '';
        for (const it of [...(j.items || [])].sort((a: any, b: any) => sira[a.state] - sira[b.state])) {
          const li = document.createElement('li');
          li.className = 'ste-kalem ' + it.state;
          const ad = document.createElement('span');
          ad.textContent = AD[it.k] || it.k;
          li.appendChild(ad);
          if (it.v !== undefined && it.v !== '') {
            const v = document.createElement('em');
            v.textContent = String(it.v);
            li.appendChild(v);
          }
          izgara.appendChild(li);
        }
        /* DUZELTME LISTESI: sozluk JSON'u gonderimle iner ([anahtar, baslik,
           aciklama] dizisi PRIO sirasinda; son kayit "yok"); kirmizi/sari
           kalemlerden ilk uc, yoksa "yok" satiri; CTA WhatsApp (kaynak 11413). */
        const fix = document.getElementById('steFix') as HTMLElement;
        if (fix) {
          const sz: [string, string, string][] = await (await fetch(fix.dataset.sozluk!)).json();
          const kotu = new Set((j.items || []).filter((it: any) => it.state !== 'ok').map((it: any) => it.k));
          const aday = sz.filter((k) => kotu.has(k[0])).slice(0, 3);
          const liste = document.getElementById('steFixListe') as HTMLElement;
          liste.textContent = '';
          for (const [k, b, a] of (aday.length ? aday : sz.filter((k) => k[0] === 'yok'))) {
            const li = document.createElement('li'); li.dataset.k = k;
            const bb = document.createElement('b'); bb.textContent = b;
            const sp = document.createElement('span'); sp.textContent = a;
            li.append(bb, sp); liste.appendChild(li);
          }
          const cta = document.getElementById('steFixCta') as HTMLAnchorElement;
          const wa = fix.dataset.wa;
          cta.hidden = !(aday.length && wa);
          if (wa) cta.href = `https://wa.me/${wa}?text=${encodeURIComponent((fix.dataset.msg || '').replace('{host}', j.host || j.finalUrl || '').replace('{skor}', String(j.score)))}`;
          fix.hidden = false;
        }
        sonuc.hidden = false;
      } catch (err) {
        durum.textContent = 'Bağlantı hatası — tekrar dener misin?';
      } finally {
        dugme.disabled = false;
      }
    });
  }
</script>
