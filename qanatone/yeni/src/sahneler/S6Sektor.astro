---
/* S6 · Sektör — öne çıkanlar (talimat: mimarlık, sağlık, finans).
   İçerik content.json sectors'tan; 'mimarlık' anahtarı content'te yok,
   en yakın gerçek veri 'insaat' (İnşaat & müteahhitlik — Bab İç Mimarlık
   referansının kulvarı). Uydurma sektör kartı yazılmaz; Enes panelden
   sektör ekler/değiştirirse buradaki liste anahtarla güncellenir.
   Hareket yok (H1). */
import { icerik, T } from '../icerik';
const one = ['insaat', 'saglik', 'finans'];
const sektorler = one
  .map(k => (icerik.sectors || []).find((s: any) => s.k === k))
  .filter(Boolean);
---
<section data-sahne="6">
  <div class="icgen">
    <p class="kunye"><i>06</i>SEKTÖR</p>
    <h2 class="s1-buyuk" style="font-size:clamp(1.6rem,5vw,2.6rem)">Nerede kuruyoruz.</h2>
    <p class="s1-alt" style="margin-bottom:44px">Her sektörün kaybı başka yerden akar; sistem ona göre kurulur.</p>
    <div class="s6-dizi">
      {sektorler.map((s: any) => (
        <div class="s6-kart">
          <b>{T(s.n)}</b>
          <p>{T(s.d)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
