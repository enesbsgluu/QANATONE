---
/* S-H · HERO — Goc Anayasasi madde 3 (dokunulmaz, birebir).
   Kaynak: kok index.html markup 4525-4564 (2 Eyl itibariyla), CSS
   ayiklanmis eski.css 357-556 (+ mobil 2393-2420, 12px tabani 4142-4179).
   Sapmalarin listesi ve gerekceleri stil/hero.css basinda.

   Icerik content.json -> strings[dil] (tek kaynak); h1'in ikinci satiri
   panelde <em>/<b> tasir, TEK suzgecten gecer (Anayasa madde 6).
   Ada JS'i: yalniz saat — gorunurken kosan tek setInterval.            */
import '../stil/hero.css';
import { icerik, T, suz } from '../icerik';

interface Props { dil?: 'tr' | 'en' }
const { dil = 'tr' } = Astro.props;
const s = (icerik.strings && (icerik.strings[dil] || icerik.strings.tr)) || {};
const g = (k: string): string => T(s[k], dil);

/* HERO 3B TUPLERI — PANEL ANAHTARI (8 Eyl 2026, Enes).
   Panelde bu tus ZATEN VARDI (admin.html 383: "Hero 3B tupler" ->
   theme.motion.tubes) ve kaynak onu okuyordu (kok 7270:
   `if(!off(m.tubes) && m.level!=='off' && window.__tubesInit) __tubesInit()`).
   Kaynagin kendi yorumu vaadi de yaziyordu: "yalnizca applyTheme() 'tupler'
   anahtarini acik buldugunda yukleniyor. Kapaliysa tek bayt bile inmiyor."
   GOCTE BU BAG TASINMAMISTI: tuval kosulsuz basiliyor, `tup.js` de onu
   gorunce kuruyordu — yani paneldeki tus HICBIR SEY YAPMIYORDU.
   Bag burada kuruluyor: anahtar kapaliysa tuval HIC BASILMAZ, `tup.js`
   `if (!cv) return` ile cikar, 775 KB kutuphane (210 KB gzip) inmez,
   prefetch de olmaz. Prolog anahtariyla ayni aile, ayni desen.
   NEDEN BURADA, kabuk-derle'de degil: prolog yuvasi URETILEN DOSYA cunku
   Astro'nun modul grafigi film.css'i sayfaya bagliyordu; tubes.min.js
   `public/` altinda ve dinamik ithal — grafige hic girmiyor, o yuzden
   sade kosul yeterli.
   `level` de kaynaktaki gibi kapida: genel hareket seviyesi 'off' ise
   sus katmani da yok. */
const mo: any = (icerik.theme && (icerik.theme as any).motion) || {};
const kapali = (v: any) => v === 0 || v === false || v === 'off' || v === '0';
const tuplerAcik = !kapali(mo.tubes) && mo.level !== 'off';

/* Panelden gelen tek HTML parcasi bu satir; suzgec artik icerik.ts'te
   TEK yardimci fonksiyon (Anayasa madde 6). Hero'nun izin kumesi
   degismedi: yalniz <em> ve <b> (suz'un varsayilani). Cikti bayti
   birebir ayni oldugu dogrulandi. */
---
<section class="sh-sahne" data-sahne="h">
  <div class="sus-atmo" aria-hidden="true">
    <span class="sus-a1"></span><span class="sus-a2"></span>
    <span class="sus-a3"></span><span class="sus-a4"></span>
  </div>

  {/* TUPLER (sokum turu, 4 Eyl): kaynak markup 4527, CSS 399-401 — WebGL
      tup alani kok js/tubes.min.js'ten (devir sahnesiyle AYNI kaynak),
      bosta dinamik ithal; yalniz hero ekrandayken calisir (IO play/pause,
      kaynak 9077-9133). Dar ekran / dokunmatik / azaltma / t-notubes: yok.
      PANEL ANAHTARI (8 Eyl): kapaliysa tuval hic basilmaz — gerekce
      yukarida, frontmatter'da. */}
  {tuplerAcik && <canvas id="tubes" class="sus-tubes" aria-hidden="true"></canvas>}
  <div class="sus-eller" aria-hidden="true">
    <div class="sus-el sus-el-h"><span class="sus-suzul">
      <picture>
        <source media="(max-width:900px)" type="image/avif" srcset="/img/hand-human-m.avif" />
        <source media="(max-width:900px)" type="image/webp" srcset="/img/hand-human-m.webp" />
        <source type="image/avif" srcset="/img/hand-human.avif" />
        <img src="/img/hand-human.webp" alt="" width="888" height="774"
          fetchpriority="high" decoding="async" />
      </picture>
    </span></div>
    <div class="sus-el sus-el-r"><span class="sus-suzul">
      <picture>
        <source media="(max-width:900px)" type="image/avif" srcset="/img/hand-robot-m.avif" />
        <source media="(max-width:900px)" type="image/webp" srcset="/img/hand-robot-m.webp" />
        <source type="image/avif" srcset="/img/hand-robot.avif" />
        <img src="/img/hand-robot.webp" alt="" width="1244" height="855"
          fetchpriority="high" decoding="async" />
      </picture>
    </span></div>
  </div>

  {/* KADRAJ TURU (2 Eyl, Enes: "tam kadraja oturmuyor"): kaynakta metin
      adasi IKI katman — `.wrap` (4540: genislik %100, max 1280, gut dolgu,
      z4) icinde `.heroin` (4541: max 940). Yenide tek `.sh-ic` vardi ve
      hero'nun flex cocugu olarak ICERIK genisligine buzuluyordu: gercek
      tarayicida 940 yerine 680 px olculdu (lede'nin 600'u + 2 gut).
      `.sh-kap` = kaynak `.wrap`, `.sh-ic` = kaynak `.heroin`. */}
  <div class="sh-kap">
  <div class="sh-ic">
    <p class="sh-rozet"><span class="sh-nokta"></span><span>{g('badge')}</span></p>
    <h1 class="sh-h1">
      <span class="sh-l"><i>{g('h1a')}</i></span>
      <span class="sh-l"><i set:html={suz(g('h1b'))}></i></span>
    </h1>
    <p class="sh-lede">{g('lede')}</p>
    <div class="sh-cta">
      <a class="sh-void" href="#tespit"><i class="sus-halka" aria-hidden="true"></i><span
        >{g('cta1')}</span></a>
      {/* HEDEFSIZ KANCA DUZELTMESI (5 Eyl 2026, Enes: "demo iste butonu
          hem mobilde hem masaustunde yonlendirme yapmiyor"). `#cagri`
          diye bir id sitede HIC YOKTU (tum .astro taranarak olculdu:
          6 kancadan tek olusuzu buydu), dugme bu yuzden bostaydi.
          Kaynagin kendi hedefi: index.html 4551 `href="/#lead"`
          data-t="cta2" — SPA rotasi oldugu icin bas egik yazilmisti;
          yeni cok sayfali kabukta hero YALNIZ / ve /en/ sayfasinda
          basiliyor ve `id="lead"` (LeadKutu, .sil-kutu) ayni sayfada
          duruyor, o yuzden sayfa ici kanca yeter (tam yeniden yukleme
          yok). Kancanin nav altina kacmamasi zaten cozulmus:
          iletisim.css:69 `.sil-kutu{scroll-margin-top:24px}`. */}
      <a class="sh-btn" href="#lead">{g('cta2')}</a>
    </div>
    <p class="sh-meta">
      <span class="sh-saat" id="shSaat">--:--</span><i></i>
      <span>{g('hm2')}</span><i></i><b>{g('hm3')}</b>
    </p>
  </div>
  {/* KAYDIR GOSTERGESI ADANIN ALTINA TASINDI (7 Eyl 2026 — Enes:
      "'kaydir' yazisi yarim kalmasin, cok az cekersen siritabilir.
      Butonlarin altina cek, hepsi masaustu girisinde gorunur bir sekilde
      dursun, kayma olmasin" + "dip dibe degil, butonlarin altinda guzel
      bir bosluk birak").
      ONCE `.sh-sahne`ye gore `bottom:30px` idi, yani HERO'nun alt
      kenarina yasliydi. Hero kisa pencerelerde 100svh'yi asiyor
      (olculdu: dogal boy 814,4 px) ve gosterge ekranin ALTINDA kaliyordu:
      1280x720'de 64 px, 1366x768'de 16 px disarida — "yarim kalma" tam
      buydu. Simdi `.sh-kap`in (icerik adasinin) altina, kendi bosluguyla
      konumlanir; absolute oldugu icin hero'yu UZATMAZ ve `.sh-kap`
      paralaks almadigi icin sayfayla birlikte KAYMAZ. */}
  <div class="sus-kaydir" aria-hidden="true"><span>{g('scr')}</span><i></i></div>
  </div>
</section>

{/* TUP YUKLEYICI kabuk/efekt.js'te (tubes()): satir ici hali 1.699 B'ti ve
    J1'i 13.792'ye tasiyordu (tavan 12.800) — kaynakta da tubesKur ayni
    dosyadaydi; bosta inen kabuk modulu onu da kurar (0 satir ici bayt). */}

<script>
  /* Saat adasi. Yanindaki yazi "Istanbul · Dubai" — ziyaretcinin cihaz
     saatini degil ISTANBUL saatini gosterir (Londra'daki adam kendi
     saatini gorup "bunlar neyi olcuyor" demesin). Tek setInterval, 30 sn,
     ve YALNIZ hero ekrandayken kosar; ekrandan cikinca durur.
     Yedek yol eski kaynaktan duzeltilerek geldi: orada UTC+3 saati
     24'e gore sarilmiyordu, gece yarisindan sonra "24:10" yaziyordu. */
  const el = document.getElementById('shSaat');
  if (el) {
    const yaz = () => {
      let t: string;
      try {
        t = new Date().toLocaleTimeString('tr-TR',
          { timeZone: 'Europe/Istanbul', hour: '2-digit', minute: '2-digit' });
      } catch (e) {
        const d = new Date();
        t = String((d.getUTCHours() + 3) % 24).padStart(2, '0') + ':' +
            String(d.getUTCMinutes()).padStart(2, '0');
      }
      el.textContent = t;
    };
    let sayac = 0;
    new IntersectionObserver((g) => {
      if (g[0].isIntersecting) { yaz(); sayac = sayac || window.setInterval(yaz, 30000); }
      else { clearInterval(sayac); sayac = 0; }
    }).observe(el);
  }
</script>
