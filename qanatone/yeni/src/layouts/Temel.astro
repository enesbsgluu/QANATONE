---
/* Ortak kabuk. Baş sözleşmesi: title/description/canonical/hreflang/şema
   mevcut sitedekiyle eşdeğer; kesmeye kadar noindex (N1) ve canonical
   canlı kök karşılığına (kopya içerik doğmaz).

   SÖKÜM VE TAŞIMA TURU (4 Eyl 2026, Enes kararı) — eski sitenin ORTAK
   KABUĞU birebir geri geldi: perde (58 sayfanın hepsinde; film hariç),
   yıldız tuvali, grain, ajan imleci, üç sütunlu footer + bit damgası +
   alt satır. Markup kaynak kök index.html 4621-4629 (katmanlar) ve
   5478-5512 (footer). Hareket dili YENİ: rAF katmanları kabuk/efekt.js
   (dinamik ithal, boşta), GSAP/Lenis yok. Panel anahtarları
   (content.json theme.motion) derlemede <html> sınıfı/verisi olur —
   eskide applyTheme çalışma anında basıyordu (7257-7276).
   `kabuk={false}`: film sayfası — kendi tam ekran sahnesi, kabuk
   katmanları (yıldız/grain/imleç) ve perde orada doğmaz (prolog kapanış
   tabloları kabuksuz ölçüldü; footer kalır). */
import '../stil/aile.css';
import '../stil/font.css';
import '../stil/temel.css';
import '../stil/kabuk.css';
import Nav from '../parcalar/Nav.astro';
import Perde from '../parcalar/Perde.astro';
import { icerik, T, KOK } from '../icerik';
import sayfalarVeri from '../veri/sayfalar.json';

interface Props {
  dil?: 'tr' | 'en';
  baslik: string;
  aciklama: string;
  canonical: string;          /* canlı kök karşılığı */
  heleftr?: string; helefen?: string;  /* hreflang çifti (canlı kök) */
  sema?: object | null;
  etiket?: string;            /* başlıktaki rozet (ör. GEO) */
  /* `genis`: gövde sütununu kaynağın `.wrap` ölçüsüne açar (max 1280 +
     clamp(20,4vw,40) oluk = 1440'ta 1200 px içerik). Sadakat turu, 22 Ağu:
     /projeler arşivinin sütun sayısı KABIN genişliğinden türüyor (kaynak
     11056 `host.clientWidth`), 800 px'lik varsayılan gövdede o hesap
     kaynaktakinin yarısına düşüyordu. Opt-in — başka sayfa etkilenmez. */
  genis?: boolean;
  perde?: boolean;            /* karşılama perdesi (varsayılan var) */
  kabuk?: boolean;            /* yıldız/grain/imleç katmanları (varsayılan var) */
}
const { dil = 'tr', baslik, aciklama, canonical,
        heleftr, helefen, sema = null, etiket, genis = false,
        perde = true, kabuk = true } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const en = dil === 'en';
const s = (icerik.strings && icerik.strings[dil]) || {};
const m = (k: string, tr: string, enV: string): string => T((s as any)[k], dil) || (en ? enV : tr);
/* panel anahtarları — kaynak applyTheme 7257-7276: off(x) = x === 0 */
const mo = (icerik.theme && icerik.theme.motion) || {};
const off = (v: unknown) => v === 0 || v === '0' || v === false;
const htmlSinif = [off(mo.grain) && 't-nograin', off(mo.stars) && 't-nostars', off(mo.cursor) && 't-noagent'].filter(Boolean).join(' ') || undefined;
/* footer verisi — kaynak renderWa 7457-7467 (sahte 905000000000 düşüşü TAŞINMADI: numara yoksa bağ basılmaz) */
const ayar = icerik.settings || {};
const waNum = String(ayar.whatsapp || '').replace(/\D/g, '');
const waUrl = waNum ? `https://wa.me/${waNum}?text=${encodeURIComponent(ayar.waMessage || 'Merhaba')}` : '';
const on = en ? '/en' : '';
/* OLCUM (kaynak analytics 10765-10783 birebir): settings.gtm doluysa
   GTM-… ya da G-… yuklenir; boska HICBIR SEY basilmaz (bugun bos). */
const gtm = String(ayar.gtm || '').trim();
/* PAYLASIM KARTI (gece zinciri TUR 5, 2 Eyl 2026): yeni site og ve twitter
   etiketi basmiyordu (eski sitede vardi: og:image kok/og.png + summary_large_image).
   settings.og doluysa o (tam adres), bossa canli kok og.png (1200x614 —
   olcusu Enes'in kararinda, F1 notu). Baslik/aciklama S1 ile ayni kaynak. */
const ogImg = String(ayar.og || '').trim() || KOK + '/og.png';
const GTM_KOD = gtm ? `(function(){var id=${JSON.stringify(gtm)};window.dataLayer=window.dataLayer||[];var add=function(s){var sc=document.createElement('script');sc.async=true;sc.src=s;document.head.appendChild(sc)};if(/^GTM-/i.test(id)){window.dataLayer.push({'gtm.start':Date.now(),event:'gtm.js'});add('https://www.googletagmanager.com/gtm.js?id='+encodeURIComponent(id))}else{add('https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(id));window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('js',new Date());window.gtag('config',id)}})()` : '';
/* TUR 9 (3 Eyl 2026): footer sayfa listesi TEK KAYNAKTAN (veri/sayfalar.json,
   `footer` sirasi) — onceden burada, Nav'da ve sitemap'te uc ayri kopya. */
const SAYFALAR: [string, string, string, string][] = (sayfalarVeri as any).statik
  .filter((s: any) => s.footer != null)
  .sort((a: any, b: any) => a.footer - b.footer)
  .map((s: any) => [s.yol, s.anahtar, s.tr, s.en]);
---
<html lang={dil} class={htmlSinif} data-imlec-gizle={off(mo.hideCursor) ? '0' : undefined} data-tur={off(mo.tour) ? '0' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{baslik}</title>
  <meta name="description" content={aciklama} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={baslik} />
  <meta property="og:description" content={aciklama} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:locale" content={en ? 'en_US' : 'tr_TR'} />
  <meta name="twitter:card" content="summary_large_image" />
  {heleftr && <link rel="alternate" hreflang="tr" href={heleftr} />}
  {helefen && <link rel="alternate" hreflang="en" href={helefen} />}
  {heleftr && <link rel="alternate" hreflang="x-default" href={heleftr} />}
  {sema && <script type="application/ld+json" set:html={JSON.stringify(sema)} />}
  <slot name="bas" />
  {GTM_KOD && <script is:inline set:html={GTM_KOD} />}
</head>
<body>
  {/* TUR 9 E1 (3 Eyl 2026): atlama bağlantısı — ilk Tab durağı. Ölçüldü:
      klavye kullanıcısı ana sayfada içeriğe 31. durakta varıyordu (WCAG
      2.4.1). Ekran dışı durur, odaklanınca görünür (temel.css .atla). */}
  <a class="atla" href="#icerik">{m('atla', 'İçeriğe geç', 'Skip to content')}</a>
  {perde && <Perde />}
  {/* KAYNAK 4621-4629: yıldız tuvali · grain · ajan imleci katmanları.
      Hepsi aria-hidden dekor; balon (#bitsay) diyalog. Tuvaller JS'siz
      boş durur (CSS gizler: dar ekran/dokunmatik/azaltma). */}
  {/* SADAKAT(D) 3 Eyl 2026: kaynak 4458-4460 `#bg` — sabit arka plan
      katmani (ust kizil gecis .fade + orb + nokta kafesi .grid). Sokum
      turunda stars/noise tasinmis, #bg atlanmisti; yan yana karede her
      bolumun ustundeki kizil hale bundan eksikti (kontak-tur9/sadakat-d). */}
  {kabuk && <div id="bg" aria-hidden="true"><span class="fade"></span><span class="orb"></span><span class="grid"></span></div>}
  {kabuk && <canvas id="stars" aria-hidden="true"></canvas>}
  {kabuk && <div id="noise" aria-hidden="true"></div>}
  {kabuk && <div id="bit" class="kb-bit" aria-hidden="true"><span class="kb-ring"></span><span class="kb-core"></span></div>}
  {kabuk && <div id="bittip" class="kb-tip" aria-hidden="true"></div>}
  {kabuk && <div id="bitsay" class="kb-say" role="dialog" aria-label={m('bitw', 'QANATONE ajanı', 'QANATONE agent')} aria-live="polite">
    <div class="who"><i></i><span>{m('bitw', 'QANATONE ajanı', 'QANATONE agent')}</span></div>
    <p id="bitmsg"></p><div class="acts" id="bitacts"></div>
  </div>}
  {/* Tasarım turu A1: Faz 1'in minimal .ust kabuğu yerini gerçek
      NAV'a bıraktı (Enes hükmü: "menü bile yok, logo bile yok"). */}
  <Nav dil={dil} />
  {/* id + tabindex=-1: atlama bağlantısı hedefi; odak main'e düşer, sonraki
      Tab içerikten sürer (Chrome/Safari çapaya atlayınca odağı taşımıyor). */}
  <main id="icerik" tabindex="-1" class={genis ? 'genis' : undefined}>
    <slot />
  </main>
  {/* FOOTER — kaynak 5478-5512 birebir: üç sütun (tanıtım / Sayfalar /
      İletişim) + QANATONE bit damgası + alt satır. Sosyal (#footSocial)
      kaynakta da boştu (settings.social yok). /hukuki bağı yeni sayfanın
      (öksüz kalmasın); "ana site" göç iskelesi bağı KALKTI. */}
  <footer>
    <div class="wrap">
      <div class="fgrid">
        <div class="lead">
          <a class="flogo" href={`${B}${on || '/'}`}>
            <i><picture>
              <source srcset={`${B}/img/qanatone.avif`} type="image/avif" />
              <img src={`${B}/img/qanatone.webp`} alt="" width="240" height="270" decoding="async" loading="lazy" />
            </picture></i>
            <b>QANAT<span>ONE</span></b>
          </a>
          <p>{m('foot1', 'Talebi yakalayan sistemler kuruyoruz: arama görünürlüğü, reklam ve 7/24 çalışan yapay zekâ ajanları.', 'We build systems that catch demand: search visibility, ads and AI agents working 24/7.')}</p>
        </div>
        <div class="fcol">
          <h5>{m('fc1', 'Sayfalar', 'Pages')}</h5>
          {SAYFALAR.map(([r, k, tr, enV]) => <a href={`${B}${on}${r}`}>{m(k, tr, enV)}</a>)}
        </div>
        <div class="fcol">
          <h5>{m('fc2', 'İletişim', 'Contact')}</h5>
          {waUrl && <a href={waUrl} target="_blank" rel="noopener">WhatsApp</a>}
          {ayar.email && <a href={`mailto:${ayar.email}`}>{m('fmail', 'E-posta', 'Email')}</a>}
          {/* ANAYASA (3 Eyl): kaynak #footSocial (7152-7155) C.socials'tan
              basar — varsayilan Instagram (6374), sema H25'in sameAs kaynagi.
              "Kaynakta bostu" notu yanlisti; yan yana kare: eski WhatsApp +
              Instagram, yeni yalniz WhatsApp (kontak-tur9/sadakat-e-kabuk-100). */}
          {(icerik.socials || []).filter((s: any) => s && s.url).map((s: any) =>
            <a href={s.url} target="_blank" rel="noopener">{s.label || s.url}</a>)}
        </div>
      </div>
    </div>
    <div class="watermark"><h2 class="vh">QANATONE</h2><canvas id="wmk" aria-hidden="true"></canvas></div>
    <div class="wrap">
      <div class="fbot">
        <span>{T(icerik.legal?.line, dil) || '© QANATONE'} · <a href={B + '/hukuki'}>{en ? 'Legal' : 'Hukuki'}</a></span>
        <span class="r">
          <span>{m('fb1', 'İstanbul · Dubai', 'Istanbul · Dubai')}</span>
          <span>{m('fb2', 'SEO · GEO · Ads · AI', 'SEO · GEO · Ads · AI')}</span>
        </span>
      </div>
    </div>
  </footer>
  {/* KABUK TETİĞİ: rAF katmanları (yıldız, bit damgası, imleç) boşta
      dinamik ithal — J1 dışı (film motoru deseni), kendi tavanı K1.
      Hareket azaltmada damga statik kare çizer, öbürleri hiç kurulmaz
      (modül içinde de kapılı). `?kabuk=0` ÖLÇÜM KOLU: kabuksuz taban
      (olc-sayfa yan yana kıyası). YORUMSUZ satır içi: her bayt çıktıya gider. */}
  {kabuk && <script is:inline>(function(){if(location.search.indexOf('kabuk=0')>-1)return;var f=function(){import('/yeni/varlik/kabuk.js').then(function(m){m.baslat()}).catch(function(){})};'requestIdleCallback'in window?requestIdleCallback(f,{timeout:2500}):setTimeout(f,600)})()</script>}
</body>
</html>
