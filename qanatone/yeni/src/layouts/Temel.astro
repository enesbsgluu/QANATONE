        <div class="fcol">
          <h5>{m('fc1', 'Sayfalar', 'Pages')}</h5>
          {SAYFALAR.map(([r, k, tr, enV]) => <a href={sl(`${B}${on}${r}`)}>{m(k, tr, enV)}</a>)}
