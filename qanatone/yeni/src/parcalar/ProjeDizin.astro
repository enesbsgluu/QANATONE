---
/* Projeler dizini gövdesi — TR ve EN aynı parçayı kullanır (rota turu).
   Bütün metin ve sıra content.json'dan. Eski sayfanın iskeleti: başlık +
   sayı + giriş + 7 kart (yıl/etiket/ad/anlatım/rakamlar/Projeyi gör).
   Taşınmayanlar (bilinçli, rapora yazıldı): sektör filtre çipleri —
   sektörler anahtarsız metinden türediği için saf CSS filtre panelden
   gelen yeni sektörde SESSİZCE bayatlar; etkileşimsiz çip basmak da
   tıklanmayan düğmedir. Giriş cümlesinin "sektöre göre filtrele"
   parçası bu yüzden kırpıldı.

   B7 AKORDEON DENENDİ VE GERİ ALINDI (21 Ağustos, Enes). Dizin kart
   listesi olarak kalıyor. Akordeondan alınan tek şey duotone geçişi:
   KART DİNLENİRKEN KÜÇÜK GÖRSEL DUOTONE, HOVER'DA GERÇEK RENGE DÖNÜYOR.
   Kart da hover'da kalkıyor. Dikey galeri görselleri rafa kalktı;
   üreteci (`gorsel-kompoze.cjs`) duruyor, istenirse yeniden basar.

   Kart kucuk gorseli (giydirme, 20 Agu): olculer kunyeden — uretec
   `gorsel-uret.cjs` yazar, bilesen ELLE olcu yazmaz. Kunyede olmayan
   proje gorselsiz basilir (panelden yeni proje senaryosu). */
import { getCollection } from 'astro:content';
import { icerik, T, type Dil } from '../icerik';
import prjGorsel from '../veri/proje-gorselleri.json';
const gorselMap = new Map(prjGorsel.map((g: any) => [g.slug, g]));
interface Props { dil: Dil }
const { dil } = Astro.props;
const M = (tr: string, en: string) => dil === 'en' ? en : tr;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const sira = (icerik.projects || []).map((p: any) => p.slug);
const projeler = (await getCollection('projeler')).map(e => e.data)
  .sort((a: any, b: any) => sira.indexOf(a.slug) - sira.indexOf(b.slug));
const on = dil === 'en' ? '/en' : '';
---
<section class="giris">
  <h1>{M('Tüm projeler.', 'All projects.')}
    <span class="say">({projeler.length})</span></h1>
  <p class="lede">{M(
    'Kurduğumuz her sistem burada. Birine gir; neyi çözdüğümüzü ve ne çıktığını gör.',
    'Every system we built. Open one, see what it solved and what came out.')}</p>
</section>

<div class="isler">
  {projeler.map((p: any) => { const g: any = gorselMap.get(p.slug); return (
    <article class="is">
      {/* Duotone iki katman tek değişkende (`--k`): ::before karartma,
          ::after kızıl hue. Kızıl DOSYAYA BASILI DEĞİL — pul gerçek
          renkte duruyor, kart dinlenirken CSS kızıla çeviriyor. */}
      {g && <span class="pul-k">
        <img class="pul" src={`${B}/img/pt/${p.slug}.webp`}
          width={g.thumb.w} height={g.thumb.h} loading="lazy" decoding="async" alt="" />
      </span>}
      <div class="icerik">
        <p class="kunye"><span class="yil">{p.year}</span> · {T(p.tag, dil)}</p>
        <h2>{p.name}</h2>
        <p>{T(p.text, dil)}</p>
        {p.res?.length > 0 && <ul class="rakamlar">
          {p.res.map((r: any) => <li><b>{r.v}</b> {T(r.l, dil)}</li>)}
        </ul>}
        <a class="git" href={`${B}${on}/projeler/${p.slug}`}>{M('Projeyi gör', 'View project')}</a>
      </div>
    </article>
  ); })}
</div>

<style>
  .say { color: var(--tx3); font-weight: 400; font-size: .7em; }
  .isler { display: flex; flex-direction: column; gap: 14px; }
  .is { display: flex; gap: 16px; align-items: flex-start;
    border: 1px solid var(--line); border-radius: 14px; padding: 18px; }
  .is .icerik { min-width: 0; }
  /* SABIT 104 CSS px kutu — uretecin 208w varyanti tam 2,0x (kural 109) */
  .pul-k { flex: none; width: 104px; height: 78px; border-radius: 10px;
    overflow: clip; }
  .pul { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 560px) { .pul-k { width: 88px; height: 66px; } }
  .is .kunye { color: var(--tx3); font-size: .8rem; margin-bottom: 6px; }
  .is .yil { font-family: ui-monospace, monospace; color: var(--red-soft); }
  .is h2 { font-size: 1.05rem; margin: 0 0 6px; }
  .is .icerik > p:not(.kunye) { color: var(--tx2); font-size: .92rem; }
  .rakamlar { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 10px; }
  .rakamlar li { color: var(--tx3); font-size: .84rem; }
  .rakamlar b { color: var(--red-soft); font-family: ui-monospace, monospace; margin-right: 4px; }
  .git { display: inline-block; margin-top: 12px; font-size: .85rem; }

  /* ---- KART KALKMASI + DUOTONE ----
     İkisi de YALNIZ imleçli cihazda kuruluyor. Dokunmatikte "dinlenme"
     diye bir durum yok: kart hep dinlenir halde olur ve bütün pullar
     kızıl kalırdı. Ayrıca `--k:0` olsa bile ayakta duran
     `mix-blend-mode` katmanı boşuna harman bağlamı doğurur (H14). */
  @media (hover: hover) and (pointer: fine) {
    .is { transition: transform .35s var(--e), border-color .35s var(--e); }
    .is:hover, .is:focus-within { transform: translateY(-3px);
      border-color: var(--line2); }

    .pul-k { --k: 1; position: relative; isolation: isolate; }
    .pul-k::before, .pul-k::after { content: ''; position: absolute; inset: 0;
      pointer-events: none; transition: opacity .45s var(--e); }
    .pul-k::before { background: var(--bg); opacity: calc(var(--k) * .42); }
    .pul-k::after { background: var(--red); mix-blend-mode: color; opacity: var(--k); }
    .is:hover .pul-k, .is:focus-within .pul-k { --k: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .is { transition: none; }
    .is:hover, .is:focus-within { transform: none; }
    .pul-k::before, .pul-k::after { transition: none; }
  }
</style>
