     (kalitimla da ust degeri bulamayan koke duser ve 1 alir). */
  @property --mkp { syntax: '<number>'; inherits: true; initial-value: 1; }
  /* miras seçimi ölçülmüş karar (platform turunun dersi): ilerleme
     değişkeni miras alırsa onu kullanmayan alt ağaç da tazelenir */
  @property --mact { syntax: '<number>'; inherits: false; initial-value: 1; }
  @property --mon { syntax: '<number>'; inherits: false; initial-value: 1; }
  @property --msa { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --msd { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --mt { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --mkay { syntax: '<number>'; inherits: false; initial-value: 1; }
  /* eleme ve kilit: --mele kendi elemanında, --mkil kazananın İÇİNDEKİ
     yazıya da geçtiği için mirasla (alt ağaç iki eleman) */
  @property --mele { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --mkil { syntax: '<number>'; inherits: true; initial-value: 1; }
  @keyframes mkp-surus { from { --mkp: 0; } to { --mkp: 1; } }

  @supports (animation-timeline: view()) {
    .mk-kap { view-timeline-name: --mk-kap; view-timeline-axis: block;
      min-height: calc(var(--mkh, 620px) + 440vh); }
    .mk-sabit { position: sticky; top: max(0px, calc((100vh - var(--mkh, 620px)) / 2)); }
    /* SURUS TEK YERDE: kap. Eskiden bu liste 29 seciciydi ve her biri
       kendi `mkp-surus` animasyonunu tasiyordu (gerekce @property'nin
       yaninda). Artik yalnizca kap surer; torunlar `--mkp`yi MIRASLA okur. */
    .mk-kap {
      animation: mkp-surus linear both; animation-timeline: --mk-kap;
      animation-range: cover calc(100vh - max(0px, (100vh - var(--mkh, 620px)) / 2))
                       cover calc(540vh - max(0px, (100vh - var(--mkh, 620px)) / 2)); }
  }

  /* ŞERİT — anahtar kare (eşikler sabit: (i+.84)/8 → (i+1)/8) */
  @keyframes mk-serit {
    0%, 10.5% { transform: translateX(0); }
    12.5%, 23% { transform: translateX(-12.5%); }
    25%, 35.5% { transform: translateX(-25%); }
    37.5%, 48% { transform: translateX(-37.5%); }
    50%, 60.5% { transform: translateX(-50%); }
    62.5%, 73% { transform: translateX(-62.5%); }
    75%, 85.5% { transform: translateX(-75%); }
    87.5%, 100% { transform: translateX(-87.5%); }
  }
  /* ŞERİT KENDİ SÜRÜŞÜNÜ TAŞIR (5 Eyl 2026 — REGRESYON DÜZELTMESİ,
     gerekçe PlatformSahne'dekiyle aynı: animasyon uzun-yazımları miras
     alınmaz, yalnız `animation-name` taşıyan kural ölür). */
  @supports (animation-timeline: view()) {
    .mktrack { animation-name: mk-serit; animation-timeline: --mk-kap;
      animation-fill-mode: both; animation-timing-function: linear;
      animation-range: cover calc(100vh - max(0px, (100vh - var(--mkh, 620px)) / 2))
                       cover calc(540vh - max(0px, (100vh - var(--mkh, 620px)) / 2)); }
  }

  /* perde ilerlemeleri: a_i = clamp((e − i/8)/.125) */
  .mkcount span, .mkfr, .mksec { --a: clamp(0, calc(var(--mkp) * 8), 1); }
  .mksig, .mkit, .mkarrow, .mkmade { --a: clamp(0, calc((var(--mkp) - .125) * 8), 1); }
  .mkmc { --a: clamp(0, calc((var(--mkp) - .25) * 8), 1); }
  .mkcomp, .mkrk { --a: clamp(0, calc((var(--mkp) - .375) * 8), 1); }
  .mkin, .mkcore, .mkhy, .mkwire { --a: clamp(0, calc((var(--mkp) - .5) * 8), 1); }
  .mkdc, .mkjc { --a: clamp(0, calc((var(--mkp) - .625) * 8), 1); }
  .mkch, .mkinf, .mkhand { --a: clamp(0, calc((var(--mkp) - .75) * 8), 1); }
  .mkhr, .mkkara, .mkco, .mkag, .mkdg, .mkbl { --a: clamp(0, calc((var(--mkp) - .875) * 8), 1); }

  /* perde ışığı: .3 → 1 (geçiş .45s → ×20); ilk perde girişte YANIK */
  .mkact { --mact: calc(clamp(0, calc((var(--mkp) * 8 - var(--i)) * 20), 1)
                      * (1 - clamp(0, calc((var(--mkp) * 8 - var(--i) - 1) * 20), 1)));
    opacity: calc(.3 + .7 * var(--mact)); }
  .mkact[data-a='0'] { --mact: calc(1 - clamp(0, calc((var(--mkp) * 8 - 1) * 20), 1)); }
  .mkact[data-a='7'] { --mact: clamp(0, calc((var(--mkp) * 8 - 7) * 20), 1); }

  /* adım rayı (geçiş .4s → ×22.5) */
  .mkstep { --msa: calc(clamp(0, calc((var(--mkp) * 8 - var(--i)) * 22.5), 1)
                      * (1 - clamp(0, calc((var(--mkp) * 8 - var(--i) - 1) * 22.5), 1)));
    --msd: clamp(0, calc((var(--mkp) * 8 - var(--i) - 1) * 22.5), 1);
    color: color-mix(in srgb, #fff calc(var(--msa) * 100%),
      color-mix(in srgb, var(--tx3) calc(var(--msd) * 100%), var(--tx4))); }
  .mkstep[data-s='0'] { --msa: calc(1 - clamp(0, calc((var(--mkp) * 8 - 1) * 22.5), 1)); }
  .mkstep[data-s='7'] { --msa: clamp(0, calc((var(--mkp) * 8 - 7) * 22.5), 1); --msd: 0; }
  .mkstep b { background: color-mix(in srgb, var(--red) calc(var(--msa) * 100%),
      color-mix(in srgb, var(--red-soft) calc(var(--msd) * 100%), rgba(255, 255, 255, .18)));
    box-shadow: 0 0 0 calc(var(--msa) * 4px) rgba(239, 35, 60, .18); }

  /* ── 1 ham veri ── */
  .mkcount span { --mon: clamp(0, calc((var(--a) - (.02 + var(--i) * .06)) * 20), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 6px)); }
  .mkfr { --mon: clamp(0, calc((var(--a) - (.04 + var(--i) * .045)) * 30), 1);
    opacity: var(--mon); transform: translateX(calc((1 - var(--mon)) * -10px)); }
  .mksec { --mon: clamp(0, calc((var(--a) - (.30 + var(--i) * .06)) * 22.5), 1);
    opacity: var(--mon); }
  /* bar dolumu kaynakta .7s geçişle sınıfa bağlı (→ ×12,86) */
  .mksec .mkbar b { width: calc(clamp(0, calc((var(--a) - (.30 + var(--i) * .06)) * 12.86), 1) * var(--w)); }

  /* ── 2 sinyal ── */
  .mksig { --mon: clamp(0, calc((var(--a) - .08) * 18), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 10px)); }
  .mkit { --mon: clamp(0, calc((var(--a) - (.26 + var(--i) * .06)) * 25.7), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 6px)); }
  .mkarrow { opacity: clamp(0, calc((var(--a) - .52) * 22.5), 1); }
  .mkmade { --mon: clamp(0, calc((var(--a) - (.58 + var(--i) * .06)) * 23.7), 1);
    opacity: var(--mon); transform: scale(calc(.92 + .08 * var(--mon))); }

  /* ── 3 harcama eğrisi: t = clamp((a−.06−i·.13)/.34) ── */
  .mkmc { --mt: clamp(0, calc((var(--a) - .06 - var(--i) * .13) / .34), 1);
    --mon: clamp(0, calc(var(--mt) * 22.5), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 10px)); }
  .mkcv polyline { stroke-dashoffset: calc(240 * (1 - var(--mt))); }
  .mkcv polygon { opacity: clamp(0, calc(var(--mt) * 15), 1); }
  .mkline { opacity: clamp(0, calc((var(--mt) - .72) * 22.5), 1); }

  /* ── 4 risk iştahı ── */
  .mkcomp { --mon: clamp(0, calc((var(--a) - (.08 + var(--i) * .08)) * 22.5), 1);
    opacity: var(--mon); transform: translateX(calc((1 - var(--mon)) * -8px)); }
  .mkcomp .mkbar b { width: calc(var(--mon) * var(--w));
    background: linear-gradient(90deg, var(--red), var(--red-soft)); }
  .mkrk { --mon: clamp(0, calc((var(--a) - (.42 + var(--i) * .05)) * 22.5), 1);
    /* SIRALAMA KAYMASI: kaynak .ranked sınıfıyla `order:var(--o)` veriyordu;
       order tam sayıdır, rampalanmaz — basamak (a3 > .58) */
    --mkay: clamp(0, calc((var(--a) - .58) * 100000), 1);
    opacity: var(--mon);
    order: calc(var(--i) + var(--mkay) * (var(--o) - var(--i))); }
  .mkrk[data-i='0'] { --vur: calc(var(--mkay) * 100%);
    background: color-mix(in srgb, rgba(239, 35, 60, .16) var(--vur), rgba(255, 255, 255, .04));
    border-color: color-mix(in srgb, rgba(239, 35, 60, .45) var(--vur), var(--line2)); }
  .mkrk[data-i='0'] em { color: color-mix(in srgb, var(--red-soft) var(--vur), var(--tx3));
    font-weight: calc(400 + var(--mkay) * 300); }

  /* ── 5 davranışsal motor ── */
  .mkin { --mon: clamp(0, calc((var(--a) - (.04 + var(--i) * .055)) * 22.5), 1);
    opacity: var(--mon); transform: translateX(calc((1 - var(--mon)) * -10px)); }
  .mkcore { opacity: clamp(0, calc((var(--a) - .30) * 18), 1); }
  /* kablolar: her yolun kendi eşiği --i'den (kaynak 8662-8668) */
  .mkwire :global(.kbin), .mkwire :global(.kbnin) {
    --mon: clamp(0, calc((var(--a) - (.10 + var(--i) * .055)) * 10.6), 1); }
  .mkwire :global(.kbout), .mkwire :global(.kbnout) {
    --mon: clamp(0, calc((var(--a) - (.40 + var(--i) * .07)) * 10.6), 1); }
  .mkwire :global(path) { stroke-dashoffset: calc(var(--L, 300) * (1 - var(--mon))); }
  .mkwire :global(circle) { opacity: calc(var(--mon) * .85); }
  .mkwire :global(.kiv) { opacity: calc(clamp(0, calc((var(--a) - .52) * 22.5), 1) * .95); }
  .mkhy { --mon: clamp(0, calc((var(--a) - (.44 + var(--i) * .07)) * 22.5), 1);
    --mele: clamp(0, calc((var(--a) - .76) * 22.5), 1);
    --mkil: clamp(0, calc((var(--a) - .80) * 22.5), 1);
    opacity: calc(var(--mon) * (1 - var(--mele) * .78));
    transform: translateX(calc((1 - var(--mon)) * 10px));
    filter: saturate(calc(1 - var(--mele) * .7)); }
  .mkhy.win { --mele: 0;
    background: color-mix(in srgb, rgba(239, 35, 60, .18) calc(var(--mkil) * 100%),
      rgba(255, 255, 255, .04));
    border-color: color-mix(in srgb, rgba(239, 35, 60, .5) calc(var(--mkil) * 100%), var(--line2)); }
  .mkhy.win i { color: color-mix(in srgb, #fff calc(var(--mkil) * 100%), var(--tx2));
    font-weight: calc(400 + var(--mkil) * 200); }
  .mkhy.win em { color: color-mix(in srgb, var(--red-soft) calc(var(--mkil) * 100%), var(--tx4));
    font-weight: calc(400 + var(--mkil) * 300); }

  /* ── 6 karar ve sıçrama ── */
  .mkdc { --mon: clamp(0, calc((var(--a) - (.06 + var(--i) * .07)) * 22.5), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 8px)); }
  .mkjc.ask { --mon: clamp(0, calc((var(--a) - .40) * 18), 1); }
  .mkjc.got { --mon: clamp(0, calc((var(--a) - .56) * 18), 1); }
  .mkjc { opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 12px)); }

  /* ── 7 kampanya devri ── */
  .mkch { --mon: clamp(0, calc((var(--a) - (.06 + var(--i) * .08)) * 22.5), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 8px)); }
  .mkinf { --mon: clamp(0, calc((var(--a) - .44) * 20), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 10px)); }
  .mkhand { opacity: clamp(0, calc((var(--a) - .62) * 20), 1); }

  /* ── 8 harita HUD ── */
  .mkhr { --mon: clamp(0, calc((var(--a) - (.60 + var(--i) * .07)) * 22.5), 1);
    opacity: var(--mon); transform: translateY(calc((1 - var(--mon)) * 5px)); }


  /* ═══ 8. PERDE — DÜNYA HARİTASI (kaynak render 7792-7860) ═══
     Aşamalar kaydırmaya bağlı, paketler ve balonlar kendi zaman
     çevriminde (kaynağın rAF döngüsünün karşılığı; Enes'in isteği:
     "oklar SÜREKLİ aksın"). Kapı IO: görünmeyen perde akmaz. */
  .mkkara, .mkco, .mkag, .mkag-yay, .mkag-pak, .mkdg, .mkbl { position: absolute; inset: 0; pointer-events: none; }
  .mkkara img { width: 100%; height: 100%; object-fit: fill; display: block; }
  .mkag, .mkag-yay, .mkag-pak { width: 100%; height: 100%; }
  /* kara: a = EA(clamp(p/.14)) — 7797 */
  .mkkara { --lt: clamp(0, calc(var(--a) / .14), 1); --lu: calc(1 - var(--lt));
    opacity: calc(1 - var(--lu) * var(--lu) * var(--lu)); }
  /* ülke noktaları: tN = clamp((p−.06)/.20) · k = clamp((tN·243·1.25 − i)/6) */
  /* grup: açılış eşiği (kaynak k = clamp((tN·243·1.25 − i)/6)) */
  .mkcg { position: absolute; inset: 0; display: block;
    --tn: clamp(0, calc((var(--a) - .06) / .20), 1);
    opacity: clamp(0, calc((var(--tn) * 303.75 - var(--i)) / 6), 1); }
  .mkc { position: absolute; border-radius: 50%; background: #fff;
    transform: translate(-50%, -50%); }
  .mkc.w3 { width: 4.4px; height: 4.4px; opacity: .72; }
  .mkc.w2 { width: 3px; height: 3px; opacity: .5; }
  .mkc.w1 { width: 2.1px; height: 2.1px; opacity: .34; }
  /* küresel ağ: tW = clamp((p−.18)/.26) · t2 = clamp((tW·64·1.3 − k)/9)
     zincir açılınca ağ SÖNMEZ, yalnız kısılır (agA .62) — 7810 */
  .mkag { --tw: clamp(0, calc((var(--a) - .18) / .26), 1);
    --aga: calc(1 - .38 * clamp(0, calc((var(--a) - .62) * 100000), 1));
    --son: clamp(0, calc((var(--a) - .92) * 100000), 1); }
  /* TUR 2: yay gruplari kendi aralik cizelgesinde (keyframe'ler
     frontmatter'da, grup basina: cizim m0->m1, kisilma .62'de basamak);
     dashoffset ve stroke-opacity SVG'de miras alinir. Desteksiz/azaltma:
     cizili ve kisik son hal. */
  .mkag-yay .mkagg { stroke-dashoffset: 0; stroke-opacity: .0465; }
  .mkag-pak .mkagg { opacity: .372; }
  @supports (animation-timeline: view()) {
    .mkag-yay .mkagg, .mkag-pak .mkagg { animation-timeline: --mk-kap; animation-fill-mode: both;
      animation-timing-function: linear; }
    .mkag-pak .mkagg { animation-timing-function: step-end; }
  }
  .mkagy { fill: none; stroke: #fff; stroke-width: 1; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; }
  .mkagp { fill: #fff;
    animation-name: mk-akis; animation-timing-function: linear;
    animation-iteration-count: infinite; animation-play-state: paused; }
  @keyframes mk-akis { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  .mkgor .mkagp, .mkgor .mkznp, .mkgor .mkb { animation-play-state: running; }
  /* zincir: hammadde → üretim (t1 = EA(clamp((p−.60)/.14))) */
  .mkzn { fill: none; stroke: #fff; vector-effect: non-scaling-stroke;
    stroke-linecap: round; stroke-dasharray: 1; }
  .zn-src { --t1: clamp(0, calc((var(--a) - .60) / .14), 1);
    --u1: calc(1 - var(--t1)); --e1: calc(1 - var(--u1) * var(--u1) * var(--u1));
    stroke-width: 2; stroke-opacity: .85; stroke-dashoffset: calc(1 - var(--e1)); }
  /* pazar yayları: t3 = EA(clamp((p−.76−i·.045)/.13)) · son = p>.92 */
  .zn-dst { --t3: clamp(0, calc((var(--a) - .76 - var(--i) * .045) / .13), 1);
    --u3: calc(1 - var(--t3)); --e3: calc(1 - var(--u3) * var(--u3) * var(--u3));
    stroke-dashoffset: calc(1 - var(--e3)); stroke-width: 1.5;
    stroke-opacity: calc(.5 - var(--son) * .28); }
  .zn-dst.sec { stroke: color-mix(in srgb, var(--red) calc(var(--son) * 100%), #fff);
    stroke-width: calc(1.5 + var(--son) * 1.1); stroke-opacity: calc(.5 + var(--son) * .45); }
  .mkznp { fill: #fff; animation-name: mk-akis; animation-timing-function: linear;
    animation-iteration-count: infinite; animation-play-state: paused;
    opacity: clamp(0, calc((var(--a) - .74) * 100000), 1); }
  .zn-dp { --t3: clamp(0, calc((var(--a) - .76 - var(--i) * .045) / .13), 1);
    opacity: calc(clamp(0, calc((var(--t3) - .999) * 100000), 1) * (.7 - var(--son) * .2)); }
  .zn-dp.sec { fill: color-mix(in srgb, #ff5a6e calc(var(--son) * 100%), #fff);
    opacity: clamp(0, calc((var(--t3) - .999) * 100000), 1); }
  /* düğümler: canvas yazısı yerine gerçek metin (aynı eşikler) */
  /* kaynak yazı boyu KUTU genişliğine bağlıydı (W/64 ve W/86), görüntü
     genişliğine değil — kap container yapılıp cqw ile birebir yazıldı */
  .mkmapwrap { container-type: inline-size; }
  .mkd { position: absolute; display: flex; align-items: center; gap: 7px;
    transform: translate(-50%, -50%); font-size: clamp(9px, 1.5625cqw, 12.5px);
    font-weight: 600; color: #fff; white-space: nowrap;
    text-shadow: 0 1px 4px rgba(0, 0, 0, .9); }
  .mkd b { width: 7.2px; height: 7.2px; border-radius: 50%; background: #fff; flex: none;
    margin-left: -3.6px; }
  .mkd-src { --t1: clamp(0, calc((var(--a) - .60) / .14), 1);
    opacity: clamp(0, calc(var(--t1) * 100000), 1);
    color: rgba(255, 255, 255, clamp(0, calc((var(--t1) - .45) * 100000), 1)); }
  .mkd-hub { --t2h: clamp(0, calc((var(--a) - .70) / .08), 1);
    opacity: clamp(0, calc(var(--t2h) * 100000), 1); }
  .mkd-hub b { width: 9.6px; height: 9.6px; margin-left: -4.8px; background: var(--red);
    box-shadow: 0 0 0 calc((1 - var(--t2h)) * .9 * 24px)
      rgba(239, 35, 60, calc(.3 * (1 - (1 - var(--t2h)) * .9))); }
  .mkdg { --son2: clamp(0, calc((var(--a) - .92) * 100000), 1); }
  .mkd-dst { --t3: clamp(0, calc((var(--a) - .76 - var(--i) * .045) / .13), 1);
    opacity: calc(clamp(0, calc((var(--t3) - .2) * 100000), 1) * (1 - var(--son2) * .38));
    color: rgba(255, 255, 255, clamp(0, calc((var(--t3) - .5) * 100000), 1)); }
  .mkd-dst b { width: 6.4px; height: 6.4px; margin-left: -3.2px;
    background: rgba(255, 255, 255, .66); }
  .mkd-dst.sec { opacity: clamp(0, calc((var(--t3) - .2) * 100000), 1); }
  .mkd-dst.sec b { width: calc(6.4px + var(--son2) * 4.4px);
    height: calc(6.4px + var(--son2) * 4.4px);
    background: color-mix(in srgb, var(--red) calc(var(--son2) * 100%), rgba(255, 255, 255, .66)); }
  .mkgor .mkd-dst.sec b { animation: mk-nabiz 1.43s linear infinite; }
  @keyframes mk-nabiz {
    from { box-shadow: 0 0 0 0 rgba(239, 35, 60, .85); }
    to { box-shadow: 0 0 0 20px rgba(239, 35, 60, 0); } }
  /* balonlar: kaynakta 2,8 sn yaşıyor; burada sıralı çevrim (18 sn) */
  .mkb { position: absolute; transform: translate(-50%, calc(-100% - 13px));
    padding: 5px 9px; border-radius: 999px;
    font-size: clamp(8.5px, 1.1628cqw, 11.5px); font-weight: 600; color: #fff;
    white-space: nowrap; background: rgba(239, 35, 60, .16);
    border: 1px solid rgba(239, 35, 60, .55); opacity: 0;
    animation: mk-balon 18s linear infinite; animation-play-state: paused;
    animation-delay: calc(var(--i) * 3s); }
  @keyframes mk-balon {
    0%, 1.6% { opacity: 0; } 3.3%, 12.8% { opacity: 1; } 15.6%, 100% { opacity: 0; } }

  /* gölgeler + cam H14: kaynakta masaüstü katmanı */
  @media (min-width: 901px) {
    .mkstage { box-shadow: 0 30px 80px -50px rgba(0, 0, 0, .9); }
    .mklogo b { box-shadow: 0 0 14px -2px var(--red-glow); }
    .mkjc.got { box-shadow: 0 0 44px -20px var(--red-glow); }
    .mkhy.win { box-shadow: 0 0 30px -12px rgba(239, 35, 60, calc(var(--mkil) * .45)); }
  }
  @media (hover: hover) and (pointer: fine) {
    .mkhud { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  }
  /* MOBİL PAKET BÜTÇESİ (ölçülmüş): 64 paketin her biri offset-path
     boyunca sürülüyor ve bileşik katmanda koşmuyor. Telefonda üçte biri
     akar — ağın "canlı" hissi durur, kare bütçesi durmaz. */
  @media (pointer: coarse), (max-width: 900px) {
    .mkagg circle:nth-of-type(3n+1), .mkagg circle:nth-of-type(3n+2) { display: none; }
  }
  /* MOBİL İÇERİK İSTİSNASI — kaynak 4390-4392 (ana bloğun DIŞINDA) */
  @media (pointer: coarse), (max-width: 900px) {
    .mkact, .mkcount span, .mkfr, .mksec, .mksig, .mkit, .mkarrow, .mkmade, .mkmc,
    .mkline, .mkcomp, .mkrk, .mkin, .mkcore, .mkhy, .mkdc, .mkjc, .mkch, .mkinf,
    .mkhand, .mkhr { opacity: 1; transform: none; }
    .mkcount span, .mkfr, .mksec, .mksig, .mkit, .mkarrow, .mkmade, .mkcomp, .mkrk,
    .mkin, .mkhy, .mkdc, .mkjc, .mkch, .mkinf, .mkhand, .mkhr { animation: none; }
    .mksec .mkbar b { width: var(--w); }
    .mkcomp .mkbar b { width: var(--w); }
    .mkcv polyline { stroke-dashoffset: 0; }
  }
  /* kaynak mobil çizelgesi: 3708-3730 */
  @media (max-width: 860px) {
    .mkrail { width: 100%; margin-left: 0; gap: 5px; }
    .mkview { height: clamp(380px, min(150vw, calc(100vh - 210px)), 620px); }
    .mksplit, .mksplit2, .mkeng, .mkjump { grid-template-columns: 1fr; }
    .mkeng .mkcore { max-height: 150px; max-width: 150px; }
    .mkcurves { grid-template-columns: 1fr; gap: 7px; }
    .mkmc:nth-child(3) { display: none; }
    .mkdecs, .mkchs { grid-template-columns: repeat(2, 1fr); }
    .mkfeed .mkfr:nth-child(n+6) { display: none; }
    .mkhud { max-width: 76%; left: 10px; bottom: 10px; }

    /* HARİTA DİKEY İNŞA EDİLİR (5 Eyl 2026 — Enes'in bildirdiği hata).
       ÖLÇÜLDÜ (390 px): harita kutusu 349x586, yani oran 0,596; dünya
       ızgarasının kendi oranı 1600/568 = 2,817. Katmanlar
       `object-fit:fill` + `preserveAspectRatio="none"` ile kutuya
       geriliyordu, yani harita DİKEYDE 4,73 KAT eziliyordu — yatay bir
       dünya haritası dikey kutuda duruyordu.
       ÇARE: katmanlar kendi oranını korur ve kutuyu KAPLAR; görünen
       pencere, hikâyenin geçtiği boylam kuşağı. Gerilme yok, mektup
       kutusu (letterbox) da yok — Enes'in ikisini de reddettiği durum.
       PENCERE HESABI: düğümler dünya genişliğinin %50,85 (Cezayir) ile
       %65,35'i arasında; ortası %58,1 → `translateX(-58.1%)`. Kutuyu
       kaplayan katman 586 x 2,817 = 1651 px, görünen dilim 349/1651 =
       %21,1 = 76° boylam (≈ 9°B..67°D): Cezayir, Türkiye ve Rusya'nın
       üçü de içeride (ölçüldü: 5/5 düğüm kutu içinde).
       `.mkbl` DIŞARIDA BIRAKILDI: konuşma balonları yayın ucuna
       çakılıdır ve zumlanınca 6'nın 4'ü pencere dışına düşüyordu
       (ölçüldü); kutu ölçeğinde kalınca 6/6 görünür. Balonun coğrafi
       çakılması bilerek bırakıldı — dekoratif müşteri cümlesi. */
    .mkmapwrap { overflow: hidden; }
    .mkkara, .mkco, .mkag, .mkag-yay, .mkag-pak, .mkdg {
      inset: 0 auto auto 50%; height: 100%; width: auto;
      aspect-ratio: 1600 / 568; transform: translateX(-58.1%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mk-kap { min-height: 0; }
    .mk-sabit { position: static; }
    .mktrack, .mkact, .mkstep, .mkcount span, .mkfr, .mksec, .mksig, .mkit, .mkarrow,
    .mkmade, .mkmc, .mkcomp, .mkrk, .mkin, .mkcore, .mkhy, .mkdc, .mkjc, .mkch,
    .mkinf, .mkhand, .mkhr, .mkwire, .mkkara, .mkco, .mkag, .mkdg, .mkbl { animation: none; }
    .mkcore i { animation: none !important; }
    .mkag-yay .mkagg, .mkag-pak .mkagg { animation: none; }
    .mkwire :global(.kiv) { animation: none; opacity: 0; }
    .mkcv polyline { stroke-dashoffset: 0; }
  }
</style>

<script>
  /* MOTOR KABLOLARI — kaynak kabloKur'un yerlisi (8536-8604).
     Girdi kartlarının sağ kenarından amblem çemberine, çemberin
     sağındaki TEK noktadan hipotez kartlarına S eğrileri.
     ÖLÇÜM offsetLeft/Top ZİNCİRİYLE: kartlar açılmadan önce translateX
     taşıyor, gBCR uçları kaydırırdı (kaynağın kendi dersi). viewBox
     piksel biriminde — tek birim, zoom hepsini birlikte ölçekler.
     Kaydırmada ölçüm YOK: kurulum + resize + fonts.ready.

     İKİNCİ İŞ: amblem ve kıvılcım zaman animasyonu; kaynak `.mkact.on`
     ile duraklatıyordu. Perde sınıfı yok, o yüzden kapı IO — görünmeyen
     dönmez (doktrinin IO'ya izin verdiği tek yer). */
  const kap = document.querySelector('.mk-kap') as HTMLElement | null;
  if (kap) {
    const sabit = kap.querySelector('.mk-sabit') as HTMLElement;
    const eng = kap.querySelector('.mkeng') as HTMLElement | null;
    const svg = kap.querySelector('.mkwire') as SVGSVGElement | null;
    const cekirdek = kap.querySelector('.mkcore') as HTMLElement | null;
    const konum = (el: HTMLElement, kok: HTMLElement) => {
      let x = 0, y = 0, n: any = el;
      while (n && n !== kok) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent; }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };
    const kabloKur = () => {
      if (!eng || !svg || !cekirdek) return;
      const W = eng.offsetWidth, H = eng.offsetHeight;
      if (W < 40 || H < 40) return;
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
      const gir = [...kap.querySelectorAll<HTMLElement>('.mkins .mkin')];
      const cik = [...kap.querySelectorAll<HTMLElement>('.mkhyps .mkhy')];
      const ck = konum(cekirdek, eng);
      const cx = ck.x + ck.w / 2, cy = ck.y + ck.h / 2, R = ck.w / 2 * 0.93;
      const destek = CSS?.supports?.('offset-path', 'path("M0,0L1,1")');
      const egriYol = (sx: number, sy: number, ex: number, ey: number) => {
        const k = Math.abs(ex - sx) * 0.45;
        return `M${sx.toFixed(1)},${sy.toFixed(1)} C${(sx + k).toFixed(1)},${sy.toFixed(1)} ` +
          `${(ex - k).toFixed(1)},${ey.toFixed(1)} ${ex.toFixed(1)},${ey.toFixed(1)}`;
      };
      let ic = '';
      const ekle = (d: string, i: number, dd: string, nx: number, ny: number) => {
        ic += `<path class="kb${d}" data-i="${i}" style="--i:${i}" d="${dd}"/>` +
          `<circle class="kbn${d}" data-i="${i}" style="--i:${i}" cx="${nx.toFixed(1)}" cy="${ny.toFixed(1)}" r="2.2"/>`;
        if (destek) ic += `<circle class="kiv kbk${d}" data-i="${i}" r="2.6" ` +
          `style="offset-path:path('${dd}');animation-delay:${(0.06 * i + 0.2).toFixed(2)}s"/>`;
      };
      gir.forEach((el, i) => {
        const k = konum(el, eng);
        const sx = k.x + k.w, sy = k.y + k.h / 2;
        const dx = sx - cx, dy = sy - cy, u = Math.hypot(dx, dy) || 1;
        ekle('in', i, egriYol(sx, sy, cx + dx / u * R, cy + dy / u * R), sx, sy);
      });
      const qx = cx + R, qy = cy;
      cik.forEach((el, i) => {
        const k = konum(el, eng);
        ekle('out', i, egriYol(qx, qy, k.x, k.y + k.h / 2), k.x, k.y + k.h / 2);
      });
      if (cik.length) ic += `<circle class="kbnout kbcik" data-i="0" style="--i:0" cx="${qx.toFixed(1)}" cy="${qy.toFixed(1)}" r="3"/>`;
      svg.innerHTML = ic;
      svg.querySelectorAll('path').forEach(pt => {
        try { (pt as SVGPathElement).style.setProperty('--L', String(Math.ceil((pt as SVGPathElement).getTotalLength()) + 4)); } catch (e) { }
      });
    };
    let zm: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => { clearTimeout(zm); zm = setTimeout(kabloKur, 180); });
    document.fonts?.ready?.then(kabloKur);
    if ('ResizeObserver' in window && eng) new ResizeObserver(kabloKur).observe(eng);
    kabloKur();
    kap.style.setProperty('--mkh', sabit.offsetHeight + 'px');
    const olcSabit = () => kap.style.setProperty('--mkh', sabit.offsetHeight + 'px');
    document.fonts?.ready?.then(olcSabit);
    if ('ResizeObserver' in window) new ResizeObserver(olcSabit).observe(sabit);

    /* IO kapısı — kaynağın `.mkact.on` duraklatmasının karşılığı: perde
       kadrajdayken zaman animasyonları (amblem, kıvılcım, harita
       paketleri, balonlar) akar, dışarıdayken durur. Kapı PERDE
       BAŞINA: sekiz perde yan yana duruyor, yalnız biri görünüyor. */
    const perdeler = [...kap.querySelectorAll<HTMLElement>('.mkact')];
    if (perdeler.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(g => {
        for (const x of g) x.target.classList.toggle('mkgor', x.isIntersecting);
      }, { root: kap.querySelector('.mkview'), threshold: .25 });
      perdeler.forEach(x => io.observe(x));
    } else perdeler.forEach(x => x.classList.add('mkgor'));
  }
</script>
