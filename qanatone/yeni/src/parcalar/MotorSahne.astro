---
/* K7 · PAZAR ZEKÂSI MOTORU (#mkStage) — finans hizmetinin ikinci ve en
   uzun sahnesi. Kaynak: kök index.html · markup marketStage 8137-8262 ·
   CSS 3376-3730 (+ 4390-4392 mobil içerik istisnası) · sürücü mdraw
   8611-8692 · kablolar kabloKur 8536-8604 · ST 8703-8712 (pin 4.4).

   SEKİZ PERDE TEK PENCEREDE YATAY KAYAR: ham veri → sinyal → harcama
   eğrisi → risk iştahı → davranışsal motor → karar & sıçrama →
   kampanya devri → dünya haritası.

   KİLİT ÖLÇÜLÜR (platform sahnesinin dersi): kap = sarmal + 440vh,
   yani yapışık pencere tam kilit boyuna eşit; sticky üst hizası
   max(0px,(100vh−sarmal)/2) kaynağın iki dalını da karşılar.

   SÜRÜCÜ TEK: --mkp. Şerit anahtar kareyle (eşikler sabit, aradaki
   hareket doğrusal → birebir; platform turunda ölçülen karar: değişken
   güdümlü transform bileşik katmanda sürülemiyor).

   Eşikler kaynak mdraw'dan (N=8):
     a_i = clamp((e − i/8) / .125)
     şerit = Σ_{i=0..6} clamp((8e − i − .84)/.16)
     1 ham veri : sayaç a0>.02+i·.06 · satır a0>.04+i·.045 · sektör a0>.30+i·.06
     2 sinyal   : kutu a1>.08 · kalem a1>.26+i·.06 · ok a1>.52 · ürün a1>.58+i·.06
     3 eğri     : t=clamp((a2−.06−i·.13)/.34) · çizgi dashoffset 240(1−t) · alt satır t>.72
     4 risk     : bileşen a3>.08+i·.08 · sıra a3>.42+i·.05 · SIRALAMA KAYAR a3>.58
     5 motor    : girdi a4>.04+i·.055 · kablo a4>.10+i·.055 · çekirdek a4>.30 ·
                  çıkış kablosu a4>.40+i·.07 · kıvılcım a4>.52 ·
                  hipotez a4>.44+i·.07 · eleme a4>.76 · kilit a4>.80
     6 karar    : kalem a5>.06+i·.07 · istenen a5>.40 · gelen a5>.56
     7 kampanya : kanal a6>.06+i·.08 · etki a6>.44 · devir a6>.62
     8 harita   : HUD satırı a7>.60+i·.07 (harita katmanı ayrı bölümde)

   KABLOLAR ÖLÇÜLÜR (kaynak kabloKur): girdi kartlarının sağ kenarından
   amblemin çemberine, çemberin sağındaki TEK noktadan hipotez
   kartlarına S eğrileri. Ölçüm `offsetLeft/Top` zinciriyle — kartlar
   açılmadan önce translateX taşıdığı için gBCR uçları kaydırırdı
   (kaynağın kendi dersi, 8536-8546). viewBox piksel biriminde.

   AMBLEM ve KIVILCIM zaman animasyonudur (kaynağın kendi otomatiği:
   dış dişli 20 sn CCW, iç 12 sn CW — oran diş sayısından ölçülmüş).
   Kaynak `.mkact.on` sınıfıyla duraklatıyordu; burada perde sınıfı yok,
   o yüzden kapı IntersectionObserver: görünmeyen dönmez (doktrinin
   IO'ya izin verdiği tek yer — [[qanatone-io-tetik-surucu]] madde 3). */
import { T, icerik, type Dil } from '../icerik';
import { ulkeler, agKur, yay, yuzde, nokta, VB } from '../harita.mjs';
interface Props { market: any; dil: Dil }
const { market, dil } = Astro.props;
const m = market || {};
const en = dil === 'en';
/* PANELE ACILDI (TUR 4, 4 Eyl 2026). Bu bilesenin sabit iki dilli
   metinleri artik PANELDEN ezilebilir: cagrinin ilk argumani ANAHTAR,
   sonraki ikisi TR ve EN varsayilani.
   Panelde `strings.<dil>.<anahtar>` doluysa o kazanir, bossa buradaki
   varsayilan. Anahtarlar bu dosyaya OZGU ve SABIT — yeniden
   numaralandirilmaz, yeni metin siradaki numarayi alir. */
const M = (k: string, tr: string, eng: string) =>
  T(((icerik.strings || {})[en ? 'en' : 'tr'] || {})[k], en ? 'en' : 'tr') || (en ? eng : tr);
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const adimlar = (m.steps || []) as any[];
const sayimlar = (m.counts || []) as any[];
const akis = (m.feed || []) as any[];
const sektorler = (m.sectors || []) as any[];
const kalemler = (m.items || []) as any[];
const uretilen = (m.made || []) as any[];
const pazarlar = (m.markets || []) as any[];
const riskler = (m.risk || []) as any[];
const girdiler = (m.inputs || []) as any[];
const hipotezler = (m.hyp || []) as any[];
const kararlar = (m.decision || []) as any[];
const kanallar = (m.channels || []) as any[];
const hud = (m.hud || []) as any[];
const sinyal = m.signal || {};
/* İÇERİKTEKİ OK KARAKTERİ SVG'YE ÇEVRİLİR — F1c yakaladı: U+2192 ne
   'latin' ne 'latin-ext' kaynağında var (ölçüldü, fontTools ile dört
   yüzde de yok). Eski site onu sistem fontundan çiziyordu, yani satır
   iki yazı tipiyle karışık diziliyordu. Aynı ders üçüncü kez: ✦ (sohbet)
   ve S-SE oku. Panel metni DEĞİŞMİYOR; yalnız basımı değişiyor. */
const okla = (v: any): any[] => String(T(v, dil) ?? '').split('→');
/* ── 8. PERDE: DÜNYA HARİTASI · geometri DERLEMEDE pişer ──────────
   Kaynak mkMap (7687-7900) her karede canvas'a çiziyordu: kara ızgarası,
   243 ülke, tohumlu 64 çiftlik küresel ağ, zincir yayları, paketler,
   balonlar. Statik olan her şey burada hesaplanır; hareket CSS'te sürer.
   Kaynağın veri ve çizici JS'i tarayıcıya İNMEZ (J1 tavanı 10 KB). */
const H = m.map || {};
const kaynak = H.src || {}, merkez = H.hub || {}, hedefler = (H.dst || []) as any[];
const secili = H.pick || 0;
const balonlar = (m.bubbles || []) as any[];
const ag = agKur().map((L: any) => {
  const g = yay(ulkeler[L.a], ulkeler[L.b]);
  return { ...L, ...g };
}).filter((x: any) => !x.kenar);      /* kaynak: kenardan dolanan yayı çizme (7740) */
const yKaynak = yuzde(kaynak.lon, kaynak.lat), yMerkez = yuzde(merkez.lon, merkez.lat);
const zKaynak = yay(kaynak, merkez);
const zHedef = hedefler.map((d: any) => ({ ...yay(merkez, d), ad: d.n, y: yuzde(d.lon, d.lat) }));
/* balonlar: kaynak paket turu tamamlanınca RASTGELE doğuruyordu; CSS'te
   rastgelelik yok — altı yay ucuna sabitlenip sıralı çevrimle doğuyorlar
   (sapma adıyla; en fazla üçü aynı anda görünür, kaynağın sınırı) */
const balonYeri = ag.filter((_: any, i: number) => i % 9 === 2).slice(0, 6);
/* GRUPLAMA (ölçülmüş karar): 243 nokta ve 64 yay tek tek değişken
   zinciri taşıyınca kare başına ~370 eleman tazeleniyordu. Noktalar 16,
   yaylar 8 gruba toplandı: açılış eşiği grubun ORTA indisinden gelir,
   grup içi noktalar kendi statik boyunu/opaklığını korur. İç opaklık çarpım
   olarak biner; dash-offset ve stroke-opacity SVG'de miras alınır. */
const NG = 16, AGG = 8;
const dilim = (dizi: any[], n: number) => {
  const boy = Math.ceil(dizi.length / n), c: any[][] = [];
  for (let i = 0; i < dizi.length; i += boy) c.push(dizi.slice(i, i + boy));
  return c;
};
const ulkeGrup = dilim(ulkeler as any[], NG).map((g, gi) => ({
  g, i: gi * Math.ceil((ulkeler as any[]).length / NG) + Math.ceil((ulkeler as any[]).length / NG) / 2,
}));
const agGrup = dilim(ag, AGG).map((g, gi) => ({
  g, k: gi * Math.ceil(ag.length / AGG) + Math.ceil(ag.length / AGG) / 2,
}));
/* GECE ZINCIRI TUR 2 (2 Eyl 2026) — AG YAYLARI KENDI ARALIK CIZELGESINDE.
   Olculdu (finans, 3 kosum medyani): .mkag gizlenince p95 24,9 -> 16,8;
   paketler/HUD/kivilcim/kablolar/kartlar tek basina etkisiz. Sebep: 64
   yay --mkp zincirinden (her karede stil yeniden hesabi + tum SVG'nin
   boyanmasi) suruluyordu. Simdi yaylar AYRI SVG'de, her grup --mk-kap
   cizelgesinde kendi araligiyla cizilir ve BITINCE STATIK KALIR (kare
   basina degisen sey yok); paketler ucuncu SVG'de (zaman animasyonu, kucuk
   daireler). Zincir (kaynak -> uretim -> pazar) eski surucude (.mkag).
   Esikler kaynakla ayni: tw=(a-.18)/.26 · t2=(tw*83.2-k)/9 · kisilma a>.62.
   mkp = .875 + a/8 (8. perde); aralik ucu = taban + mkp*440vh. */
const mkpA = (a: number) => .875 + a / 8;
const KIS_MKP = mkpA(.62);
const yayGrup = agGrup.map((gr: any) => {
  const tw0 = gr.k / 83.2, tw1 = (gr.k + 9) / 83.2;
  const m0 = mkpA(.18 + .26 * tw0), m1 = mkpA(.18 + .26 * tw1);
  return { ...gr, m0, m1, p1: ((m1 - m0) / (KIS_MKP - m0) * 100).toFixed(2) };
});
const TABAN = 'calc(100vh - max(0px, (100vh - var(--mkh, 620px)) / 2))';
const ar = (m: number) => `cover calc(${TABAN} + ${(m * 440).toFixed(3)}vh)`;
const yayStil = yayGrup.map((gr: any, i: number) =>
  `@keyframes mk-yay-${i}{0%{stroke-dashoffset:1;stroke-opacity:.075}${gr.p1}%{stroke-dashoffset:0;stroke-opacity:.075}99.9%{stroke-dashoffset:0;stroke-opacity:.075}100%{stroke-dashoffset:0;stroke-opacity:.0465}}`
  + `@keyframes mk-pak-${i}{0%{opacity:0}.1%{opacity:.6}99.9%{opacity:.6}100%{opacity:.372}}`
  + `.mkag-yay .yg${i}{animation-name:mk-yay-${i};animation-range:${ar(gr.m0)} ${ar(KIS_MKP)}}`
  + `.mkag-pak .pg${i}{animation-name:mk-pak-${i};animation-range:${ar(gr.m1)} ${ar(KIS_MKP)}}`).join('');
/* eğri noktaları derlemede pişer (kaynak 8153-8156) */
const egri = (c: any) => {
  const idx: number[] = c.idx || [];
  const n = Math.max(1, idx.length - 1);
  const pts = idx.map((v: number, j: number) => `${((j / n) * 100).toFixed(1)},${(100 - v).toFixed(1)}`).join(' ');
  return { pts, alan: `0,100 ${pts} 100,100` };
};
---
{m.steps && (
<div class="sdsec mk-kap">
  <div class="mk-sabit">
    <span class="mono">{M('mtr01', 'Pazar zekâsı — kaydırdıkça çözülür', 'Market intelligence — solved as you scroll')}</span>
    {/* TUR 4 (2 Eyl 2026): inert — klavye odak gezintisi seride girmez; serit
        dekoratif (odaklanabilir oge yok, isaretci olayi yok). Ilk Tab 52 -> 26-36 ms. */}
    <div class="mkstage" id="mkStage" inert>
      <div class="mkbar2">
        <span class="mklogo"><b><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2Zm0 5.8a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4Z" /><path
            d="M21.2 13.6a9.6 9.6 0 0 0 0-3.2l1.9-1.4-1.9-3.3-2.2.8a9.4 9.4 0 0 0-2.8-1.6L15.8 2h-3.8l-.4 2.9c-1 .3-2 .9-2.8 1.6l-2.2-.8-1.9 3.3 1.9 1.4a9.6 9.6 0 0 0 0 3.2l-1.9 1.4 1.9 3.3 2.2-.8c.8.7 1.8 1.3 2.8 1.6l.4 2.9h3.8l.4-2.9c1-.3 2-.9 2.8-1.6l2.2.8 1.9-3.3-1.9-1.4Z"
            opacity=".92" /></svg></b>{M('mtr02', 'TradeSelf · pazar motoru', 'TradeSelf · market engine')}</span>
        <span class="mkrail">{adimlar.map((s, i) =>
          <span class="mkstep" data-s={i} style={`--i:${i}`}><b />{T(s, dil)}</span>)}</span>
      </div>
      <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
        <linearGradient id="mkgrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="rgba(239,35,60,.34)" />
          <stop offset="100%" stop-color="rgba(239,35,60,0)" />
        </linearGradient></defs></svg>
      <div class="mkview"><div class="mktrack">

        {/* 1 — ham veri */}
        <section class="mkact" data-a="0" style="--i:0">
          <div class="mkcount">{sayimlar.map((c, i) =>
            <span style={`--i:${i}`}><em>{c.v}</em><i>{T(c.n, dil)}</i></span>)}</div>
          <div class="mksplit">
            <div class="mkfeed">{akis.map((r, i) =>
              <span class="mkfr" data-i={i} style={`--i:${i}`}><i>{r.f}</i>
                {/* kaynak '→' KARAKTERİ basıyordu; F1c yakaladı: U+2192 alt
                    kümede yok (S-SE okunun ve ✦ yıldızının aynı dersi).
                    Aynı ok satır içi SVG olarak basılıyor. */}
                <s><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  ><path d="M5 12h13" /><path d="m13 6 6 6-6 6" /></svg></s><i>{r.t}</i>
                <em>{r.hs}</em><u>{r.p}</u><b>{r.v}</b></span>)}</div>
            <div class="mksects">{sektorler.map((s, i) =>
              <span class={'mksec' + (s.hot ? ' hot' : '')} data-i={i} style={`--i:${i}`}>
                <i>{T(s.n, dil)}</i>
                <span class="mkbar"><b style={`--w:${s.w}%`} /></span><em>{s.v}</em></span>)}</div>
          </div>
        </section>

        {/* 2 — sinyal */}
        <section class="mkact" data-a="1" style="--i:1">
          <div class="mksig"><span class="mkup" /><div><b>{T(sinyal.t, dil)}</b>
            <i>{okla(sinyal.d).map((p, i) => <>{i > 0 && <svg class="mkok" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13" /><path d="m13 6 6 6-6 6" /></svg>}{p}</>)}</i>
            </div><em>{sinyal.v || ''}</em></div>
          <div class="mkitems">{kalemler.map((x, i) =>
            <span class="mkit" style={`--i:${i}`}><i>{x.n}</i><em>{x.v}</em></span>)}</div>
          <div class="mkarrow" />
          <div class="mkmades"><span class="mkmlab">{T(m.madeLab, dil)}</span>
            {uretilen.map((x, i) => <span class="mkmade" data-i={i} style={`--i:${i}`}>{T(x, dil)}</span>)}</div>
        </section>

        {/* 3 — harcama eğrisi */}
        <section class="mkact" data-a="2" style="--i:2">
          <span class="mklab">{T(m.curveLab, dil)}</span>
          <div class="mkcurves">{pazarlar.map((c: any, i: number) => { const g = egri(c); return (
            <span class="mkmc" data-i={i} style={`--i:${i}`}>
              <span class="mkmh"><b>{c.n}</b><em class="mkdelta">{c.d}</em></span>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="mkcv" aria-hidden="true">
                <line x1="0" y1="25" x2="100" y2="25" /><line x1="0" y1="50" x2="100" y2="50" />
                <line x1="0" y1="75" x2="100" y2="75" />
                <polygon points={g.alan} /><polyline points={g.pts} />
              </svg>
              <span class="mkax"><i>{T(c.a0, dil)}</i><i>{T(c.a1, dil)}</i></span>
              <span class="mkline"><i>{T(c.top, dil)}</i><em>{c.tv}</em></span>
            </span>
          ); })}</div>
        </section>

        {/* 4 — risk iştahı */}
        <section class="mkact" data-a="3" style="--i:3">
          <div class="mksplit2">
            <div class="mkcomps"><span class="mklab">{T(m.riskLab, dil)}</span>
              {riskler.map((r, i) => <span class="mkcomp" data-i={i} style={`--i:${i}`}>
                <i>{T(r.n, dil)}</i>
                <span class="mkbar"><b style={`--w:${r.w}%`} /></span><em>{r.v}</em></span>)}</div>
            <div class="mkranks"><span class="mklab">{T(m.rankLab, dil)}</span>
              <div class="mkrkbox">{pazarlar.map((c: any, i: number) =>
                <span class="mkrk" data-i={i} style={`--i:${i};--o:${c.rank ?? i}`}>
                  <i>{c.n}</i><em>{c.score}</em></span>)}</div></div>
          </div>
        </section>

        {/* 5 — davranışsal motor */}
        <section class="mkact" data-a="4" style="--i:4">
          <div class="mkeng"><svg class="mkwire" aria-hidden="true" />
            <div class="mkins">{girdiler.map((x, i) =>
              <span class="mkin" data-i={i} style={`--i:${i}`}>{T(x, dil)}</span>)}</div>
            <div class="mkcore" role="img" aria-label={T(m.engineLab, dil)}>
              <i class="amDis" /><i class="amBeyin" /><i class="amIc" /></div>
            <div class="mkhyps">{hipotezler.map((x: any, i: number) =>
              <span class={'mkhy' + (x.win ? ' win' : '')} data-i={i} style={`--i:${i}`}>
                <i>{T(x.n, dil)}</i><em>{x.p}</em></span>)}</div>
          </div>
        </section>

        {/* 6 — karar ve sıçrama */}
        <section class="mkact" data-a="5" style="--i:5">
          <div class="mkdecs">{kararlar.map((x, i) =>
            <span class="mkdc" data-i={i} style={`--i:${i}`}><i>{T(x.k, dil)}</i><b>{T(x.v, dil)}</b></span>)}</div>
          <div class="mkjump">
            <div class="mkjc ask"><span class="mkjl">{T(m.askLab, dil)}</span><b>{T(m.ask, dil)}</b></div>
            <div class="mkjc got"><span class="mkjl">{T(m.gotLab, dil)}</span>
              <b>{T(m.got, dil)}</b><i>{T(m.gotWhy, dil)}</i></div>
          </div>
        </section>

        {/* 7 — kampanya devri */}
        <section class="mkact" data-a="6" style="--i:6">
          <span class="mklab">{T(m.campLab, dil)}</span>
          <div class="mkchs">{kanallar.map((x, i) =>
            <span class="mkch" data-i={i} style={`--i:${i}`}><i>{T(x.n, dil)}</i><em>{x.s}</em></span>)}</div>
          <div class="mkinf"><b /><span><i>{T(m.infLab, dil)}</i><em>{T(m.inf, dil)}</em></span></div>
          <div class="mkhand">{T(m.hand, dil)}</div>
        </section>

        {/* 8 — dünya haritası (finale) */}
        <section class="mkact mkmapact" data-a="7" style="--i:7">
          <div class="mkmapwrap">
            {/* kara katmanı: derlemede basılmış nokta ızgarası (üreteç
                gorsel-uret.cjs · kaynağın QG ızgarası, ana sayfa
                haritasıyla PAYLAŞILAN dosya) */}
            <picture class="mkkara">
              {/* 800 px'lik mobil varyant KALDIRILDI (5 Eyl 2026): harita
                  mobilde artık kendi oranında ve zumlu duruyor, görünen
                  dilim dünyanın %21'i — 800 px'lik dosya o dilimde 169 px
                  kaynak demekti ve ızgara bulanıklaşıyordu (kare alındı,
                  yan yana bakıldı). 1600 px'lik dosya aynı dilimde 338
                  kaynak piksel verir. Bedel: mobilde +15,8 KB görüntü. */}
              <img src={`${B}/img/kara.webp`} width="1600" height="568" alt=""
                loading="lazy" decoding="async" />
            </picture>
            {/* 243 ülke — yuvarlak kalsınlar diye SVG'de değil, yüzde
                konumlu noktalar (SVG kutusu gerilir, nokta gerilmez) */}
            <div class="mkco">{ulkeGrup.map((gr: any) => (
              <span class="mkcg" style={`--i:${gr.i}`}>{gr.g.map((c: any) => { const y = yuzde(c.lon, c.lat); return (
                <i class={'mkc w' + c.w} style={`left:${y.x.toFixed(2)}%;top:${y.y.toFixed(2)}%`} />
              ); })}</span>
            ))}</div>
            {/* küresel ağ YAYLARI: tohumlu 64 çift (kaynak AG üreteci birebir),
                8 grup, her grup kendi aralık çizelgesinde çizilir; bitince
                statik (TUR 2 — bkz. frontmatter). */}
            <style set:html={yayStil} />
            <svg class="mkag-yay" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="none" aria-hidden="true">
              {yayGrup.map((gr: any, i: number) => (
                <g class={`mkagg yg${i}`}>
                  {gr.g.map((L: any) => <path class="mkagy" d={L.d} pathLength="1" />)}
                </g>
              ))}
            </svg>
            {/* ağ PAKETLERİ: zaman animasyonu (kaynak "oklar sürekli aksın"),
                grup opaklığı yayın çizimi bitince açılır (aralık çizelgesi) */}
            <svg class="mkag-pak" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="none" aria-hidden="true">
              {yayGrup.map((gr: any, i: number) => (
                <g class={`mkagg pg${i}`}>
                  {gr.g.map((L: any) => <circle class="mkagp" r="1.7"
                    style={`offset-path:path('${L.d}');animation-duration:${L.hiz.toFixed(2)}s;animation-delay:${(-L.faz * L.hiz).toFixed(2)}s`} />)}
                </g>
              ))}
            </svg>
