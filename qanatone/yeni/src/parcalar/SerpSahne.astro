---
/* K7 · TIRMANIŞ SAHNESİ (#clStage) — SEO hizmetinin kaydırma sahnesi.
   Kaynak: kök index.html · markup serpStage 7637-7651 · CSS 721-745 +
   776-782 + 850 + 862-864 · sürücü draw 8749-8770, ST 8998-9005.
   Hizmet: seo (fam:'climb' + det.serp).

   KİLİTLİ SAHNE (pin .95) — kaynağın tek pin'li K7 sahnesi ve burada
   ALINDI: sahne kısa (ölçüldü: 532 px masaüstü), 100vh'ye sığıyor;
   sızıntıdaki engel (bölüm 100vh'ye sığmıyor, D2c) burada yok.
   Desen deste adasının kanıtlanmış dersi: zaman çizelgesinin ÖZNESİ
   sticky olmayan KAP, animasyonu sticky sahne alır — view()'i doğrudan
   sticky elemana koymak ölçülüp YANLIŞ bulunmuştu (sticky kayması
   çizelgeye giriyor). Kilit süresi kaynağın kendi payı: +=95vh.

   Eşikler kaynak draw'dan (8752-8768):
     e = 1−(1−p)³ · sen: translateY((tops[0]−yTop)·e)
     yp = 4−4e · push_i = clamp(0,(i+1)−yp,1)
     rakip i: translateY(push·dst_i) · opacity .5+.28(1−push)
     sıra etiketi: '#' + (1 + round((1−e)·7))   → #8 … #1
     zirve: e > .96 → .you.top + etiket vuruşu (clhit, 862-864)

   ÖLÇÜM: dst değerleri satır yüksekliklerine bağlı ve satırlar EŞİT
   DEĞİL (rakip satırı iki, sen üç satırlık). Kaynak da bu yüzden
   offsetTop okuyordu (8757 yorumu). Ada aynı ölçümü rAF DIŞINDA
   yapar (kurulum + resize 180ms + fonts.ready + ResizeObserver) ve
   CSS değişkenine yazar; scrub CSS'te sürer. Göz kararı sabit YOK.

   TABAN = TAMAMLANMIŞ (kaynak REDUCE dalı draw(1), 8972): desteksiz
   tarayıcı ve reduced-motion zirveyi görür. İçerik JS'siz tam. */
import { T, type Dil } from '../icerik';
interface Props { serp: any; dil: Dil }
const { serp, dil } = Astro.props;
const en = dil === 'en';
/* rakip çubuk genişlikleri kaynak sabiti (7638) */
const W = [74, 58, 66, 49];
---
{serp?.you && (
<div class="sdsec">
  <span class="mono">{en ? 'The climb — live on scroll' : 'Tırmanış — kaydırdıkça canlanır'}</span>
  <div class="cl-kap">
    <div class="clstage">
      <div class="clsearch">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.4-3.4" /></svg>
        <span>{T(serp.q, dil)}</span>
        <b class="clpos" />
      </div>
      <div class="cllist">
        {W.map((w, i) => (
          <div class="clr" style={`--i:${i}`}>
            <span class="clfav g" /><span class="clrt">
              <b>{(en ? 'Competitor ' : 'Rakip Firma ') + (i + 1)}</b>
              <i style={`width:${w}%`} /></span>
          </div>
        ))}
        <div class="clr you">
          <span class="clfav" /><span class="clyt">
            <em>{serp.you.dom}</em>
            <b>{T(serp.you.t, dil)}</b>
            <span class="clms">{en ? 'fast · documented · local' : 'hızlı · belgeli · yerel'}</span>
          </span>
        </div>
      </div>
    </div>
  </div>
  {serp.note && <div class="fnnote">{T(serp.note, dil)}</div>}
</div>
)}

<style>
  .sdsec { margin-top: clamp(44px, 6vw, 72px); }
  .sdsec > .mono { display: block; margin-bottom: 18px;
    font-family:var(--f-tek); font-size: .7rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--tx4); }
  .fnnote { font-family:var(--f-tek); font-size: .68rem; letter-spacing: .06em;
    color: var(--tx4); margin-top: 10px; }

  /* --- kap ve sahne: kaynak 721-745 birebir (Manrope→gövde F1) --- */
  .clstage { border: 1px solid var(--line); border-radius: 18px; background: var(--card);
    padding: clamp(18px, 2.6vw, 28px); overflow: hidden; }
  .clsearch { display: flex; align-items: center; gap: 11px; padding: 12px 16px;
    margin-bottom: 18px; border: 1px solid var(--line2); border-radius: 999px;
    background: #0c0c0d; }
  .clsearch svg { width: 16px; height: 16px; color: var(--tx3); flex: none; }
  .clsearch span { font-size: .9rem; color: var(--tx2); font-family:var(--f-tek); }
  .clpos { margin-left: auto; font-family:var(--f-tek); font-size: 12px;
    color: var(--red-soft); border: 1px solid rgba(239, 35, 60, .35); border-radius: 8px;
    padding: 4px 10px; background: rgba(239, 35, 60, .07); font-variant-numeric: tabular-nums; }
  .cllist { display: flex; flex-direction: column; gap: 10px; }
  .clr { border: 1px solid var(--line); border-radius: 12px; background: #0c0c0d;
    padding: 14px 16px; min-height: 56px; display: flex; align-items: center; gap: 12px; }
  .clfav { width: 22px; height: 22px; border-radius: 6px; background: var(--red); flex: none; }
  .clfav.g { background: rgba(255, 255, 255, .14); }
  .clrt { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 0; }
  .clrt b { font-size: .84rem; font-weight: 600; letter-spacing: -.01em; }
  .clrt i { display: block; height: 7px; border-radius: 4px; background: rgba(255, 255, 255, .07); }
  .clyt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .clyt em { font-style: normal; font-family:var(--f-tek); font-size: 10px;
    letter-spacing: .08em; color: var(--red-soft); }
  .clyt b { font-size: .94rem; font-weight: 600; letter-spacing: -.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .clms { font-size: .66rem; color: var(--tx4); font-family:var(--f-tek); }
  .clr.you { border-color: rgba(239, 35, 60, .45);
    background: linear-gradient(90deg, rgba(239, 35, 60, .10), rgba(239, 35, 60, .02));
    position: relative; z-index: 2; }

  /* --- KİLİT: kap sticky DEĞİL (çizelge öznesi), sahne sticky --- */
  .cl-kap { min-height: calc(100vh + 95vh); }
  .clstage { position: sticky; top: calc((100vh - var(--sh, 560px)) / 2); }

  /* --- sürücü: kilit süresince 0→1 --- */
  @property --clp { syntax: '<number>'; inherits: true; initial-value: 1; }
  @supports (animation-timeline: view()) {
    .cl-kap { view-timeline-name: --cl-kap; view-timeline-axis: block; }
    .clstage { animation: clp-surus linear both; animation-timeline: --cl-kap;
      /* kilit, kabın üstü sticky noktasına gelince başlar (cover
         başlangıcından 100vh − top kadar sonra) ve 95vh sürer */
      animation-range: cover calc(50vh + var(--sh, 560px) / 2)
                       cover calc(145vh + var(--sh, 560px) / 2); }
  }
  @keyframes clp-surus { from { --clp: 0; } to { --clp: 1; } }

  /* e = 1−(1−p)³ */
  .clstage { --cu: calc(1 - var(--clp, 1));
    --e: calc(1 - var(--cu) * var(--cu) * var(--cu));
    --yp: calc(4 - 4 * var(--e)); }
  /* rakip satırı: push ve öteleme — dst ada ölçümünden (--dst) */
  .clr:not(.you) { --push: clamp(0, (var(--i, 0) + 1) - var(--yp), 1);
    transform: translateY(calc(var(--push) * var(--dst, 0px)));
    opacity: calc(.5 + .28 * (1 - var(--push))); }
  /* sen: ilk sıraya çıkarsın — mesafe ada ölçümünden (--yol) */
  .clr.you { transform: translateY(calc(var(--yol, 0px) * var(--e))); }
  /* zirve: e > .96 (8766) */
  .clr.you { --zirve: clamp(0, (var(--e) - .96) * 100, 1);
    border-color: color-mix(in srgb, var(--red) calc(var(--zirve) * 100%), rgba(239, 35, 60, .45)); }
  /* zirve rozeti — kaynak .clr.you::after (784-789) */
  .clr.you::after { content: '#1'; position: absolute; top: -9px; right: 12px;
    font-family:var(--f-tek); font-size: 10px; color: #fff;
    background: var(--red); border-radius: 7px; padding: 2px 8px;
    opacity: var(--zirve);
    transform: translateY(calc((1 - var(--zirve)) * 4px)) scale(calc(.8 + .2 * var(--zirve))); }
  /* sıra etiketi: '#' + (1 + round((1−e)·7)) — kaynakta textContent'ti,
     burada CSS sayacı (huni sahnesinin dersi; ada JS'i sıfır) */
  .clpos { counter-reset: clsira calc(1 + round(nearest, (1 - var(--e)) * 7, 1)); }
  .clpos::after { content: '#' counter(clsira); }

  /* gölgeler H14: kaynak .clr.you (736) ve .clfav (739) yalnız masaüstü;
     zirve vuruşu (clhit 862-864) da gölgeli — aynı kapıda */
  @media (min-width: 901px) {
    .clr.you { box-shadow: 0 12px 34px -14px rgba(239, 35, 60, .45); }
    .clfav { box-shadow: 0 0 12px rgba(239, 35, 60, .6); }
    .clfav.g { box-shadow: none; }
    .clr.you::after { box-shadow: 0 0 14px rgba(239, 35, 60, .55); }
  }
  /* kaynak mobil çizelgesi: 847 (padding) + 850 (satır yazısı) */
  @media (max-width: 760px) {
    .clstage { padding: 16px 14px; }
    .clrt b { font-size: .76rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .clstage { animation: none; }
    .cl-kap { min-height: 0; }
    .clstage { position: static; }
  }
</style>

<script>
  /* SATIR ÖLÇÜMÜ — kaynak offsetTop okumasının yerlisi (8757).
     Satır yükseklikleri eşit değil; her rakip satırı için bir sonrakine
     olan mesafe (dst) ve "sen"in ilk sıraya olan yolu ölçülür.
     rAF DIŞINDA: kurulum + resize(180ms) + fonts.ready + ResizeObserver.
     Sticky top ve çizelge aralığı sahne yüksekliğine bağlı — o da
     burada ölçülüp --sh olarak yazılır. */
  const kap = document.querySelector('.cl-kap') as HTMLElement | null;
  if (kap) {
    const sahne = kap.querySelector('.clstage') as HTMLElement | null;
    const olc = () => {
      if (!sahne) return;
      const riv = [...kap.querySelectorAll<HTMLElement>('.clr:not(.you)')];
      const you = kap.querySelector<HTMLElement>('.clr.you');
      if (!riv.length || !you) return;
      const tops = riv.map(r => r.offsetTop), yTop = you.offsetTop;
      riv.forEach((r, i) => {
        const dst = (i < riv.length - 1 ? tops[i + 1] : yTop) - tops[i];
        r.style.setProperty('--dst', dst.toFixed(1) + 'px');
      });
      you.style.setProperty('--yol', (tops[0] - yTop).toFixed(1) + 'px');
      kap.style.setProperty('--sh', sahne.offsetHeight + 'px');
    };
    let rt: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(olc, 180); });
    document.fonts?.ready?.then(olc);
    if ('ResizeObserver' in window) new ResizeObserver(olc).observe(sahne!);
    olc();
  }
</script>
