    --flm1: clamp(0, calc((.5 - var(--fm1)) * 100000), 1);
    --fzm1: calc(var(--flm1) * 2 * var(--fm1) * var(--fm1) + (1 - var(--flm1))
             * (1 - (2 - 2 * var(--fm1)) * (2 - 2 * var(--fm1)) / 2));
    --fln1: clamp(0, calc((.5 - var(--fn1)) * 100000), 1);
    --fzn1: calc(var(--fln1) * 2 * var(--fn1) * var(--fn1) + (1 - var(--fln1))
             * (1 - (2 - 2 * var(--fn1)) * (2 - 2 * var(--fn1)) / 2));
    --flm2: clamp(0, calc((.5 - var(--fm2)) * 100000), 1);
    --fzm2: calc(var(--flm2) * 2 * var(--fm2) * var(--fm2) + (1 - var(--flm2))
             * (1 - (2 - 2 * var(--fm2)) * (2 - 2 * var(--fm2)) / 2));
    --fln2: clamp(0, calc((.5 - var(--fn2)) * 100000), 1);
    --fzn2: calc(var(--fln2) * 2 * var(--fn2) * var(--fn2) + (1 - var(--fln2))
             * (1 - (2 - 2 * var(--fn2)) * (2 - 2 * var(--fn2)) / 2));
    --flm3: clamp(0, calc((.5 - var(--fm3)) * 100000), 1);
    --fzm3: calc(var(--flm3) * 2 * var(--fm3) * var(--fm3) + (1 - var(--flm3))
             * (1 - (2 - 2 * var(--fm3)) * (2 - 2 * var(--fm3)) / 2));
    --fln3: clamp(0, calc((.5 - var(--fn3)) * 100000), 1);
    --fzn3: calc(var(--fln3) * 2 * var(--fn3) * var(--fn3) + (1 - var(--fln3))
             * (1 - (2 - 2 * var(--fn3)) * (2 - 2 * var(--fn3)) / 2));

    /* sürgü hedefi: kaynak canlı gBCR okuyordu — burada kendi formülü */
    --fknx: calc(var(--frx, 0) + var(--akq) * var(--frw, 0));

    --fpx0: calc(var(--fx0a, 0) + (var(--fx0b, 0) - var(--fx0a, 0)) * var(--fzm0));
    --fpy0: calc(var(--fy0a, 0) + (var(--fy0b, 0) - var(--fy0a, 0)) * var(--fzm0));
    --fpx1: calc(var(--fx1a, 0) + (var(--fknx) - var(--fx1a, 0)) * var(--fzm1)
            + (var(--fx1c, 0) - var(--fknx)) * var(--fzn1));
    --fpy1: calc(var(--fy1a, 0) + (var(--fy1b, 0) - var(--fy1a, 0)) * var(--fzm1)
            + (var(--fy1c, 0) - var(--fy1b, 0)) * var(--fzn1));
    --fpx2: calc(var(--fx2a, 0) + (var(--fx2b, 0) - var(--fx2a, 0)) * var(--fzm2)
            + (var(--fx2c, 0) - var(--fx2b, 0)) * var(--fzn2));
    --fpy2: calc(var(--fy2a, 0) + (var(--fy2b, 0) - var(--fy2a, 0)) * var(--fzm2)
            + (var(--fy2c, 0) - var(--fy2b, 0)) * var(--fzn2));
    --fpx3: calc(var(--fx3a, 0) + (var(--fx3b, 0) - var(--fx3a, 0)) * var(--fzm3)
            + (var(--fx3c, 0) - var(--fx3b, 0)) * var(--fzn3));
    --fpy3: calc(var(--fy3a, 0) + (var(--fy3b, 0) - var(--fy3a, 0)) * var(--fzm3)
            + (var(--fy3c, 0) - var(--fy3b, 0)) * var(--fzn3));

    --fpx: calc(var(--fa0) * var(--fpx0) + var(--fa1) * var(--fpx1)
             + var(--fa2) * var(--fpx2) + var(--fa3) * var(--fpx3));
    /* sayfa uzayından görüntü uzayına: y − mx·e (mx ölçülür) */
    --fpy: calc(var(--fa0) * var(--fpy0) + var(--fa1) * var(--fpy1)
             + var(--fa2) * var(--fpy2) + var(--fa3) * var(--fpy3)
             - var(--fgor) * var(--fmx, 0) * var(--ae));
    transform: translate(calc(var(--fpx) * 1px), calc(var(--fpy) * 1px));
    /* k = clamp((seg−.8)/.2); GEÇERLİ segment = başlamış olanların sonuncusu */
    --fk0: calc((1 - clamp(0, calc(var(--fm0) * 100000), 1)) * clamp(0, calc((var(--fp0) - .8) * 5), 1)
    + clamp(0, calc(var(--fm0) * 100000), 1) * clamp(0, calc((var(--fm0) - .8) * 5), 1));
    --fb1: clamp(0, calc(var(--fm1) * 100000), 1); --fc1: clamp(0, calc(var(--fn1) * 100000), 1);
    --fk1: calc((1 - var(--fb1)) * clamp(0, calc((var(--fp1) - .8) * 5), 1)
    + var(--fb1) * (1 - var(--fc1)) * clamp(0, calc((var(--fm1) - .8) * 5), 1)
    + var(--fc1) * clamp(0, calc((var(--fn1) - .8) * 5), 1));
    --fb2: clamp(0, calc(var(--fm2) * 100000), 1); --fc2: clamp(0, calc(var(--fn2) * 100000), 1);
    --fk2: calc((1 - var(--fb2)) * clamp(0, calc((var(--fp2) - .8) * 5), 1)
    + var(--fb2) * (1 - var(--fc2)) * clamp(0, calc((var(--fm2) - .8) * 5), 1)
    + var(--fc2) * clamp(0, calc((var(--fn2) - .8) * 5), 1));
    --fb3: clamp(0, calc(var(--fm3) * 100000), 1); --fc3: clamp(0, calc(var(--fn3) * 100000), 1);
    --fk3: calc((1 - var(--fb3)) * clamp(0, calc((var(--fp3) - .8) * 5), 1)
    + var(--fb3) * (1 - var(--fc3)) * clamp(0, calc((var(--fm3) - .8) * 5), 1)
    + var(--fc3) * clamp(0, calc((var(--fn3) - .8) * 5), 1));
    --fk: calc(var(--fa0) * var(--fk0) + var(--fa1) * var(--fk1)
    + var(--fa2) * var(--fk2) + var(--fa3) * var(--fk3));

