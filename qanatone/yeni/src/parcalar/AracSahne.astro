  @property --fzm1 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fzm2 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fzm3 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fzn1 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fzn2 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fzn3 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @keyframes stp-surus { from { --stp: 0; } to { --stp: 1; } }
  @supports (animation-timeline: view()) {
    /* KİLİT: kap sticky DEĞİL (çizelgenin öznesi), sarmal sticky.
