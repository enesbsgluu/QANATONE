  @property --fpx1 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fpx2 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fpx3 { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fpy { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fpy0 { syntax: '<number>'; inherits: false; initial-value: 0; }
