    opacity: calc(var(--folc, 0) * var(--fgor)
             * clamp(0, calc((var(--fpy) + 14) * 100000), 1)
             * clamp(0, calc((var(--fvh, 0) + 14 - var(--fpy)) * 100000), 1)); }

