    --fa1: calc(var(--fa1h) * (1 - var(--fa0)));
    --fa2: calc(clamp(0, calc((var(--ab) - .02) * 100000), 1)
             * clamp(0, calc((.99 - var(--ab)) * 100000), 1));
    --fa3: calc(clamp(0, calc((var(--ag) - .02) * 100000), 1)
             * clamp(0, calc((.99 - var(--ag)) * 100000), 1));
    --fgor: calc(var(--fa0) + var(--fa1) + var(--fa2) + var(--fa3));

    /* segment ilerlemeleri: ilk hedefe varış (yerinde tık) + geçişler */
    --fp0: clamp(0, calc(var(--ft0) / .28), 1);
    --fm0: clamp(0, calc((var(--ft0) - .28) / .42), 1);
    --fp1: clamp(0, calc(var(--aq) / .06), 1);
    --fm1: clamp(0, calc((var(--aq) - .06) / .26), 1);
    --fn1: clamp(0, calc((var(--aq) - .32) / .46), 1);
    --fp2: clamp(0, calc(var(--ab) / .24), 1);
    --fm2: clamp(0, calc((var(--ab) - .24) / .32), 1);
    --fn2: clamp(0, calc((var(--ab) - .56) / .3), 1);
    --fp3: clamp(0, calc(var(--ag) / .14), 1);
    --fm3: clamp(0, calc((var(--ag) - .14) / .46), 1);
    --fn3: clamp(0, calc((var(--ag) - .6) / .3), 1);

    /* easeInOut — "gerçek el böyle gider" (8888): s<.5 ? 2s² : 1−(2−2s)²/2 */
    --flm0: clamp(0, calc((.5 - var(--fm0)) * 100000), 1);
    --fzm0: calc(var(--flm0) * 2 * var(--fm0) * var(--fm0) + (1 - var(--flm0))
