---
/* Otomasyon gövdesi — TR ve EN aynı parça (rota turunun son ve en ağır
   sayfası). Beş blok: akış mantığı · doğru model · bir gün · sızıntı ·
   huni. Metin düşüşü data-t düzeninin aynısı: strings[dil][k] doluysa
   panelinki, boşsa varsayılan (93 anahtarın TÜMÜ strings.en'de var,
   hiçbiri strings.tr'de yok — TR kaynağı markup, ölçüldü).

   AKIŞ STATİK DOĞUYOR: eski #flow tamamen JS'le kuruluyordu (IN/OUT/
   STEPS haritaları kodda; teller getBoundingClientRect'le çizilip rAF
   paketleriyle canlandırılıyordu) — bot kanal/adım/aksiyon adlarının
   HİÇBİRİNİ görmüyordu. Üç kolonun içeriği artık derlemede basılıyor;
   tel+paket animasyonu giydirme turuna. "Canlı iş akışı" şeridi,
   "N talep işlendi" sayacı ve "Kaydırdıkça akış çalışır" satırı
   TAŞINMADI: statik sayfada sahte canlılık iddiası olur (perdenin
   sahte-dolum kararıyla aynı ilke). Sektör bağlama da taşınmadı —
   eski sayfa doğrudan açılınca zaten 'genel' basıyordu; statik hâl o
   varsayılanın aynısı (giriş google/seo/meta/site, çıkış esnaf seti).

   SIZINTI SAHNESİ: metnin tamamı (kanallar, 4 sızıntı kartı, aşamalar,
   maliyet çubukları) statik; canvas partikülleri ve çubuk dolum
   animasyonu giydirmeye. Çubuklar animasyonun SON hâliyle basılır
   (Önce %100 · Sonra %46 — eski render()'ın vardığı değerler).

   HUNİ = SAYFANIN ADASI (S-TE deseni): iskelet ve varsayılan rakamlar
   DERLEMEDE basılır (src/huni.mjs — testli, T1), JS yalnız kaydırıcı
   dinler ve değer yazar; açılışta sıfır iş. JS kapalıyken sayfa
   varsayılan rakamlarla anlamlı durur. */
import { icerik, T, suz, type Dil } from '../icerik';
import { DEG, huni, fmt } from '../huni.mjs';
import Ikon from './Ikon.astro';
interface Props { dil: Dil }
const { dil } = Astro.props;
const M = (tr: string, en: string) => dil === 'en' ? en : tr;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const s = (icerik.strings && icerik.strings[dil]) || {};
const m = (k: string, varsayilan: string): string => T(s[k], dil) || varsayilan;

/* Akış içerik setleri — kaynaktan (flowKur IN/OUT/STEPS), 'genel'
   varsayılanı: giriş google/seo/meta/site, çıkış 'esnaf' seti. Kodda
   sabittiler, panel zaten ezemiyordu; davranış değişmedi. */
/* Üçüncü eleman İKON anahtarı — kaynak IN/OUT haritalarından birebir
   (10498-10516: google→target, seo→seo, meta→camera, site→site;
   esnaf çıkışı calendar/clipboard/handoff/trend; trend kaynakta
   chart'a düşer — 10524). */
const GELEN = dil === 'en'
  ? [['Google Ads', 'search', 'target'], ['Organic search', 'SEO', 'seo'], ['Instagram DM', 'Meta', 'camera'], ['Web form', 'site', 'site']]
  : [['Google Ads', 'arama', 'target'], ['Organik arama', 'SEO', 'seo'], ['Instagram DM', 'Meta', 'camera'], ['Web formu', 'site', 'site']];
const ADIMLAR = dil === 'en'
  ? [['Enquiry read', '0.3s'], ['Intent extracted', '0.6s'], ['Matched to pricing', '0.9s'], ['Reply sent', '1.2s'], ['CRM + reminder', '1.4s']]
  : [['Talep okundu', '0,3 sn'], ['Niyet çıkarıldı', '0,6 sn'], ['Fiyat/kapsam eşleşti', '0,9 sn'], ['Yanıt gönderildi', '1,2 sn'], ['CRM + hatırlatma', '1,4 sn']];
const CIKAN = dil === 'en'
  ? [['Booked', 'calendar', 'calendar'], ['Price range', 'instant', 'clipboard'], ['Handover', 'special', 'handoff'], ['Filtered', 'out of area', 'chart']]
  : [['Randevu yazıldı', 'takvim', 'calendar'], ['Fiyat aralığı', 'anında', 'clipboard'], ['Sana devir', 'özel iş', 'handoff'], ['Elendi', 'bölge dışı', 'chart']];

/* Bir gün zaman çizelgesi: saatler markup sabitiydi (data-t YOK). */
const GUN: [string, string, string][] = [
  ['02:41', m('gn3', 'Sen uyurken talep geldi.'), m('gn4', "WhatsApp'tan yazdı. Ajan okudu, niyeti çıkardı, fiyat aralığını verdi ve takvimden uygun saati önerdi. On bir saniye sürdü.")],
  ['07:00', m('gn5', 'Sabah özeti hazır.'), m('gn6', 'Gece ne oldu, bugün kim seni bekliyor, hangi iş kimde bekliyor. Tek ekran, üç dakika.')],
  ['09:00', m('gn7', 'Sessizleşenlere takip gitti.'), m('gn8', 'Teklif gönderildi ama dönmedi diye kenarda duran altı kişiye, sen hiçbir şey yapmadan hatırlatma çıktı.')],
  ['13:30', m('gn9', 'Randevuya gelmeyene mesaj düştü.'), m('gna', 'İptal değil, yeniden planlama. Boşa çıkan saat aynı gün başkasına açıldı.')],
  ['17:00', m('gnb', 'Hangi kanal kaç iş getirdi, görünüyor.'), m('gnc', 'Tahmin değil, rakam. Bir sonraki ayın bütçesi buna bakarak dağıtılıyor.')],
  [m('gnd', 'Sonrası'), m('gne', 'Geriye yalnız senin yapabileceğin iş kaldı.'), m('gnf', 'Görüşmeye girmek, işi kurgulamak, fiyatı savunmak. Ötekilerin hepsi zaten oldu.')],
];

/* Sızıntı kartları: sorun (b) + belirti (i) + çözüm (fix). */
const SIZINTI = [
  [m('sz7', 'Teklif sonrası kayboldu'), m('szm', 'gönderildi, sonra sessizlik'), m('szq', 'otomatik takip dizisi')],
  [m('sz8', 'Randevuya gelmedi'), m('szn', 'gün geldi, kimse aramadı'), m('szr', 'kendiliğinden hatırlatma')],
  [m('sz9', 'Takip edilmedi'), m('szo', 'sırada kaldı, kimse dönmedi'), m('szs', 'tek hatta toplandı')],
  [m('sza', 'Cevapsız kaldı'), m('szp', 'gece yazdı, sabah unutuldu'), m('szt', 'ajan saniyede yanıtlar')],
];
const KANALLAR = [m('szh', 'Google Ads'), m('szi', 'Organik arama'), m('szj', 'Meta'),
  m('szk', 'WhatsApp'), m('szl', 'Web formu')];
const ASAMALAR = [m('sz4', 'Keşif'), m('sz5', 'Değerlendirme'), m('sz6', 'Karar')];

/* Huni varsayılanları — kaynağın markup değerleri; rakamlar DERLEMEDE
   aynı modülle hesaplanır, ada açılışta hiçbir şey yeniden yazmaz. */
const V0 = 60, YUZDE = [18, 22, 30, 15], IDX5 = 13;
const { kademe, kacan } = huni(V0, YUZDE);
const hsEtiket = [m('hs9', 'gelen'), m('hs5', 'Cevapsız kalan'), m('hs6', 'Takip edilmeyen'),
  m('hs7', 'Teklif sonrası sessizleşen'), m('hsa', 'konuşmaya kalan')];
const KAYDIRICI = [
  { id: 1, ad: m('hs5', 'Cevapsız kalan'), deger: YUZDE[0] },
  { id: 2, ad: m('hs6', 'Takip edilmeyen'), deger: YUZDE[1] },
  { id: 3, ad: m('hs7', 'Teklif sonrası sessizleşen'), deger: YUZDE[2] },
  { id: 4, ad: m('hs8', 'Randevuya gelmeyen'), deger: YUZDE[3] },
];

/* TELLER (sadakat kuralı, 21 Ağu) — iki öğeyi birleştiren çizim GÖZ
   KARARI ÇİZİLMEZ. Eski göz kararı yelpaze (TELY sabitleri) söküldü;
   uçlar artık kaynağın wire() künyesiyle ÖLÇÜLÜR (kök 10553-10600):
   masaüstü düğüm sağ-orta → kart sol kenarı .42h (giriş) / kart sağ
   .58h → düğüm sol-orta (çıkış), kontrol x'i orta nokta; mobil uç
   y'ler şerit kenarları, x dağılımı kaynak formülü sp=min(34,w·.08),
   birleşme kart merkezi + fjoin düğüm daireleri (kaynak yalnız mobilde
   basıyordu). Ölçüm rAF DIŞINDA: kurulum + resize(180ms) + fonts.ready
   (klasör telleri deseni). SSR'de d BOŞ: kaynakta teller JS ürünüydü,
   JS'siz ziyaretçi kaynaktaki gibi telsiz görür. İz (pathLength=1 +
   dasharray akan parça) kaynak paketlerinin eşleniği. */
const TELI = [0, 1, 2, 3];
---
<section class="giris">
  <p class="ust-etiket">{m('s8e', 'Yapay zekâ ajanları')}</p>
  <h1 set:html={suz(m('s8h', 'Hazır bot değil.<br><span class="thin">Senin işini öğrenen ajan.</span>'), ['br', 'span.thin'])} />
  <p class="lede">{m('s8p', 'Her kanal tek bir merkeze bağlanır. Ajan gelen talebi karşılar, eler, yönlendirir — sonuç elinde hazır olarak durur.')}</p>
</section>

{/* ---- AKIŞ MANTIĞI (içerik statik; teller süs) ----
     A3-D1 (sürücü düzeltmesi): kaynağın reveal(p) scrub'ı geri geldi —
     eşikler kökün 10632-10639 formülleri BİREBİR: giriş .06+i·.07,
     beyin .34, çıkış .50+i·.08, teller .12+i·.07 / .52+i·.08; sürücü
     ST scrub yerine anonim view() (--fyt, SurecGovde deseni). */}
<div class="akis3">
  {/* Düğüm yapısı kaynak .fnode birebiri (build 10538-10539): ikon
      kutusu .ni + metin .nt + durum noktası .nd. Kaynakta tik YOK —
      önceki fark listesi .fln'i (başka bileşen, 701) akış sanmıştı;
      gerçek düğüm .fnode 1336. --hi: hot dalgası fazı (tick 10622:
      1.5 adım/sn; çıkış +2 faz). */}
  <div class="akol">
    <p class="akbas">{m('flc1', 'Gelen')}</p>
    {GELEN.map(([ad, alt, ikn], i) => <p class="adugum" style={`--fe:${(0.06 + i * 0.07).toFixed(2)};--hi:${i}`}>
      <span class="ni"><Ikon ad={ikn} /></span>
      <span class="nt"><b>{ad}</b><span>{alt}</span></span><span class="nd" /></p>)}
  </div>
  <svg class="sus-tel sol" viewBox="0 0 100 400" preserveAspectRatio="none" aria-hidden="true">
    {TELI.map(() => <path class="tel" d="" />)}
    {TELI.map(i => <path class="tel-yak" d="" style={`--fe:${(0.12 + i * 0.07).toFixed(2)}`} />)}
    {TELI.map(i => <path class={`tel-iz iz${i}`} d="" pathLength="1" />)}
  </svg>
  <svg class="sus-tel-m sol" viewBox="0 0 400 72" preserveAspectRatio="none" aria-hidden="true">
    {TELI.map(() => <path class="tel" d="" />)}
    {TELI.map(i => <path class="tel-yak" d="" style={`--fe:${(0.12 + i * 0.07).toFixed(2)}`} />)}
    {TELI.map(i => <path class={`tel-iz iz${i}`} d="" pathLength="1" />)}
  </svg>
  {/* Beyin kaynak .fbrain birebiri: .bh (bi ikon kutusu + bt metin +
      fbadge "Aktif" — rozet kaynakta YALNIZ MOBİL, 1384/1410; noktası
      kaynakta ping2 TANIMSIZ keyframe'e bağlıydı → gerçek davranış
      SABİT nokta, öyle basıldı). Adım satırları .fstep: tik dairesi +
      ad + süre; tik ✓ font karakteri değil kaynağın kendi IC.check
      SVG'si (F1c). --fi: adım dalga fazı (tick 10626: 2.2 adım/sn). */}
  <div class="akol beyin">
    <p class="akbas">{m('flc2', 'Ajan')}</p>
    <div class="ajan-kart" style="--fe:.34">
      <p class="ajan-ad"><span class="bi"><Ikon ad="bot" /></span>
        <span class="bt"><b>{m('flb', 'QANATONE Ajanı')}</b>
        <span>{m('flbs', 'Sınıflandır · Ele · Yönlendir')}</span></span>
        <span class="fbadge">{m('flon', 'Aktif')}<i /></span></p>
      <ol>
        {ADIMLAR.map(([ad, sure], i) => <li style={`--fi:${i}`}>
          <i class="fsi"><Ikon ad="check" /></i>
          <span>{ad}</span><em>{sure}</em></li>)}
      </ol>
    </div>
  </div>
  <svg class="sus-tel sag" viewBox="0 0 100 400" preserveAspectRatio="none" aria-hidden="true">
    {TELI.map(() => <path class="tel" d="" />)}
    {TELI.map(i => <path class="tel-yak" d="" style={`--fe:${(0.52 + i * 0.08).toFixed(2)}`} />)}
    {TELI.map(i => <path class={`tel-iz iz${i}`} d="" pathLength="1" />)}
  </svg>
  <svg class="sus-tel-m sag" viewBox="0 0 400 72" preserveAspectRatio="none" aria-hidden="true">
    {TELI.map(() => <path class="tel" d="" />)}
    {TELI.map(i => <path class="tel-yak" d="" style={`--fe:${(0.52 + i * 0.08).toFixed(2)}`} />)}
    {TELI.map(i => <path class={`tel-iz iz${i}`} d="" pathLength="1" />)}
  </svg>
  <div class="akol">
    <p class="akbas">{m('flc3', 'Çıkan')}</p>
    {CIKAN.map(([ad, alt, ikn], i) => <p class="adugum" style={`--fe:${(0.5 + i * 0.08).toFixed(2)};--hi:${i + 2}`}>
      <span class="ni"><Ikon ad={ikn} /></span>
      <span class="nt"><b>{ad}</b><span>{alt}</span></span><span class="nd" /></p>)}
  </div>
</div>

{/* ---- DOĞRU MODEL ---- */}
<div class="blok">
  <p class="kicker">{m('mf0', 'Doğru model')}</p>
  <h2 set:html={suz(m('mf1', 'Yapay zekâ satmıyoruz.<br><em>Geri kazandığın süreci satıyoruz.</em>'), ['br', 'em'])} />
  <p class="aciklama">{m('mf2', 'Teknolojinin kendisi ham hâliyle para ödenecek bir şey değil. Kazanç, teklif sonrası kaybolan müşterinin yeniden takip edilmesinden, randevuya gelmeyenin hatırlatılmasından, dağınık satışın tek hatta toplanmasından ve tekrar eden işin sisteme dönmesinden çıkar. Biz önce şirketini inceler, sonra doğru yatırımı doğru alana yönlendiririz.')}</p>
  <ol class="uc-adim">
    <li><b>01 · {m('mf3', 'Niş')}</b><p>{m('mf4', 'İşini sektör rasyolarıyla ve elimizdeki veri setiyle inceleriz. Hangi kalem para kazandırıyor, hangisi sızdırıyor — önce bunu görürüz.')}</p></li>
    <li><b>02 · {m('mf5', 'Satış')}</b><p>{m('mf6', 'Rakamlarını ölçer, tekrar tekrar yaşadığın ve para kaybettiren problemi buluruz. Sonra onu net bir teklife çeviririz.')}</p></li>
    <li><b>03 · {m('mf7', 'Otomasyon')}</b><p>{m('mf8', 'En sona kalır, çünkü otomasyon bir ürün değil — çözümü teslim etme biçimimiz. Sıra bozulursa araç alırsın, sonuç almazsın.')}</p></li>
  </ol>
  <ul class="kazanc">
    <li><b>{m('mf9', 'Teklif sonrası kaybolan müşteri')}</b><i>{m('mfa', 'yeniden takibe alınır')}</i></li>
    <li><b>{m('mfb', 'Randevuya gelmeyen kişi')}</b><i>{m('mfc', 'kendiliğinden hatırlatılır')}</i></li>
    <li><b>{m('mfd', 'Dağınık satış süreci')}</b><i>{m('mfe', 'tek hatta toplanır')}</i></li>
    <li><b>{m('mff', 'Tekrar eden iş')}</b><i>{m('mfg', 'sisteme döner ve ölçeklenir')}</i></li>
  </ul>
  <p class="kapanis" set:html={suz(m('mfh', 'Ürettiğimiz aracı değil, <em>işletmende oluşan sonucu</em> satıyoruz.'), ['em'])} />
  {/* EN ana sayfa adası kuruldu — eski '/en#iletisim' kaçağı adaya döndü. */}
  <p class="orta"><a class="dugme" href={`${B}${dil === 'en' ? '/en' : ''}/#iletisim`}>{m('mfi', 'Şirketini birlikte inceleyelim')}</a></p>
</div>

{/* ---- BİR GÜN ---- */}
<div class="blok">
  <p class="kicker">{m('gn0', 'Kurulumdan otuz gün sonra')}</p>
  <h2>{m('gn1', 'Bir gün böyle geçiyor.')}</h2>
  <p class="aciklama">{m('gn2', 'Özellik saymayacağız. Sistem kurulduktan sonraki sıradan bir salı gününü anlatacağız — saat saat.')}</p>
  <ol class="gun">
    {GUN.map(([saat, bas, metin]) => (
      <li><span class="saat">{saat}</span>
        <div><b>{bas}</b><p>{metin}</p></div></li>
    ))}
  </ol>
</div>

{/* ---- SIZINTI ----
     A3-D2 (sürücü düzeltmesi): kaynağın szDraw(p) scrub'ı geri geldi —
     DOM eşikleri kökün 10785-10795 formülleri BİREBİR (0-tabanlı):
     çip .02+.02i · aşama .12+.045i · kart .24+.05k · mühür .52+.055k ·
     çubuklar (p−.28)/.15 ve (p−.66)/.24. Sürücü anonim view() --szt.
     KAYNAĞIN PIN'İ (kilitli sahne, +=2.2vh) BU ADIMDA ALINMADI —
     bilinçli: yeni bölüm dikey uzun, 100vh sticky penceresine sığmıyor;
     kilit ancak bölüm kompaktlaşmasıyla (tasarım kararı, Enes) gelir.
     Sürücü sınıfı yine de düzeldi: otomatik değil, kaydırma. */}
{/* SIZINTI — KAYNAK KOMPOZİSYONUNA TAM DÖNÜŞ (21 Ağu, D2b):
    kutu sahne .szstage (2804) → başlık şeridi .szhd + çipler + .szwrap
    (HUNİ SVG'si ortada, kartlar YANLARDA absolute, aşamalar dikey
    ortada, "kalan müşteri" altta, beat rozeti merkezde) + .szfoot
    (çubuklar + aşağı ok + kapanış). Huni geometrisi kaynak canvas
    formüllerinden (LY/LW 10681, bağ hedefleri .30/.70, phyllotaxis
    10777-10779) — koordinatları ADA ölçüp basar (göz kararı yasak),
    SSR'de boş: kaynakta da canvas'ı JS çiziyordu, JS'siz ziyaretçi
    hunisiz görür; kartlar/çipler/çubuklar İÇERİK olarak SSR'de tam.
    Tanecik rAF'ı TAŞINMADI (rota kararı — değişmedi).
    PIN hâlâ YOK (D2c açık, Enes kararı): kaynak max-height'i
    (100vh-44px) pin kilidi içindi, pin'siz alınsa içeriği keserdi —
    bilinçli alınmadı. Sürücü view() scrub aynı. */}
<div class="blok szstage sz-surus">
  <div class="szhd">
    <div>
      <p class="szk"><i />{m('sz0', 'Kanıt')}</p>
      <h2 set:html={suz(m('sz1', 'Bütçeni artırmıyoruz.<br><em>Sızıntıyı kapatıyoruz.</em>'), ['br', 'em'])} />
    </div>
    <div class="szbudget"><b>{m('sz2', 'Aynı bütçe')}</b><i>{m('sz3', 'değişmeyen giriş')}</i></div>
  </div>
  <p class="szchans">{KANALLAR.map((k, i) => <span class="cip" style={`--se:${(0.02 + i * 0.02).toFixed(2)}`}>{k}</span>)}</p>
  <div class="szwrap" id="szWrap">
    <svg class="sus-huni" aria-hidden="true"></svg>
    <div class="szside left">
      {[0, 2].map(k => { const [sorun, belirti, cozum] = SIZINTI[k]; return (
        <span class="szleak" style={`--se:${(0.24 + k * 0.05).toFixed(2)};--sm:${(0.52 + k * 0.055).toFixed(3)}`}>
          <span class="szlt"><b>{sorun}</b><i>{belirti}</i></span>
          <span class="szfix"><s /><span>{cozum}</span></span></span>); })}
    </div>
    <div class="szside right">
      {[1, 3].map(k => { const [sorun, belirti, cozum] = SIZINTI[k]; return (
        <span class="szleak" style={`--se:${(0.24 + k * 0.05).toFixed(2)};--sm:${(0.52 + k * 0.055).toFixed(3)}`}>
          <span class="szlt"><b>{sorun}</b><i>{belirti}</i></span>
          <span class="szfix"><s /><span>{cozum}</span></span></span>); })}
    </div>
    <div class="szstages">
      {ASAMALAR.map((a, i) => <span class="szst"
        style={`--se:${(0.12 + i * 0.045).toFixed(3)};--w:${[92, 58, 30][i]}%`}>
        <b>{a}</b><span class="szsb"><i /></span></span>)}
    </div>
    <span class="szout">{m('szb', 'kalan müşteri')}</span>
    <span class="szbeat">{m('szu', 'Bütçe aynı. Sorun burada.')}</span>
  </div>
  <div class="szfoot">
    <div class="szbars">
      <span class="szcap">{m('szc', 'Müşteri başına maliyet')}</span>
      <p class="cubuk"><i>{m('szd', 'Önce')}</i><span class="bar once" /></p>
      <p class="cubuk"><i>{m('sze', 'Sonra')}</i><span class="bar sonra" /></p>
      <span class="szarrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></svg>{m('szf', 'aynı bütçe, daha çok müşteri')}</span>
    </div>
    <p class="szend" set:html={suz(m('szg', 'Yeni bütçe değil, <em>kaçan müşteri</em> geri geldi.'), ['em'])} />
  </div>
</div>

{/* ---- HUNİ (ada) ---- */}
<div class="blok" id="huni">
  <p class="kicker">{m('hs0', 'Senin rakamınla')}</p>
  <h2 set:html={suz(m('hs1', 'Peki <em>senin</em> huninden ne akıyor?'), ['em'])} />
  <p class="aciklama">{m('hs2', 'Kaydırıcıları kendi işine göre çek. Aşağıdaki sayı bizim iddiamız değil — senin girdiğin rakamların aritmetiği.')}</p>
  <div class="hgrid">
    <div class="girdiler">
      <label class="hrow"><span><b>{m('hs3', 'Ayda gelen talep')}</b><em id="hnV0">{fmt(V0, dil)}</em></span>
        <input type="range" id="hnR0" min="5" max="400" step="5" value={V0}
          aria-label={m('hs3', 'Ayda gelen talep')} /></label>
      <p class="ara">{m('hs4', 'Bunların kaçı yolda kalıyor?')}</p>
      {KAYDIRICI.map((k) => (
        <label class="hrow"><span><b>{k.ad}</b><em id={`hnV${k.id}`}>{k.deger}</em></span>
          <input type="range" id={`hnR${k.id}`} min="0" max="60" step="1" value={k.deger}
            aria-label={k.ad} /></label>
      ))}
      <p class="ara">{m('hsf', 'Bir işin sana ortalama değeri')}</p>
      <label class="hrow"><span><b>{m('hsg', 'Ortalama iş değeri')}</b><em id="hnV5">₺{fmt(DEG[IDX5], dil)}</em></span>
        <input type="range" id="hnR5" min="0" max="28" step="1" value={IDX5}
          aria-label={m('hsg', 'Ortalama iş değeri')} /></label>
    </div>
    <div class="cikti">
      <ol class="hakis" id="hnAkis">
        {kademe.map((v, i) => (
          <li><i>{hsEtiket[i]}</i><b>{fmt(v, dil)}</b>
            <span class="hbar"><u style={`width:${Math.max(2, v / V0 * 100)}%`} /></span></li>
        ))}
      </ol>
      <p class="hoz"><span>{m('hsb', 'Ayda elinden kaçan')}</span><b id="hnKacan">{fmt(kacan, dil)}</b>
        <span>{m('hsc', 'Yılda')}</span><b id="hnYil">{fmt(kacan * 12, dil)}</b></p>
      <p class="hpara"><span>{m('hsh', 'Ciro olarak, ayda')}</span><b id="hnPara">₺{fmt(kacan * DEG[IDX5], dil)}</b>
        <span>{m('hsi', 'yılda')}</span><b id="hnParaY">₺{fmt(kacan * DEG[IDX5] * 12, dil)}</b></p>
      <p class="hnot">{m('hsd', 'Bu bizim vaadimiz değil, senin rakamın. Ne kadarının kapanabileceğine keşifte birlikte bakarız.')}</p>
      <p class="orta"><a class="dugme" href={`${B}${dil === 'en' ? '/en' : ''}/#lead`}>{m('hse', 'Rakamlarımı konuşalım')}</a></p>
    </div>
  </div>
</div>

<script>
  /* TEL HİZALAMA ADASI — sadakat kuralı (21 Ağu): iki öğeyi birleştiren
     çizim göz kararı çizilmez. Uçlar kaynağın wire() künyesiyle ölçülür
     (kök 10553-10600): masaüstü düğüm kenar-ortası ↔ kart .42h/.58h,
     kontrol x orta nokta; mobil x dağılımı cx±(i-(n-1)/2)·sp,
     sp=min(34px, genişlik·.08), uçlarda +3px pay, fjoin düğümleri
     yalnız mobil (kaynak da öyleydi). Ölçüm rAF DIŞINDA: kurulum +
     resize 180ms (kaynak rt eşleniği) + fonts.ready — klasör telleri
     deseni. SSR'de d boş: kaynakta teller JS ürünüydü, JS'siz ziyaretçi
     kaynaktaki gibi telsiz görür. */
  const akis = document.querySelector('.akis3') as HTMLElement | null;
  const kartEl = akis?.querySelector('.ajan-kart') as HTMLElement | null;
  if (akis && kartEl) {
    const kollar = akis.querySelectorAll('.akol:not(.beyin)');
    const NS = 'http://www.w3.org/2000/svg';
    const yaz = (svg: SVGSVGElement, dler: string[]) =>
      svg.querySelectorAll('path').forEach((p, i) => p.setAttribute('d', dler[i % dler.length] || ''));
    const ciz = () => {
      const kr = kartEl.getBoundingClientRect();
      if (!kr.width) return;
      akis.querySelectorAll<SVGSVGElement>('svg.sus-tel').forEach(svg => {
        const sr = svg.getBoundingClientRect();
        if (!sr.width || !sr.height) return;
        const sol = svg.classList.contains('sol');
        const Y = (v: number) => ((v - sr.top) / sr.height * 400).toFixed(1);
        const ky = Y(kr.top + kr.height * (sol ? .42 : .58));
        yaz(svg, [...kollar[sol ? 0 : 1].querySelectorAll('.adugum')].map(n => {
          const q = n.getBoundingClientRect();
          const ny = Y(q.top + q.height / 2);
          return sol ? `M0,${ny} C50,${ny} 50,${ky} 100,${ky}`
            : `M0,${ky} C50,${ky} 50,${ny} 100,${ny}`;
        }));
      });
      akis.querySelectorAll<SVGSVGElement>('svg.sus-tel-m').forEach(svg => {
        const sr = svg.getBoundingClientRect();
        if (!sr.width || !sr.height) return;
        const sol = svg.classList.contains('sol');
        const kol = kollar[sol ? 0 : 1] as HTMLElement;
        const kolR = kol.getBoundingClientRect();
        const dugum = kol.querySelectorAll('.adugum').length || 1;
        const X = 400 / sr.width, Yv = 72 / sr.height;
        const sp = Math.min(34, sr.width * .08) * X;
        const kx = ((kr.left + kr.width / 2 - sr.left) * X).toFixed(1);
        /* uç y'ler: kaynak +3/-3 px payı (10566-10575) */
        const yKol = ((sol ? kolR.bottom + 3 : kolR.top - 3) - sr.top) * Yv;
        const yKrt = ((sol ? kr.top - 3 : kr.bottom + 3) - sr.top) * Yv;
        const m = ((yKol + yKrt) / 2).toFixed(1);
        const xler = [...Array(dugum)].map((_, i) => (200 + (i - (dugum - 1) / 2) * sp).toFixed(1));
        yaz(svg, xler.map(x => sol
          ? `M${x},${yKol.toFixed(1)} C${x},${m} ${kx},${m} ${kx},${yKrt.toFixed(1)}`
          : `M${kx},${yKrt.toFixed(1)} C${kx},${m} ${x},${m} ${x},${yKol.toFixed(1)}`));
        svg.querySelectorAll('.fjoin').forEach(c => c.remove());
        const dj = (cx: string, cy: number, r: number) => {
          const c = document.createElementNS(NS, 'circle');
          c.setAttribute('class', 'fjoin');
          c.setAttribute('cx', cx); c.setAttribute('cy', cy.toFixed(1));
          c.setAttribute('r', (r * X).toFixed(1));
          svg.appendChild(c);
        };
        /* kaynak (10570-10581): giriş uçları r2.6 + birleşme r3.2;
           çıkışta yalnız kart çıkış düğümü r3.2 */
        if (sol) { xler.forEach(x => dj(x, yKol, 2.6)); dj(kx, yKrt, 3.2); }
        else dj(kx, yKrt, 3.2);
      });
    };
    let rt: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(ciz, 180); });
    document.fonts?.ready?.then(ciz);
    ciz();
  }
</script>

<script>
  /* HUNİ ADASI (D2b) — kaynak canvas sahnesinin SVG eşleniği.
     Geometri kaynak formüllerinden BİREBİR (göz kararı yasak):
       katlar LY=[.10,.34,.58,.80] · LW=[.60,.44,.28,.15]  (kök 10681)
       duvar dolgusu k%2 ? .016 : .028 · kenar rgba(255,255,255,.13)
         (10704-10711)
       bağ çizgisi: kavşak t=(k+1)/4 → hedef x = W·.30 / W·.70,
         kesikli [3,4] (10716-10730)
       çıkan küme: phyllotaxis a=i·2.39996, r=√(i/n)·min(W,H)·.11,
         x=W/2+cos·r·1.6, y=LY[3]·H+H·.11+sin·r·.6, i%3 kızıl
         (10776-10782); adet 6+34 → 40 nokta, her biri kendi eşiğinde
         (--ti) açılır: kaynağın "küme büyür" davranışının eşleniği.
     ÖLÇÜM rAF DIŞINDA: kurulum + resize(180ms) + fonts.ready. Kaynak
     tanecikleri (rAF) TAŞINMADI — rota kararı; hareket scrub'dan.
     SSR'de SVG boş: kaynakta da canvas'ı JS çiziyordu. */
  const kap = document.getElementById('szWrap');
  const hsvg = kap?.querySelector('.sus-huni') as SVGSVGElement | null;
  if (kap && hsvg) {
    const LY = [.10, .34, .58, .80], LW = [.60, .44, .28, .15];
    const NS = 'http://www.w3.org/2000/svg';
    const kat = (t: number) => Math.min(2, Math.floor(t * 3));
    const genis = (t: number) => { const k = kat(t), u = t * 3 - k; return LW[k] + (LW[k + 1] - LW[k]) * u; };
    const yKon = (t: number) => { const k = kat(t), u = t * 3 - k; return LY[k] + (LY[k + 1] - LY[k]) * u; };
    const el = (ad: string, oz: Record<string, string>) => {
      const e = document.createElementNS(NS, ad);
      for (const k in oz) e.setAttribute(k, oz[k]);
      return e;
    };
    const ciz = () => {
      const r = kap.getBoundingClientRect();
      const W = Math.round(r.width), H = Math.round(r.height);
      if (!W || !H) return;
      hsvg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const g = el('g', { class: 'hgov' });
      /* huni duvarları (üç kat) */
      for (let k = 0; k < 3; k++) {
        const y1 = LY[k] * H, y2 = LY[k + 1] * H, w1 = LW[k] * W / 2, w2 = LW[k + 1] * W / 2;
        g.appendChild(el('path', {
          class: 'duvar', fill: k % 2 ? 'rgba(255,255,255,.016)' : 'rgba(255,255,255,.028)',
          d: `M${W / 2 - w1},${y1} L${W / 2 + w1},${y1} L${W / 2 + w2},${y2} L${W / 2 - w2},${y2} Z`,
        }));
        g.appendChild(el('path', { class: 'duvar-kenar', d: `M${W / 2 - w1},${y1} L${W / 2 - w2},${y2}` }));
        g.appendChild(el('path', { class: 'duvar-kenar', d: `M${W / 2 + w1},${y1} L${W / 2 + w2},${y2}` }));
      }
      /* kavşak bağları — kart k ile aynı --sm mührü */
      for (let k = 0; k < 4; k++) {
        const t = Math.min(.999, (k + 1) / 4);
        const y = yKon(t) * H, w = genis(t) * W / 2;
        const sol = k % 2 === 0, x = W / 2 + (sol ? -w : w);
        const hedef = sol ? Math.max(10, W * .30) : Math.min(W - 10, W * .70);
        const sm = (.52 + k * .055).toFixed(3);
        g.appendChild(el('path', {
          class: 'bag', d: `M${x},${y} L${hedef},${y}`,
          style: `--sm:${sm};--bk:${k};transform-origin:${x}px ${y}px`,
        }));
        g.appendChild(el('circle', { class: 'knokta', cx: String(x), cy: String(y), r: '3.2' }));
        g.appendChild(el('circle', { class: 'kglow', cx: String(x), cy: String(y), r: '5', style: `--sm:${sm}` }));
      }
      /* çıkan müşteri kümesi (phyllotaxis, kaynak 10776-10782) */
      const kume = el('g', { class: 'kume' });
      const ADET = 40, cy = LY[3] * H + H * .11;
      for (let i = 0; i < ADET; i++) {
        const a = i * 2.39996, rr = Math.sqrt(i / ADET) * Math.min(W, H) * .11;
        kume.appendChild(el('circle', {
          cx: (W / 2 + Math.cos(a) * rr * 1.6).toFixed(1),
          cy: (cy + Math.sin(a) * rr * .6).toFixed(1), r: '2.2',
          fill: i % 3 === 0 ? 'rgba(255,90,110,.92)' : 'rgba(255,255,255,.62)',
          style: `--ti:${Math.max(0, (i - 6) / 34).toFixed(3)};--ta:${i % 3 === 0 ? .92 : .62}`,
        }));
      }
      g.appendChild(kume);
      hsvg.replaceChildren(g);
    };
    let rt: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(ciz, 180); });
    document.fonts?.ready?.then(ciz);
    ciz();
  }
</script>

<script>
  /* ADA — yalnız huninin işi. Açılışta SIFIR yeniden yazım: iskelet ve
     varsayılan rakamlar derlemede aynı modülle basıldı; burada yalnız
     kaydırıcı dinlenir. JS koşmazsa sayfa varsayılanlarla anlamlı. */
  import { DEG, huni, fmt } from '../huni.mjs';
  const al = (id: string) => document.getElementById(id);
  const R = [0, 1, 2, 3, 4, 5].map(i => al('hnR' + i) as HTMLInputElement | null);
  if (R.every(Boolean)) {
    const dil = document.documentElement.lang === 'en' ? 'en' : 'tr';
    const akis = [...(al('hnAkis')?.children || [])] as HTMLElement[];
    const yaz = () => {
      const T = +R[0]!.value;
      const p = [1, 2, 3, 4].map(i => +R[i]!.value);
      const dg = DEG[+R[5]!.value] || 0;
      al('hnV0')!.textContent = fmt(T, dil);
      p.forEach((y, i) => al('hnV' + (i + 1))!.textContent = String(y));
      al('hnV5')!.textContent = '₺' + fmt(dg, dil);
      const { kademe, kacan } = huni(T, p);
      akis.forEach((li, i) => {
        const b = li.querySelector('b'), u = li.querySelector('u');
        if (b) b.textContent = fmt(kademe[i], dil);
        if (u) (u as HTMLElement).style.width = (T ? Math.max(2, kademe[i] / T * 100) : 0) + '%';
      });
      al('hnKacan')!.textContent = fmt(kacan, dil);
      al('hnYil')!.textContent = fmt(kacan * 12, dil);
      al('hnPara')!.textContent = '₺' + fmt(kacan * dg, dil);
      al('hnParaY')!.textContent = '₺' + fmt(kacan * dg * 12, dil);
    };
    R.forEach(r => r!.addEventListener('input', yaz));
  }
</script>

<style>
  .ust-etiket { color: var(--tx3); font-family: ui-monospace, monospace;
    font-size: .78rem; letter-spacing: .08em; margin-bottom: 6px; }
  .blok { margin-top: 46px; }
  .kicker { color: var(--red-soft); font-family: ui-monospace, monospace;
    font-size: .78rem; letter-spacing: .08em; margin-bottom: 6px; }
  .blok h2 { font-size: 1.35rem; margin: 0 0 10px; }
  .aciklama { color: var(--tx2); font-size: .95rem; max-width: 60ch; }
  .kapanis { margin-top: 18px; font-size: 1.02rem; }
  .orta { margin-top: 18px; text-align: center; }

  .akis3 { display: grid; grid-template-columns: 1fr 44px 1.3fr 44px 1fr; gap: 6px;
    margin-top: 26px; }
  /* AKIŞ SCRUB SÜRÜCÜSÜ (A3-D1) — kaynak: ST scrub .5, top 86%→bottom
     90% (kök 12461) + reveal(p) eşikleri (10632-10639, markup'ta --fe
     olarak BİREBİR basılı). Sürücü kaydırma (IO değil): anonim view()
     tek animasyon --fyt'yi 0→1 sürer, hâller eşikten türer (SurecGovde
     --yt deseninin eşi). Aralık cover 5%→60%: kaynağın "blok tam
     görünürken tamamlanır" hedefinin (Enes ayarı, 12456-2460) view
     eşleniği. TABAN = TAMAMLANMIŞ (--fyt initial 1): desteksiz
     tarayıcı ve reduced-motion tam hâli görür — kaynak REDUCE'da
     reveal(1) çağırıyordu, birebir. Pencere ×20 (~0.05p): kaynağın
     sınıf+.45s transition yumuşamasının scrub eşleniği (bilinçli
     eşleme, ani sınıf geçişi değil). */
  @property --fyt { syntax: '<number>'; inherits: true; initial-value: 1; }
  @supports (animation-timeline: view()) {
    .akis3 { animation: fyt-surus linear both; animation-timeline: view();
      animation-range: cover 5% cover 60%; }
  }
  @keyframes fyt-surus { from { --fyt: 0; } to { --fyt: 1; } }
  .adugum, .ajan-kart, .tel-yak {
    --fp: clamp(0, (var(--fyt, 1) - var(--fe, 0)) * 20, 1); }
  /* düğüm: kaynak .fnode kapalı hâli (1336-1339): opacity 0 +
     translateY(10px) scale(.96) → on'da 1/none. (D1'in ".fln .55→1"
     künyesi YANLIŞ bileşendendi — .fln 701 başka sahnenin düğümü;
     21 Ağu denetimi düzeltti.) */
  .adugum { opacity: var(--fp);
    transform: translateY(calc((1 - var(--fp)) * 10px))
      scale(calc(.96 + .04 * var(--fp))); }
  /* beyin: kaynak .fbrain kapalı opacity 0 + scale(.9) → açık 1/1 (1356-1359) */
  .ajan-kart { opacity: var(--fp); transform: scale(calc(.9 + .1 * var(--fp))); }
  /* tel yakma katmanı: kaynak .fwire gri .13 → .lit kızıl .55 (1331-1332);
     gri taban .tel sabit durur, kızıl kopya eşikle açılır */
  .sus-tel .tel-yak, .sus-tel-m .tel-yak { fill: none; stroke: rgba(239,35,60,.55);
    stroke-width: 1.4; vector-effect: non-scaling-stroke; opacity: var(--fp); }
  @media (prefers-reduced-motion: reduce) { .akis3 { animation: none; } }
  /* Teller SÜS (.sus- sözleşmesi): içerik üç kolonda eksiksiz; mobilde
     ve reduced-motion'da süs söner, kimse bilgi kaybetmez. */
  /* overflow:visible kaynak fsvg künyesi (1330) — uç daireleri ve +3px
     taşma payı şerit dışına çizilebilir. */
  .sus-tel { width: 100%; margin-top: 34px; height: calc(100% - 34px);
    overflow: visible; }
  .sus-tel .tel { fill: none; stroke: var(--line2); stroke-width: 1.2;
    vector-effect: non-scaling-stroke; }
  .sus-tel .tel-iz { fill: none; stroke: var(--red-soft); stroke-width: 1.6;
    vector-effect: non-scaling-stroke; opacity: .9;
    stroke-dasharray: .07 .93; stroke-dashoffset: 1.07;
    animation: ak-iz 3.4s linear infinite; }
  /* Dört tel aynı anda atmasın — sıra hissi; sağ şerit yarım vuruş geç
     (paket ajandan çıkıyormuş gibi). */
  .sus-tel .iz1 { animation-delay: .85s; }
  .sus-tel .iz2 { animation-delay: 1.7s; }
  .sus-tel .iz3 { animation-delay: 2.55s; }
  .sus-tel.sag .tel-iz { animation-delay: .42s; }
  .sus-tel.sag .iz1 { animation-delay: 1.27s; }
  .sus-tel.sag .iz2 { animation-delay: 2.12s; }
  .sus-tel.sag .iz3 { animation-delay: 2.97s; }
  @keyframes ak-iz { to { stroke-dashoffset: .07; } }
  /* Mobil teller: dikey yelpaze (eski flowKur'un dikey modunun yerlisi).
     Masaustunde gizli; mobilde kolonlarin arasina girer. */
  .sus-tel-m { display: none; }
  @media (max-width: 700px) {
    .akis3 { grid-template-columns: 1fr; gap: 10px; }
    .sus-tel { display: none; }
    .sus-tel-m { display: block; width: min(100%, 340px);
      margin: 0 auto; height: 56px; overflow: visible; }
    /* fjoin düğüm daireleri: kaynak YALNIZ mobil telde basıyordu
       (10570-10581, r 2.6/3.2; fill/opacity 1383). Kaynaktaki
       drop-shadow parlaması H14 gereği mobilde YOK (belgeli sapma). */
    .sus-tel-m .fjoin { fill: var(--red); opacity: .9; }
    .sus-tel-m .tel { fill: none; stroke: var(--line2); stroke-width: 1.2;
      vector-effect: non-scaling-stroke; }
    .sus-tel-m .tel-iz { fill: none; stroke: var(--red-soft); stroke-width: 1.6;
      vector-effect: non-scaling-stroke; opacity: .9;
      stroke-dasharray: .12 .88; stroke-dashoffset: 1.12;
      animation: ak-iz-m 2.6s linear infinite; }
    .sus-tel-m .iz1 { animation-delay: .65s; }
    .sus-tel-m .iz2 { animation-delay: 1.3s; }
    .sus-tel-m .iz3 { animation-delay: 1.95s; }
    .sus-tel-m.sag .tel-iz { animation-delay: .32s; }
    .sus-tel-m.sag .iz1 { animation-delay: .97s; }
    .sus-tel-m.sag .iz2 { animation-delay: 1.62s; }
    .sus-tel-m.sag .iz3 { animation-delay: 2.27s; }
  }
  @keyframes ak-iz-m { to { stroke-dashoffset: .12; } }
  @media (prefers-reduced-motion: reduce) {
    .sus-tel .tel-iz, .sus-tel-m .tel-iz { animation: none; opacity: 0; }
  }
  /* kaynak mobil çizelgesi (1403-1418, kırılım 900 birebir): düğüm ve
     ikon büyür, beyin dolgusu daralır, "Aktif" rozeti görünür olur */
  @media (max-width: 900px) {
    .adugum { padding: 15px; border-radius: 16px; gap: 12px; }
    .adugum .ni { width: 42px; height: 42px; border-radius: 12px; }
    .adugum .ni :global(svg) { width: 18px; height: 18px; }
    .nt b { font-size: .95rem; white-space: normal; }
    .nt span { font-size: .72rem; }
    .nd { width: 8px; height: 8px; }
    .ajan-kart { padding: 18px 16px 16px; border-radius: 18px; }
    /* .ajan-ad öneki: taban display:none dosyada SONRA geldiğinden
       özgüllükle kazanılır (ölçümle yakalandı) */
    .ajan-ad .fbadge { display: inline-flex; align-items: center; gap: 6px; margin-left: auto;
      font-family: ui-monospace, monospace; font-size: 9px; letter-spacing: .16em;
      text-transform: uppercase; color: var(--red-soft);
      border: 1px solid rgba(239, 35, 60, .4); border-radius: 999px;
      padding: 4px 9px; background: rgba(239, 35, 60, .08); }
    .fbadge i { width: 6px; height: 6px; border-radius: 50%; background: var(--red);
      font-style: normal; }
    .ajan-kart li { padding: 11px 12px; font-size: .84rem; border-radius: 12px; gap: 11px; }
    .fsi { width: 18px; height: 18px; }
    .fsi :global(svg) { width: 10px; height: 10px; }
    .ajan-kart li em { font-size: 10px; }
  }

  .akbas { color: var(--tx3); font-size: .78rem; font-family: ui-monospace, monospace;
    letter-spacing: .08em; margin-bottom: 8px; }
  /* ---- DÜĞÜM KOMPOZİSYONU — kaynak .fnode 1336-1354 birebir.
     HOT DALGASI: kaynakta rAF tick'i 1.5 adım/sn ile düğümleri sırayla
     'hot' yapıyordu (10622-10625; çıkış +2 faz). Eşlenik: --hp custom
     property dalgası (period 4/1.5=2.667s, pencere .667s), renkler
     color-mix ile taban↔hot arası karışır (kaynak .6s transition'ının
     rampası keyframe'de). Desteksiz tarayıcı --hp=0 taban hâli görür.
     Gölgeli hot vurguları H14 gereği yalnız masaüstü bloğunda. */
  @property --hp { syntax: '<number>'; inherits: true; initial-value: 0; }
  @keyframes hp-dalga { 0% { --hp: 0; } 2% { --hp: 1; } 20% { --hp: 1; }
    27%, 100% { --hp: 0; } }
  .adugum { display: flex; align-items: center; gap: 11px; padding: 12px 14px;
    margin-bottom: 11px; border-radius: 14px;
    border: 1px solid color-mix(in srgb, rgba(239, 35, 60, .5) calc(var(--hp, 0) * 100%), var(--line));
    background: color-mix(in srgb, #161010 calc(var(--hp, 0) * 100%), #101010);
    animation: hp-dalga 2.667s linear infinite;
    animation-delay: calc(var(--hi, 0) * .667s); }
  .adugum .ni { width: 32px; height: 32px; border-radius: 9px; display: grid;
    place-items: center; flex-shrink: 0;
    background: color-mix(in srgb, var(--red-dim, rgba(239, 35, 60, .15)) calc(var(--hp, 0) * 100%), rgba(255, 255, 255, .05));
    border: 1px solid color-mix(in srgb, rgba(239, 35, 60, .45) calc(var(--hp, 0) * 100%), var(--line));
    color: color-mix(in srgb, var(--red-soft) calc(var(--hp, 0) * 100%), var(--tx3)); }
  /* :global — Ikon.astro'nun svg'si bu bileşenin scope damgasını
     taşımaz; düz seçici eşleşmez (gerçek Chrome ölçümüyle yakalandı) */
  .adugum .ni :global(svg) { width: 15px; height: 15px; }
  .nt { flex: 1; min-width: 0; }
  .nt b { display: block; font-size: .83rem; font-weight: 600; letter-spacing: -.02em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nt span { font-size: .68rem; color: var(--tx4); font-family: ui-monospace, monospace;
    letter-spacing: .08em; }
  .nd { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
    background: color-mix(in srgb, var(--red) calc(var(--hp, 0) * 100%), var(--line2)); }

  /* ---- BEYİN — kaynak .fbrain 1356-1381 birebir (Manrope→gövde,
     JetBrains→ui-monospace: F1 sözleşmesi). */
  .ajan-kart { border: 1px solid rgba(239, 35, 60, .34); border-radius: 20px;
    background: linear-gradient(180deg, rgba(239, 35, 60, .1), rgba(255, 255, 255, .02));
    padding: 20px; }
  .ajan-ad { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; }
  .bi { width: 42px; height: 42px; border-radius: 12px; display: grid;
    place-items: center; background: var(--red); color: #fff; flex-shrink: 0; }
  .bi :global(svg) { width: 20px; height: 20px; }
  .bt { min-width: 0; }
  .bt b { display: block; font-size: 1rem; font-weight: 700; letter-spacing: -.03em; }
  .bt span { font-family: ui-monospace, monospace; font-size: 9.5px;
    letter-spacing: .16em; text-transform: uppercase; color: var(--tx4); }
  /* rozet kaynakta YALNIZ MOBİL (1384: taban gizli, 1410: ≤900 açık);
     noktası kaynakta ping2 TANIMSIZ keyframe'deydi → SABİT basılır;
     glow'u H14 gereği yok (kaynakta vardı, belgeli sapma). */
  .fbadge { display: none; }

  /* ---- ADIM SATIRLARI — kaynak .fstep 1370-1381; tik ✓ karakteri
     değil kaynağın IC.check SVG'si (F1c). DALGA: kaynak tick'i 2.2
     adım/sn, döngü n+2=7 birim (10626-10627) → --fsp 0→7 (3.18s),
     satır i eşiği (i+1); rampa ×1.5 ≈ kaynağın .4s transition'ı.
     --fsp initial 7: desteksiz tarayıcı + reduced TAMAMLANMIŞ görür. */
  @property --fsp { syntax: '<number>'; inherits: true; initial-value: 7; }
  @keyframes fsp-dalga { 0% { --fsp: 0; } 100% { --fsp: 7; } }
  .ajan-kart ol { list-style: none; margin: 0; padding: 0; display: flex;
    flex-direction: column; gap: 7px;
    animation: fsp-dalga 3.18s linear infinite; }
  .ajan-kart li { --on: clamp(0, (var(--fsp, 7) - 1 - var(--fi, 0)) * 1.5, 1);
    display: flex; align-items: center; gap: 10px; padding: 8px 11px;
    border-radius: 10px; font-size: .76rem;
    background: color-mix(in srgb, rgba(239, 35, 60, .08) calc(var(--on) * 100%), rgba(255, 255, 255, .03));
    border: 1px solid color-mix(in srgb, rgba(239, 35, 60, .3) calc(var(--on) * 100%), transparent);
    color: color-mix(in srgb, var(--tx) calc(var(--on) * 100%), var(--tx3)); }
  .fsi { width: 16px; height: 16px; border-radius: 50%; flex-shrink: 0;
    display: grid; place-items: center; font-style: normal;
    border: 1px solid color-mix(in srgb, var(--red) calc(var(--on) * 100%), var(--line2));
    background: color-mix(in srgb, var(--red-dim, rgba(239, 35, 60, .15)) calc(var(--on) * 100%), transparent); }
  .fsi :global(svg) { width: 9px; height: 9px; color: var(--red-soft);
    opacity: var(--on); }
  .ajan-kart li span { min-width: 0; }
  .ajan-kart li em { margin-left: auto; font-style: normal;
    font-family: ui-monospace, monospace; font-size: 9px;
    color: color-mix(in srgb, var(--red-soft) calc(var(--on) * 100%), var(--tx4)); }

  /* gölgeli vurgular yalnız masaüstü (H14): hot kutu/nokta glow'u,
     beyin ikonunun brainPulse'u (1362-1365 birebir) */
  @media (min-width: 901px) {
    .adugum { box-shadow: 0 0 26px -8px color-mix(in srgb, var(--red-glow, rgba(239, 35, 60, .5)) calc(var(--hp, 0) * 100%), transparent); }
    .nd { box-shadow: 0 0 9px color-mix(in srgb, var(--red-glow, rgba(239, 35, 60, .5)) calc(var(--hp, 0) * 100%), transparent); }
    .bi { box-shadow: 0 0 24px -4px var(--red-glow, rgba(239, 35, 60, .5));
