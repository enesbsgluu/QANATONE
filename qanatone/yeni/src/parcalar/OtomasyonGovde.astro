      animation-timeline: view(); animation-range: entry 20% entry 90%; }
    .sus-mfg { opacity: 0; transform: translateY(10px); animation: oto-gel linear both;
      animation-timeline: view(); animation-range: entry 10% entry 60%; }
    .sus-gnrail { transform: scaleY(0); animation: oto-ray linear both;
      animation-timeline: view(); animation-range: entry 5% entry 95%; }
    .sus-gnrow { opacity: 0; transform: translateY(14px); animation: oto-gel linear both;
      animation-timeline: view(); animation-range: entry 10% entry 60%; }
    .sus-gnrow::before { border-color: rgba(255, 255, 255, .2); box-shadow: none;
      animation: oto-nokta linear both;
      animation-timeline: view(); animation-range: entry 20% entry 70%; }
  }
  @keyframes oto-cizgi { to { transform: scaleX(1); } }
  @keyframes oto-ray { to { transform: scaleY(1); } }
  @keyframes oto-gel { to { opacity: 1; transform: none; } }
  @keyframes oto-nokta { to { border-color: var(--red); box-shadow: 0 0 14px -2px var(--red-glow); } }
  /* H11 dersi: animasyon sözde öğeye taşınınca DURDURAN liste de taşınır */
  @media (prefers-reduced-motion: reduce) {
    .sus-mfcizgi, .sus-mfg, .sus-gnrail, .sus-gnrow, .sus-gnrow::before { animation: none; }
    .sus-mfcizgi, .sus-gnrail { transform: none; }
    .sus-mfg, .sus-gnrow { opacity: 1; transform: none; }
    .sus-gnrow::before { border-color: var(--red); box-shadow: 0 0 14px -2px var(--red-glow); }
  }

  /* ==== SIZINTI — kaynak kompozisyonu (21 Ağu, D2b). Kutu .szstage
     2804-2807 (max-height pin kilidi içindi — pin'siz ALINMADI, D2c;
     gölge H14 masaüstü). Fontlar F1: Manrope→gövde 700, JetBrains→
     ui-monospace. ==== */
  /* PIN (sokum turu): ray 100vh + 220vh (kaynak +=innerHeight*2.2), sahne
     yapisik, ust bosluk 22px; kaynak max-height (2806) kilit icindi, geri
     geldi. Ray adli view cizelgesi tasir; sahne onu surer. */
  .sz-ray { position: relative; height: 320vh; view-timeline: --sz block; }
  .szstage { position: sticky; top: 22px; max-height: calc(100vh - 44px);
    border: 1px solid var(--line); border-radius: 20px; overflow: hidden;
    display: flex; flex-direction: column;
    background: linear-gradient(168deg, #131316, #0b0b0d); }
  .sus-sizinti { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
  .szhd { padding: clamp(20px, 2.6vw, 36px) clamp(20px, 2.6vw, 40px) clamp(12px, 1.6vw, 22px);
    border-bottom: 1px solid var(--line); display: flex; align-items: flex-end;
    justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .szhd h2 { margin: 0; font-weight: 700; letter-spacing: -.03em;
    font-size: clamp(1.24rem, 2.5vw, 2.1rem); line-height: 1.1; color: #fff;
    text-wrap: balance; }
  /* :global — set:html içeriği scope damgası taşımaz (akış dersi) */
  .szhd h2 :global(em) { font-style: normal; color: var(--red-soft); }
  .szk { display: inline-flex; align-items: center; gap: 8px;
    font-family:var(--f-tek); font-size: clamp(9px, .76vw, 10.6px);
    letter-spacing: .16em; text-transform: uppercase; color: var(--red-soft);
    margin: 0 0 10px; }
  .szk i { width: 6px; height: 6px; border-radius: 50%; background: var(--red); }
  .szbudget { flex: none; display: flex; flex-direction: column; gap: 3px; text-align: right; }
  .szbudget b { font-weight: 700; color: #fff; font-size: clamp(.98rem, 1.3vw, 1.24rem);
    letter-spacing: -.02em; }
  .szbudget i { font-style: normal; color: var(--tx4); font-family:var(--f-tek);
    font-size: clamp(8.6px, .74vw, 10.2px); letter-spacing: .12em; text-transform: uppercase; }
  /* çipler — kaynak .szch 2827-2835; on renkleri (kızıl kenar + beyaz
     metin) scrub'dan color-mix'le */
  .szchans { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
    padding: clamp(14px, 1.8vw, 24px) clamp(20px, 2.6vw, 40px) 0; margin: 0; }
  .cip { padding: 7px 15px; border-radius: 999px; background: rgba(255, 255, 255, .04);
    font-size: clamp(10.4px, .9vw, 12.2px); font-weight: 500;
    border: 1px solid color-mix(in srgb, rgba(239, 35, 60, .34) calc(var(--sp, 1) * 100%), var(--line2));
    color: color-mix(in srgb, #fff calc(var(--sp, 1) * 100%), var(--tx3)); }
  /* huni sahnesi — kaynak .szwrap 2837-2838; SVG'yi ADA çizer (kaynak
     canvas formülleri), SSR boş */
  .szwrap { position: relative; flex: 0 0 auto;
    height: clamp(250px, calc(100vh - 470px), 560px); }
  .sus-huni { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sus-huni :global(.hgov) { opacity: clamp(0, var(--szt, 1) * 10, 1); }
  .sus-huni :global(.duvar-kenar) { fill: none; stroke: rgba(255, 255, 255, .13);
    stroke-width: 1.2; }
  .sus-huni :global(.bag), .sus-huni :global(.knokta), .sus-huni :global(.kglow) {
    --kp: clamp(0, (var(--szt, 1) - var(--sm, 2)) * 18, 1); }
  /* bağ: kesikli [3,4], beyaz .2 → tıpalanınca kızıl .55 (10722);
     uzunluk scrub'ı kaynakta lineTo kısmıydı — burada scaleX (origin
     kavşak, ada basar; bilinçli mekanizma eşlemesi, kesik deseni
     .10p'lik pencerede esner) */
  .sus-huni :global(.bag) { fill: none; stroke-width: 1; stroke-dasharray: 3 4;
    stroke: color-mix(in srgb, rgba(239, 35, 60, .55) calc(var(--kp) * 100%), rgba(255, 255, 255, .2));
    transform: scaleX(clamp(0, (var(--szt, 1) - .22 - var(--bk, 0) * .05) * 10, 1)); }
  .sus-huni :global(.knokta) { fill: rgba(255, 255, 255, .24); }
  .sus-huni :global(.kglow) { fill: var(--red); opacity: var(--kp); }
  /* çıkan küme: nokta i eşiği --ti=(i-6)/34; --ck iki pencereli çıkış
     eğrisi (10746) .szstage'de */
  .sus-huni :global(.kume circle) {
    opacity: calc(var(--ta, .6) * clamp(0, (var(--ck, 1) - var(--ti, 0)) * 40, 1)); }
  /* yan kartlar — kaynak .szside/.szleak/.szfix 2842-2867 birebir */
  .szside { position: absolute; top: 0; bottom: 0; width: min(30%, 270px); display: flex;
    flex-direction: column; justify-content: center; gap: clamp(26px, 4vw, 64px);
    pointer-events: none; padding: 6% 0; }
  .szside.left { left: clamp(12px, 1.8vw, 26px); align-items: flex-start; text-align: left; }
  .szside.right { right: clamp(12px, 1.8vw, 26px); align-items: flex-end; text-align: right; }
  .szleak { display: flex; flex-direction: column; gap: 7px; }
  .szlt { display: flex; flex-direction: column; gap: 3px; }
  .szlt b { font-weight: 700; letter-spacing: -.02em; font-size: clamp(12.6px, 1.26vw, 17px);
    line-height: 1.2; color: color-mix(in srgb, var(--tx3) calc(var(--mp, 0) * 100%), #fff);
    text-decoration: line-through; text-decoration-thickness: 2px;
    text-decoration-color: rgba(239, 35, 60, calc(var(--mp, 0) * .7)); }
  .szlt i { font-style: normal; color: var(--tx4); font-size: clamp(10.2px, .9vw, 12px);
    line-height: 1.35; }
  .szfix { display: inline-flex; align-items: center; gap: 7px; padding: 5px 11px;
    border-radius: 999px; background: rgba(239, 35, 60, .12);
    border: 1px solid rgba(239, 35, 60, .4); color: var(--red-soft);
    font-family:var(--f-tek); font-size: clamp(9.2px, .8vw, 10.8px);
    letter-spacing: .04em; white-space: nowrap;
    opacity: var(--mp, 0); transform: scale(calc(.9 + .1 * var(--mp, 0))); }
  .szfix s { width: 12px; height: 12px; border-radius: 50%; background: var(--red);
    flex: none; position: relative; text-decoration: none; }
  .szfix s::after { content: ''; position: absolute; left: 3.4px; top: 5px; width: 3.6px;
    height: 1.8px; border-left: 1.4px solid #fff; border-bottom: 1.4px solid #fff;
    transform: rotate(-45deg); }
  /* "kalan müşteri" + beat rozeti — kaynak 2887-2898; beat penceresi
     p .435-.522 (10792), rampa ×22 ≈ kaynağın .4s geçişi */
  .szout { position: absolute; left: 50%; bottom: clamp(8px, 1.2vw, 18px);
    transform: translateX(-50%); font-family:var(--f-tek);
    font-size: clamp(9px, .8vw, 10.8px); letter-spacing: .14em; text-transform: uppercase;
    color: var(--tx3); opacity: clamp(0, (var(--szt, 1) - .30) * 20, 1); }
  .szbeat { position: absolute; left: 50%; top: 50%;
    --bp: calc(clamp(0, (var(--szt, 1) - .435) * 22, 1) * clamp(0, (.522 - var(--szt, 1)) * 22, 1));
    transform: translate(-50%, -50%) scale(calc(.96 + .04 * var(--bp)));
    padding: 12px 26px; border-radius: 999px; background: rgba(10, 10, 11, .9);
    border: 1px solid rgba(239, 35, 60, .45); font-weight: 700; letter-spacing: -.02em;
    font-size: clamp(1rem, 1.5vw, 1.34rem); color: #fff; white-space: nowrap; z-index: 3;
    opacity: var(--bp); }
  /* aşamalar — kaynak .szstages/.szst/.szsb 2870-2885 birebir:
     huninin ÜSTÜNDE dikey overlay, mono başlık + altında oran çubuğu */
  .szstages { position: absolute; left: 50%; top: 0; bottom: 0;
    transform: translateX(-50%); width: min(38%, 300px); display: flex;
    flex-direction: column; justify-content: flex-start; pointer-events: none;
    padding-top: 6%; }
  .szst { display: flex; flex-direction: column; align-items: center; gap: 5px;
    height: 24%; justify-content: flex-start;
    opacity: var(--sp, 1); transform: translateY(calc((1 - var(--sp, 1)) * 6px)); }
  .szst b { font-family:var(--f-tek); font-size: clamp(9px, .8vw, 10.8px);
    letter-spacing: .14em; text-transform: uppercase; color: var(--tx3);
    font-weight: 500; }
  .szsb { width: min(70%, 150px); height: 4px; border-radius: 3px;
    background: rgba(255, 255, 255, .08); overflow: hidden; }
  .szsb i { display: block; position: relative; height: 100%; border-radius: 3px;
    background: linear-gradient(90deg, rgba(255, 255, 255, .42), rgba(255, 255, 255, .16));
    width: calc(var(--sp, 1) * var(--w, 60%)); }
  /* done kızıllaşması: kaynak .szstage.done .szsb i (2885), eşik p>.84 */
  .szsb i::after { content: ''; position: absolute; inset: 0; border-radius: 3px;
    background: linear-gradient(90deg, var(--red), var(--red-soft));
    opacity: clamp(0, (var(--szt, 1) - .84) * 18, 1); }
  /* alt şerit — kaynak .szfoot/.szbars/.szbar/.szarrow/.szend
     2908-2931 birebir (çubuk dolumu width yerine scaleX: düzen
     tetiklemez, oranlar aynı — bilinçli mekanizma eşlemesi) */
  .szfoot { border-top: 1px solid var(--line);
    padding: clamp(16px, 2vw, 28px) clamp(20px, 2.6vw, 40px);
    /* 4 Eyl (olc-tasma, EN): `1fr auto` — auto sutun EN metninde 653 px'e
       buyuyup cubuk sutununu 35 px'e sikistiriyordu, etiketler tasiyordu.
       Ikinci sutun kapanis cumlesinin kendi tavani (300 px) ile sinirli. */
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(16px, 2.4vw, 36px); align-items: center; }
  .szbars { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  .szcap { font-family:var(--f-tek); font-size: clamp(8.4px, .72vw, 10px);
    letter-spacing: .12em; text-transform: uppercase; color: var(--tx4); }
  .cubuk { display: grid; grid-template-columns: clamp(46px, 5vw, 64px) 1fr;
    gap: 12px; align-items: center; margin: 0; }
  .cubuk i { font-style: normal; color: var(--tx3); font-size: clamp(9.6px, .84vw, 11.4px); }
  .bar { position: relative; height: 10px; border-radius: 5px;
    background: rgba(255, 255, 255, .06); overflow: hidden; }
  .bar::after { content: ''; position: absolute; inset: 0; border-radius: 5px;
    transform-origin: left; }
  .bar.once::after {
    background: linear-gradient(90deg, rgba(255, 255, 255, .3), rgba(255, 255, 255, .12));
    transform: scaleX(clamp(0, (var(--szt, 1) - .28) / .15, 1)); }
  /* Sonra çubuğu kaynakta %46'da durur (10795: ×46) — genişlik oranı
     kabın .46'sı, dolum scaleX'i kendi içinde tam */
  .bar.sonra::after { width: 46%;
    background: linear-gradient(90deg, var(--red), var(--red-soft));
    transform: scaleX(clamp(0, (var(--szt, 1) - .66) / .24, 1)); }
  .szarrow { display: flex; align-items: center; gap: 8px; color: var(--red-soft);
    font-size: clamp(9.6px, .84vw, 11.4px);
    opacity: clamp(0, (var(--szt, 1) - .84) * 18, 1); }
  .szarrow svg { width: 15px; height: 15px; flex: none; }
  .szend { flex: none; max-width: min(100%, 300px); font-weight: 700;
    letter-spacing: -.025em; font-size: clamp(1.02rem, 1.6vw, 1.4rem); line-height: 1.22;
    color: #fff; text-wrap: balance; margin: 0;
    opacity: clamp(0, (var(--szt, 1) - .84) * 18, 1);
    transform: translateY(calc((1 - clamp(0, (var(--szt, 1) - .84) * 18, 1)) * 8px)); }
  .szend :global(em) { font-style: normal; color: var(--red-soft); }

  /* SIZINTI SCRUB SÜRÜCÜSÜ (A3-D2) — kaynak: ST PIN+scrub .5, +=2.2vh
     (kök 12467-12478) + szDraw DOM eşikleri (10785-10795, markup'ta
     --se/--sm olarak BİREBİR). Sürücü anonim view() --szt (akışla aynı
     desen); PIN bu adımda bilinçli yok (markup yorumunda gerekçe) —
     aralık cover 5%→90%: pin'in 2.2vh ilerleme payının akan eşleniği.
     TABAN=TAMAMLANMIŞ (--szt initial 1): desteksiz + reduced tam hâli
     görür (kaynak RDC'de P=1 render, 10806 — birebir; tamamlanmış
     hâlde damlalar SÖNÜK çünkü mühürler kapalı, anlatı bu).
     Kapalı/açık görseller kaynak değerleri: çip 0+7px→1 (szch 2829),
     kart 0+10px→1 (szleak 2848), mühürde başlık üstü çizili kızıl
     (sealed 2855; çizgi hep var, RENGİ saydam→kızıl — calc'lanabilir
     tek yol) + çözüm rozeti 0+scale(.9)→1 (szfix 2860). Çubuk dolumu
     kaynakta width yazımıydı (2917) — burada ::after scaleX (düzen
     tetiklemez; bilinçli mekanizma eşlemesi, oranlar aynı). */
  @property --szt { syntax: '<number>'; inherits: true; initial-value: 1; }
  @supports (animation-timeline: view()) {
    .sz-surus { animation: szt-surus linear both; animation-timeline: --sz;
      animation-range: contain 0% contain 100%; }
  }
  @keyframes szt-surus { from { --szt: 0; } to { --szt: 1; } }
  .cip, .szleak, .szst {
    --sp: clamp(0, (var(--szt, 1) - var(--se, 0)) * 20, 1); }
  .cip { opacity: var(--sp); transform: translateY(calc((1 - var(--sp)) * 7px)); }
  .szleak { opacity: var(--sp); transform: translateY(calc((1 - var(--sp)) * 10px)); }
  /* mühür penceresi (tıpa): kart k → .52+.055k; SVG kavşak eşleniği
     --sm ada tarafından aynı değerlerle basılır */
  .szleak { --mp: clamp(0, (var(--szt, 1) - var(--sm, 0)) * 18, 1); }
  /* çıkan küme eğrisi — kaynak 10746 birebir: iki pencereli toplam */
  .szstage { --ck: calc(clamp(0, (var(--szt, 1) - .08) / .26, 1) * .38
    + clamp(0, (var(--szt, 1) - .60) / .34, 1) * .62); }
  @media (prefers-reduced-motion: reduce) { .sz-surus { animation: none; } }
  /* kaynak sızıntı mobil çizelgesi (2900-2907 + 2933-2937) */
  @media (max-width: 900px) {
    .szwrap { height: clamp(300px, calc(100vh - 430px), 480px); }
    .szside { width: 40%; gap: 18px; padding: 4% 0; }
    .szlt b { font-size: 12px; }
    .szlt i { display: none; }
    .szfix { font-size: 8.8px; padding: 4px 8px; }
    .szstages { width: 34%; }
    .szst b { font-size: 8.4px; letter-spacing: .08em; }
  }
  @media (max-width: 860px) {
    .szhd { flex-direction: column; align-items: flex-start; }
    .szbudget { text-align: left; }
    .szfoot { grid-template-columns: 1fr; }
    .szend { max-width: 100%; }
  }
  /* gölge H14: kaynak .szstage gölgesi (2807) yalnız masaüstünde */
  @media (min-width: 901px) {
    .szstage { box-shadow: 0 30px 80px -50px rgba(0, 0, 0, .9); }
    .szbeat { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
    .bar.sonra::after { box-shadow: 0 0 22px -8px var(--red-glow, rgba(239, 35, 60, .5)); }
    .szk i { box-shadow: 0 0 10px var(--red-glow, rgba(239, 35, 60, .5)); }
  }

  /* ===== HESAPLAYICI — KAYNAĞIN STİLİ (TUR 1, 4 Eyl 2026) =====
     Kök index.html 2915-2995'ten birebir; iki bilinçli sapma:
     (a) 'JetBrains Mono' -> var(--f-tek), Manrope -> devralınan aile
         (anayasa istisna 1, ölçüler kaynaktan);
     (b) düğme kaynakta .btn.btn-p, burada kabuk düğmesi .dugme — hizalama
         kuralı (align-self:flex-start) taşındı. */
  .hssec { margin-top: clamp(20px, 2.6vw, 38px); }
  .hsbox { border: 1px solid var(--line); border-radius: 20px; overflow: hidden;
    background: linear-gradient(168deg, rgba(239, 35, 60, .05), rgba(255, 255, 255, .015)); }
  .hshd { padding: clamp(20px, 2.6vw, 36px) clamp(20px, 2.6vw, 40px) clamp(14px, 1.8vw, 24px);
    border-bottom: 1px solid var(--line); }
  .hsk { display: inline-flex; align-items: center; gap: 8px; font-family: var(--f-tek);
    font-size: clamp(9px, .76vw, 10.6px); letter-spacing: .16em; text-transform: uppercase;
    color: var(--red-soft); margin-bottom: 10px; }
  .hsk i { width: 6px; height: 6px; border-radius: 50%; background: var(--red);
    box-shadow: 0 0 10px var(--red-glow); }
  .hshd h2 { margin: 0; font-weight: 700; letter-spacing: -.03em;
    font-size: clamp(1.24rem, 2.5vw, 2.1rem); line-height: 1.12; color: #fff; text-wrap: balance; }
  .hshd h2 :global(em) { font-style: normal; color: var(--red-soft); }
  .hshd p { margin: clamp(9px, 1.1vw, 15px) 0 0; max-width: 60ch; color: var(--tx2);
    font-size: clamp(.9rem, 1.02vw, 1.02rem); line-height: 1.58; }
  .hsgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .hsinputs { padding: clamp(18px, 2.2vw, 32px) clamp(20px, 2.6vw, 40px);
    border-right: 1px solid var(--line); display: flex; flex-direction: column;
    gap: clamp(13px, 1.5vw, 19px); }
  .hsrow { display: flex; flex-direction: column; gap: 8px; cursor: pointer; }
  .hslab { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .hslab b { color: var(--tx2); font-weight: 500; font-size: clamp(.85rem, .95vw, .98rem); }
  .hslab em { font-style: normal; font-family: var(--f-tek); font-weight: 700;
    color: #fff; font-size: clamp(.98rem, 1.2vw, 1.18rem); font-variant-numeric: tabular-nums; }
  .hsrow.vol .hslab b { color: #fff; font-weight: 650; }
  .hsrow.vol .hslab em { color: var(--red-soft); font-size: clamp(1.2rem, 1.7vw, 1.62rem); }
  .hssep { font-family: var(--f-tek); font-size: clamp(8.6px, .74vw, 10.2px);
    letter-spacing: .13em; text-transform: uppercase; color: var(--tx4);
    padding-top: clamp(4px, .6vw, 8px); border-top: 1px solid var(--line); }
  .hsrow input[type=range] { -webkit-appearance: none; appearance: none; width: 100%;
    height: 5px; border-radius: 4px; background: rgba(255, 255, 255, .1); outline: none;
    cursor: pointer; }
  .hsrow input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none;
    width: 18px; height: 18px; border-radius: 50%; background: #fff; cursor: pointer;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .55), 0 0 0 0 rgba(239, 35, 60, .35);
    transition: box-shadow .25s var(--e), transform .25s var(--e); }
  .hsrow input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border: 0;
    border-radius: 50%; background: #fff; cursor: pointer;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .55); }
  .hsrow input[type=range]:hover::-webkit-slider-thumb { transform: scale(1.1); }
  .hsrow input[type=range]:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 2px 10px rgba(0, 0, 0, .55), 0 0 0 6px rgba(239, 35, 60, .3); }
  .hsrow.vol input[type=range]::-webkit-slider-thumb { background: var(--red);
    box-shadow: 0 2px 14px -2px var(--red-glow); }
  .hsrow.vol input[type=range]::-moz-range-thumb { background: var(--red); }
  .hsout { padding: clamp(18px, 2.2vw, 32px) clamp(20px, 2.6vw, 40px);
    display: flex; flex-direction: column; gap: clamp(12px, 1.5vw, 20px); }
  .hsflow { display: flex; flex-direction: column; gap: 7px; list-style: none;
    margin: 0; padding: 0; }
  .hsstep { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: baseline; }
  .hsstep i { font-style: normal; color: var(--tx3); font-size: clamp(.78rem, .86vw, .9rem); }
  .hsstep b { font-family: var(--f-tek); color: #fff; font-weight: 600;
    font-size: clamp(.88rem, 1vw, 1.04rem); font-variant-numeric: tabular-nums; }
  .hsbar { grid-column: 1 / -1; height: 6px; border-radius: 4px;
    background: rgba(255, 255, 255, .06); overflow: hidden; }
  .hsbar u { display: block; height: 100%; border-radius: 4px; text-decoration: none;
    background: linear-gradient(90deg, rgba(255, 255, 255, .34), rgba(255, 255, 255, .14));
    transition: width .35s var(--e); }
  .hsstep.last i { color: var(--red-soft); }
  .hsstep.last b { color: var(--red-soft); font-size: clamp(1rem, 1.15vw, 1.2rem); }
  .hsstep.last .hsbar u { background: linear-gradient(90deg, var(--red), var(--red-soft));
    box-shadow: 0 0 20px -8px var(--red-glow); }
  .hsres { display: flex; align-items: flex-end; gap: clamp(16px, 2.4vw, 34px); flex-wrap: wrap;
    padding-top: clamp(12px, 1.5vw, 20px); border-top: 1px solid var(--line); }
  .hsbig, .hssm { display: flex; flex-direction: column; gap: 2px; }
  .hsbig span, .hssm span { font-family: var(--f-tek); font-size: clamp(8.6px, .74vw, 10.2px);
    letter-spacing: .13em; text-transform: uppercase; color: var(--tx4); }
  .hsbig b { font-weight: 800; letter-spacing: -.035em;
    font-size: clamp(2.4rem, 5.4vw, 4.2rem); line-height: 1; color: var(--red-soft);
    font-variant-numeric: tabular-nums; }
  .hssm b { font-family: var(--f-tek); font-weight: 700; color: #fff;
    font-size: clamp(1.1rem, 1.7vw, 1.6rem); font-variant-numeric: tabular-nums; }
  .hsnote { margin: 0; color: var(--tx3); font-size: clamp(.82rem, .9vw, .94rem);
    line-height: 1.55; max-width: 52ch; }
  .hsout .dugme { align-self: flex-start; }
  /* ₺ satırı: paranın büyük rakam olması bilinçli — kayıptan kaçınma
     adetle değil parayla çalışır. Rakam kızıl, üst çizgi kesikli. */
  .hsres.hspara { border-top: 1px dashed rgba(239, 35, 60, .4); }
  .hsres.hspara .hsbig b { color: var(--red); }
  .hsrow.val .hslab em { color: #fff; font-size: clamp(1.05rem, 1.35vw, 1.3rem); }
  .hsrow.val input[type=range]::-webkit-slider-thumb { background: #fff; }
  @media (max-width: 860px) {
    .hsgrid { grid-template-columns: 1fr; }
    .hsinputs { border-right: 0; border-bottom: 1px solid var(--line); }
    .hsbig b { font-size: clamp(2.6rem, 14vw, 3.4rem); }
  }
  /* --- #flow GORUNURLUK KAPISI: `animation` KISAYOLU play-state'i
     sifirlar, bu blok o kurallardan SONRA gelmeli (ayni ders: bloktan
     once dururken .adugum/.ajan-kart/.bi dongude kaliyordu) --- */
  /* SURUCU KURALI (Enes, 3 Eyl 2026 — CLAUDE.md "Surec demolari
     gorunurlukte canli"; 5 Eyl'un --flow view cizelgesi + sonlu tekrar
     SOKULDU): tel paketleri (ak-iz 3.4s / ak-iz-m 2.6s), dugum dalgasi
     (hp-dalga 2.667s), ajan satirlari (fsp-dalga 3.18s) ve beyin nabzi
     (brainPulse 2.6s) kendi zaman gecikmeleriyle SONSUZ doner — yalniz
     .akis3 kadrajdayken (.akoynar, IO esik .25), cikinca paused.
     Kaynagin #flow'u da boyleydi: IO(.04) start/stop + rAF tick
     (kok 9786-9788); burada rAF yok, CSS play-state. */
  .akis3 { --akps: paused; }
  .akis3.akoynar { --akps: running; }
  .adugum, .ajan-kart ol, .bi,
  .sus-tel .tel-iz, .sus-tel-m .tel-iz { animation-play-state: var(--akps, paused); }
</style>

<script>
  /* AKIS KAPISI (Enes, 3 Eyl 2026): .akis3 kadraja girince .akoynar,
     cikinca kalkar — kaynagin flowKur IO'su (kok 9786-9787, esik .04)
     ile ayni is; esik .25 (SAAkis/HizmetGovde ile bir). Kaydirma
     dinleyicisi yok (H12), rAF yok; IO yoksa surekli oynasin (sus). */
  const akis3 = document.querySelector('.akis3');
  if (akis3) {
    if ('IntersectionObserver' in window)
      new IntersectionObserver((es) => {
        for (const e of es) e.target.classList.toggle('akoynar', e.isIntersecting);
      }, { threshold: 0.25 }).observe(akis3);
    else akis3.classList.add('akoynar');
  }
</script>
