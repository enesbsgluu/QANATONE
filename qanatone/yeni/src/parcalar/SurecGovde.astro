---
/* Süreç gövdesi — TR ve EN aynı parça (rota turu). Beş adım kartı
   content.json `steps`ten (n/t/p/m; m karışık: düz İngilizce araç adları
   + dilli nesneler, T ikisini de çözer). Ada JS'i 0.
   MÜŞTERİ YOLU ÇİZGİSİ (eski #chan) STATİK basılıyor: eğri aynı
   sabitlerden DERLEMEDE hesaplanır (kök chan() 10877: xs/ys), beş düğüm
   ve etiket "tamamlanmış" hâlde doğar. Eski tarafta bunların tümü JS'le
   doğuyordu (bot beş yolculuk etiketinin HİÇBİRİNİ görmüyordu) ve
   kaydırma dinleyicisi + getTotalLength/getPointAtLength ile çiziliyordu
   — ikisi de yasaklı desen (H12 ailesi). Çizilme/nokta animasyonu
   giydirme turuna (perde SVG izler kararıyla aynı: pathLength="1" +
   scroll-driven CSS). Etiketler KODDA sabit — eski LB haritası da
   koddaydı, panel hiçbir zaman ezemiyordu; davranış değişmedi. */
import { icerik, T, suz, type Dil } from '../icerik';
interface Props { dil: Dil }
const { dil } = Astro.props;
const M = (tr: string, en: string) => dil === 'en' ? en : tr;
const s = (icerik.strings && icerik.strings[dil]) || {};
const m = (k: string, varsayilan: string): string => T(s[k], dil) || varsayilan;
const adimlar = icerik.steps || [];

/* Eğri: kökteki chan() ile aynı sabitler, aynı Bezier kuruluşu. */
const W = 1000, N = 5;
const xs = [...Array(N)].map((_, i) => 62 + i * (W - 124) / (N - 1));
const ys = [98, 60, 84, 46, 74];
let yol = `M${xs[0]},${ys[0]}`;
for (let i = 1; i < N; i++) {
  const cx = (xs[i - 1] + xs[i]) / 2;
  yol += ` C${cx},${ys[i - 1]} ${cx},${ys[i]} ${xs[i]},${ys[i]}`;
}
const ETIKET = dil === 'en'
  ? ['Notices', 'Searches', 'Asks', 'Compares', 'Buys']
  : ['Fark ediliyor', 'Arıyor', 'Soruyor', 'Karşılaştırıyor', 'Satın alıyor'];
---
<section class="giris">
  <p class="ust-etiket">{m('s3e', 'Süreç')}</p>
  <h1 set:html={suz(m('s3h', 'Müşteri yolu,<br><span class="thin">baştan sona.</span>'), ['br', 'span.thin'])} />
  <p class="lede">{m('s3p', 'Her aşamada ne yaptığımız, ne ölçtüğümüz ve ne beklendiği belli. Sürpriz yok.')}</p>
</section>

{/* ÇİZİLME ANİMASYONU (giydirme turu) — perde kararındaki reçete:
    pathLength="1" (getTotalLength YOK, yerleşim okuması sıfır) +
    scroll-driven CSS (adlandırılmış view-timeline .yolcu'da; S-P dersi:
    sticky yok ✓, overflow:visible ✓). JS'siz. Desteklemeyen tarayıcıda
    @supports kapısı hiç açılmaz: çizgi DOLU durur, içerik iki hâlde de
    eksiksiz (S2 deseni). Eski chan() davranışının birebiri: çizgi
    ilerledikçe düğüm i, t=i/4·0,95'te açılır; uçta nokta gezer ve
    bitişte kaybolur (eski paint: t<.02 ve >.995 gizli). */}
<div class="yolcu">
  <svg viewBox={`0 0 ${W} 140`} preserveAspectRatio="none" role="img"
    aria-label={M('Müşteri yolculuğu: ' + ETIKET.join(', '), 'Customer journey: ' + ETIKET.join(', '))}>
    <defs><linearGradient id="yg" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8f0f21" /><stop offset="1" stop-color="#ef233c" /></linearGradient></defs>
    <path class="y-cizgi" d={yol} pathLength="1" />
    {xs.map((x, i) => (
      <>
        <circle class="y-dugum" cx={x} cy={ys[i]} r="7" />
        <text class="y-yazi" x={x} y={ys[i] - 19} text-anchor="middle">{ETIKET[i]}</text>
      </>
    ))}
    {/* Uçta gezen nokta: eğri derlemede offset-path olarak basılır —
        çizgiyle aynı koordinat uzayı, aynı gerilme. */}
    <circle class="y-nokta" r="5" style={`offset-path:path('${yol}')`} />
  </svg>
</div>

<ol class="adimlar-s">
  {adimlar.map((a: any) => (
    <li>
      <b>{a.n}</b>
      <div>
        <h2>{T(a.t, dil)}</h2>
        <p>{T(a.p, dil)}</p>
        {a.m?.length > 0 && <ul class="olcum">
          {a.m.map((x: any) => <li>{T(x, dil)}</li>)}
        </ul>}
      </div>
    </li>
  ))}
</ol>

<p class="son">
  <a class="dugme" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${dil === 'en' ? '/en' : ''}/#iletisim`}>{M('Konuşalım', "Let's talk")}</a>
</p>

<style>
  .ust-etiket { color: var(--tx3); font-family: ui-monospace, monospace;
    font-size: .78rem; letter-spacing: .08em; margin-bottom: 6px; }
  /* ÇİZİLME SÜRÜCÜSÜ — tek anonim view() animasyonu @property'li --yt
     sayısını 0→1 sürer; SVG değerleri değişkenden TÜRER (calc), SVG
     çocuklarına ayrı animasyon bağlanmaz. Sebep ölçüldü (20 Ağu, bu
     Chrome'da): adlandırılmış view-timeline CSS'ten hiç aktive olmadı
     (getAnimations currentTime null), aynı subject JS ViewTimeline'ında
     aktifti; sitede kanıtlı çalışan desen anonim view() (S2/S3/S-K).
     TABAN = TAMAMLANMIŞ: --yt'nin initial'ı 1 — @supports dışı tarayıcı,
     @property bilmeyen tarayıcı (var fallback 1) ve reduced-motion
     (animation:none) üçü de dolu çizgiyi görür; nokta yt=1'de gizli. */
  .yolcu { position: relative; height: clamp(96px, 12vw, 150px);
    margin: clamp(18px, 3vw, 30px) 0 clamp(30px, 4vw, 54px); }
  @property --yt { syntax: '<number>'; inherits: true; initial-value: 1; }
  @supports (animation-timeline: view()) {
    /* Aralık: eski draw() eşiği (top %92→%34 vh) ≈ cover 5–55. */
    .yolcu { animation: y-surus linear both;
      animation-timeline: view(); animation-range: cover 5% cover 55%; }
  }
  @keyframes y-surus { from { --yt: 0; } to { --yt: 1; } }
  @media (prefers-reduced-motion: reduce) { .yolcu { animation: none; } }
  .yolcu svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .y-cizgi { fill: none; stroke: url(#yg); stroke-width: 2.4; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--yt, 1)); }
  /* Düğüm/etiket basamakları: eski t_i=i/4·0,95 eşikleri clamp-step ile —
     (yt - t_i)·60 eşik altında 0'a, üstünde 1'e kırpılır. */
  .y-dugum { fill: rgba(239, 35, 60, .16); stroke: var(--red-soft); stroke-width: 1.6;
    opacity: calc(.3 + .7 * clamp(0, (var(--yt, 1) - var(--te, 0)) * 60, 1)); }
  .y-yazi { font-size: 11px; font-weight: 500; fill: var(--tx2);
    opacity: calc(.5 + .5 * clamp(0, (var(--yt, 1) - var(--te, 0)) * 60, 1)); }
  .y-dugum:nth-of-type(2), .y-yazi:nth-of-type(2) { --te: .2375; }
  .y-dugum:nth-of-type(3), .y-yazi:nth-of-type(3) { --te: .475; }
  .y-dugum:nth-of-type(4), .y-yazi:nth-of-type(4) { --te: .7125; }
  .y-dugum:nth-of-type(5), .y-yazi:nth-of-type(5) { --te: .95; }
  /* Uçta gezen nokta: eski paint dersi — t<.02 ve >.995 gizli; yt=1
     (taban ve bitiş) noktayı söndürür. */
  .y-nokta { fill: var(--red);
    offset-distance: calc(var(--yt, 1) * 100%);
    opacity: clamp(0, min(var(--yt, 1) * 50, (1 - var(--yt, 1)) * 200), 1); }
  @media (max-width: 700px) { .yolcu { height: 78px; } .y-yazi { font-size: 9px; } }
  .adimlar-s { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .adimlar-s li { display: flex; gap: 14px; border: 1px solid var(--line);
    border-radius: 14px; padding: 18px; }
  .adimlar-s b { font-family: ui-monospace, monospace; color: var(--red-soft);
    font-size: .85rem; }
  .adimlar-s h2 { font-size: 1.05rem; margin: 0 0 6px; }
  .adimlar-s div > p { color: var(--tx2); font-size: .92rem; }
  .olcum { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 14px;
    margin-top: 10px; padding: 0; }
  .olcum li { color: var(--tx3); font-size: .82rem;
    font-family: ui-monospace, monospace; }
  .son { margin-top: 34px; text-align: center; }
</style>
