---
/* LEAD KUTUSU — TEK PARÇA (3 Eyl 2026, TASARIM ANAYASASI "kabuk katmanları").
   Kaynak: kök index.html `#lead` / `.ldbox` (5188-5230, CSS 2315-2340) +
   gönderim `leadForm()` 11346. Kaynakta form HER ROTADA en sondadır
   (11742: "form her rotada en sonda"); yeni kabukta yalnız ana sayfa ve
   /hizmetler'de vardı (SILIletisim içinde) — anayasa gereği kabuğa
   (Temel.astro, footer'ın önüne) taşındı. Bu parça ikisinde de aynı:
   SILIletisim onu çağrı bölümünün içinde basar, Temel öbür sayfalarda
   `.sil-lead` bölümüyle (kaynak #lead: 0 üst / clamp(50,7vw,90) alt).

   FORMUN KENDİSİ STATİK HTML — Netlify Forms formu DERLEME ANINDAKİ
   statik HTML'den tanır; atıf alanları (utm_*, gclid…) burada durur ve
   DEĞERLERİ BOŞ (pişmiş değer bütün ziyaretçilere atfedilir).
   ADA JS'İ yalnız `submit`; JS koşmazsa NATIVE POST ile gider. */
import '../stil/iletisim.css';
import { icerik, T, suz } from '../icerik';

interface Props { dil?: 'tr' | 'en' }
const { dil = 'tr' } = Astro.props;
const s = (icerik.strings && (icerik.strings[dil] || icerik.strings.tr)) || {};
const g = (k: string): string => T(s[k], dil);
/* TUR 2 (5 Eyl 2026): `g()` panelde YUVASI OLAN anahtari okur ve yoksa BOS
   doner; yeni acilan alanin kod varsayilani olmasi gerektigi icin yanina
   `m()` geldi (kucuk m, uc argumanli — metin-harita.cjs bu bicimi tarar). */
const m = (k: string, tr: string, enV: string): string => T(s[k], dil) || (dil === 'en' ? enV : tr);
const yalinMetin = (k: string): string => g(k).replace(/<[^>]*>/g, '').trim();
const en = dil === 'en';
const wa = String((icerik.settings || {}).whatsapp || '').replace(/\D/g, '');
/* KVKK metninin özeti kayda düşer (kaynak `ldKvkkOzet`; derlemede pişer) */
const kvkkOzet = g('ld4').replace(/<[^>]*>/g, '').slice(0, 180);
const ok = '<path d="M5 12h13"/><path d="m13 6 6 6-6 6"/>';
---
<div class="sil-kutu" id="lead">
  <div class="sil-yazi">
    <p class="kunye">{g('ldk')}</p>
    <h3 set:html={suz(g('ldh'), ['em', 'b'])} />
    <p>{g('ldp')}</p>
  </div>

  {/* TESEKKUR ADRESI (6 Eyl 2026, yayin oncesi kontrol madde 1).
      `action`: JS KOSMAYAN yol — Netlify Forms native POST'tan sonra bu
      adrese dondurur. JS'li yolda ada `location.assign` ile ayni adrese
      gider. Iki yol da AYNI adrese cikar; olcum betigi donusumu tek bir
      adrese baglayabilsin diye. Dil ayrimi: EN ziyaretci EN esine gider. */}
  <form class="sil-form" id="silForm" name="lead" method="POST"
    action={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${en ? '/en' : ''}/tesekkur/`}
    data-netlify="true" netlify-honeypot="company">
    <input type="hidden" name="form-name" value="lead" />
    {/* Honeypot: gerçek kullanıcı görmez, bot doldurur. */}
    <p class="sus-tuzak"><label>{g('hpSirket')}
      <input name="company" tabindex="-1" autocomplete="off" /></label></p>

    <label class="sil-alan"><span>{g('ld1')}</span>
      <input type="text" name="name" required maxlength="80" autocomplete="name" /></label>
    <label class="sil-alan"><span>{g('ld2')}</span>
      <input type="email" name="email" required maxlength="120" autocomplete="email" /></label>
    <label class="sil-alan"><span>{g('ld3')}</span>
      {/* TELEFON IPUCU PANELE ACILDI (TUR 2). Komsu mesaj alaninin ipucu
          `en ? ... : ...` ile cevriliyordu, bu SABITTI: EN ziyaretci
          Turkce telefon bicimi goruyordu. EN varsayilani BILEREK TR ile
          ayni birakildi — Ingilizce ipucunun ne olacagi icerik karari,
          uydurulmaz; alan artik panelde, deger Enes'in. */}
      <input type="tel" name="phone" required maxlength="24" autocomplete="tel"
        placeholder={m('ldtel', '+90 5xx xxx xx xx', '+90 5xx xxx xx xx')} /></label>
    <label class="sil-alan"><span>{g('ld6')}</span>
      <textarea name="message" maxlength="600" rows="3"
        placeholder={en ? 'e.g. site + WhatsApp agent for health tourism'
                        : 'Örn: sağlık turizmi için site + WhatsApp ajanı'}></textarea></label>

    {/* KVKK onayı — kaynağın kendi sınırı aynen: `required` kullanıcı
        deneyimidir; Netlify Forms sunucu tarafı doğrulama sunmuyor.
        Hedef KAYDETMEK: alan gelmediyse kayıtta yoktur. */}
    <label class="sil-onay"><input type="checkbox" name="kvkk_onay" value="evet" required />
      <span>{g('ld4')}</span></label>
    <input type="hidden" name="kvkk_metin_ozet" value={kvkkOzet} />

    {/* ATIF ALANLARI — değerleri BOŞ doğar, gönderim anında dolar. */}
    <input type="hidden" name="utm_source" value="" />
    <input type="hidden" name="utm_medium" value="" />
    <input type="hidden" name="utm_campaign" value="" />
    <input type="hidden" name="utm_term" value="" />
    <input type="hidden" name="utm_content" value="" />
    <input type="hidden" name="gclid" value="" />
    <input type="hidden" name="fbclid" value="" />
    <input type="hidden" name="msclkid" value="" />
    <input type="hidden" name="inilen_sayfa" value="" />
    <input type="hidden" name="yonlendiren" value="" />

    <button class="dugme" type="submit">{yalinMetin('ld5')}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ok} />
    </button>
    <p class="sil-durum" id="silDurum" role="status" aria-live="polite"></p>
  </form>
</div>

<script define:vars={{ waNum: wa, tesekkurYol: `${import.meta.env.BASE_URL.replace(/\/$/, '')}${en ? '/en' : ''}/tesekkur/` }}>
  /* ADA — yalnız `submit`. Açılışta sıfır iş.
     1) Atıf alanları burada doldurulur: utm_*, tıklama kimlikleri,
        inilen sayfa, yönlendiren.
     2) Gönderim `fetch` ile (kullanıcı sayfada kalsın — kullanıcı eylemi).
     3) Sunucuya ulaşılamazsa WhatsApp'a düşürülür (kaynağın davranışı).
     JS koşmazsa form NATIVE POST'la gider — talep yine kaydedilir. */
  const f = document.getElementById('silForm');
  if (f) {
    const durum = document.getElementById('silDurum');
    const atif = () => {
      const p = new URLSearchParams(location.search);
      const yaz = (ad, deger) => {
        const el = f.elements.namedItem(ad);
        if (el && !el.value) el.value = deger || '';
      };
      for (const k of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content',
                       'gclid', 'fbclid', 'msclkid']) yaz(k, p.get(k));
      yaz('inilen_sayfa', location.pathname + location.search);
      yaz('yonlendiren', document.referrer);
    };
    const waBaglanti = (d) => {
      const govde = 'QANATONE — demo talebi\n' +
        'Ad soyad: ' + (d.get('name') || '') + '\n' +
        'E-posta: ' + (d.get('email') || '') + '\n' +
        'Telefon: ' + (d.get('phone') || '') +
        (d.get('message') ? '\nTalep: ' + d.get('message') : '');
      return 'https://wa.me/' + waNum + '?text=' + encodeURIComponent(govde);
    };
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      atif();
      const veri = new FormData(f);
      durum.textContent = 'Gönderiliyor…';
      try {
        const r = await fetch('/', {
          method: 'POST',
          headers: { 'content-type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(veri).toString(),
        });
        if (!r.ok) throw new Error(String(r.status));
        /* TESEKKUR ADRESINE GIT (6 Eyl 2026): donusum bir ADRESE baglanmali,
           DOM'daki bir metne degil — olcum betigi (GA4/GTM) hedefi oradan
           okur. `f.reset()` gitmeden once: kullanici geri gelirse form bos.
           JS kosmayan yolda ayni adrese formun `action`i goturur. */
        f.reset();
        location.assign(tesekkurYol);
        return;
      } catch (err) {
        durum.textContent = 'Kayıt sunucuya ulaşmadı. ';
        const a = document.createElement('a');
        a.href = waBaglanti(veri);
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = "WhatsApp'tan gönder";
        durum.appendChild(a);
      }
    });
  }
</script>
