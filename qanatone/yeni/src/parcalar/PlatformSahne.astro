---
/* K7 · PLATFORM AKIŞI (#qtStage) — finans hizmetinin kaydırma sahnesi.
   Kaynak: kök index.html · markup tradeStage 8264-8324 · CSS 3736-3899
   (+ 4393-4395 mobil içerik istisnası) · sürücü draw 8475-8527 ·
   ST 8716 (pin 2.7). Hizmet: finans (fam:'trade' + det.trade).

   DÖRT PERDE TEK PENCEREDE YATAY KAYAR: arama → alıcılar → karar verici
   → ilk temas. Yatay kaydırma perdeler arası GEÇİŞ, alt-ilerleme ise
   perdenin İÇİNİ sürer (kaynağın 8481 yorumu).

   KİLİT ÖLÇÜLDÜ (Enes'in uyarısı — araçlar sahnesinde 228 px fazla
   yapışkanlık çıkmıştı): kap boyu = sarmal + 270vh, yani yapışık
   pencere (kapBoyu − sarmal) tam kilit boyuna eşit. Sticky üst hizası
   kaynağın iki dalını da karşılar: blok ekrana sığıyorsa 'center
   center' (top=(100vh−sarmal)/2), sığmıyorsa 'top top' (top=0) —
   max(0px, …) ikisini tek ifadede veriyor ve aralık başlangıcı da
   ondan türüyor (100vh − top).

   SÜRÜCÜ TEK: --qtp. Yatay şerit, perde ışıkları, adım rayı, yazan
   sorgu, koşan sayaç, açılan satırlar, yazılan e-posta — hepsi
   kaydırmaya bağlı. Kaynakta da öyleydi (draw(p) içinde); IO yok.

   Eşikler kaynak draw'dan (8489-8526), N=4:
     a_i = clamp((e − i/4) / .25)            (kaynağın idx/sub çifti)
     şerit = Σ_{i=0..2} clamp((4e − i − .82)/.18)   → translateX(−%25·şerit)
       (kaynak: slide=min(N−1, idx+clamp((sub−.82)/.18)); SON PERDEDE
        DURUR — Enes iki sahnede de boş ekran görmüştü, 8492)
     perde 1: sorgu a0/.30 · sayaç 1.284·EA((a0−.36)/.30) · çip a0>.32+i·.05
     perde 2: satır a1>.05+i·.075 · seçim a1>.50 (pickIdx)
     perde 3: özet a2>.10+i·.09 · kanal a2>.42+i·.09 · rozet a2>.72
     perde 4: gövde a3/.52 · gönderildi a3>.60 · yanıt a3>.72
     yazıyor imleci: idx=0 ve a0<.34  (⇔ e<.085)

   SAPMA (adıyla, sohbet sahnesinin dersiyle aynı): kaynak metni KARAKTER
   karakter yazıyordu (textContent her karede yeniden kuruluyordu).
   Burada sorgu KARAKTER granülaritesinde (tek satır, 18 harf — imlecin
   metnin ucunda durması için genişlik gerçekten büyümeli: gizli harf
   font-size:0, yani sıfır genişlik), e-posta gövdesi ise KELİME
   granülaritesinde (281 karakter × ayrı eleman kare başına ağır olurdu).

   TABAN = TAMAMLANMIŞ (kaynak REDUCE dalı draw(1)); içerik JS'siz tam,
   ada JS'i yalnız sarmal yüksekliğini ölçer. */
import { T, type Dil } from '../icerik';
interface Props { trade: any; dil: Dil }
const { trade, dil } = Astro.props;
const t = trade || {};
const en = dil === 'en';
const M = (tr: string, eng: string) => en ? eng : tr;
const adimlar = (t.steps || []) as any[];
const cipler = (t.filters || []) as any[];
const alicilar = (t.buyers || []) as any[];
const ozet = (t.sum || []) as any[];
const dm = t.dm || {};
const secim = t.pickIdx || 0;
/* sayaç: kaynak FOUND'u rakam dışını atarak okuyor (8487) */
const bulunan = parseInt(String(t.found || '0').replace(/\D/g, ''), 10) || 0;
const binler = Math.floor(bulunan / 1000);
/* sorgu: harf harf — eşik round(len·x) > k ⇔ x ≥ (k+.5)/len */
const sorgu = String(T(t.q, dil) || '');
const SH = [...sorgu];
/* gövde: kelime kelime; \n ayrı jeton (kaynak white-space:pre-wrap) */
const govde = String(T((t.mail || {}).body, dil) || '');
type Jeton = { k: string; br?: boolean };
const jetonlar: Jeton[] = [];
govde.split(/(\n)/).forEach(par => {
  if (par === '\n') { jetonlar.push({ k: '', br: true }); return; }
  par.split(/\s+/).filter(Boolean).forEach(k => jetonlar.push({ k }));
});
const KN = jetonlar.filter(j => !j.br).length || 1;
let ki = -1;
---
{t.q && (
<div class="sdsec qt-kap">
  <div class="qt-sabit">
    <span class="mono">{M('Platform akışı — kaydırdıkça çalışır', 'The platform — runs as you scroll')}</span>
    <div class="qtstage" id="qtStage">
      <div class="qtbar">
        <span class="qtlogo"><b />TradeSelf</span>
        <span class="qtrail">{adimlar.map((s, i) =>
          <span class="qtstep" data-s={i} style={`--i:${i}`}><b />{T(s, dil)}</span>)}</span>
      </div>
      <div class="qtview"><div class="qttrack">

        {/* perde 1 — arama */}
        <section class="qtact" data-a="0" style="--i:0">
          <div class="qtsearch">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.4-3.4" /></svg>
            <span class="qtq">{SH.map((c, k) =>
              <i style={`--k:${((k + .5) / SH.length).toFixed(5)}`}>{c}</i>)}</span>
            <b class="qtcar" />
            <span class="qths">HS {t.hs || ''}</span>
          </div>
          <div class="qtchips">{cipler.map((f, i) =>
            <span class="qtchip" style={`--i:${i}`}>{T(f, dil)}</span>)}</div>
          <div class="qtfound"><em class="qtn" style={`--bulunan:${bulunan}`} /><i>{M('doğrulanmış alıcı bulundu', 'verified buyers found')}</i></div>
        </section>

        {/* perde 2 — alıcı listesi */}
        <section class="qtact" data-a="1" style="--i:1">
          <div class="qthead"><span>{M('Firma', 'Company')}</span><span>{M('Sevkiyat', 'Shipments')}</span>
            <span>{M('Hacim', 'Volume')}</span><span>{M('Son alım', 'Last buy')}</span></div>
          <div class="qtlist">{alicilar.map((b: any, i: number) =>
            <div class={'qtrow' + (i === secim ? ' aim' : '')} data-b={i} style={`--i:${i}`}>
              <span class="qtco"><b>{b.n}</b><i>{b.c}</i></span>
              <span class="qtm"><em>{b.s}</em><i>{M('sevkiyat', 'shipments')}</i></span>
              <span class="qtm"><em>{b.v}</em><i>{M('hacim', 'volume')}</i></span>
              <span class="qtm last"><em>{b.d}</em><i>{M('son alım', 'last buy')}</i></span>
            </div>)}</div>
        </section>

        {/* perde 3 — karar verici */}
        <section class="qtact" data-a="2" style="--i:2">
          <div class="qtcard">
            <div class="qtch"><b class="qtav" />
              <span><em>{t.pick || ''}</em><i>{t.pickc || ''}</i></span>
              <span class="qtver">{M('doğrulandı', 'verified')}</span></div>
            <ul class="qtsum">{ozet.map((s, i) =>
              <li style={`--i:${i}`}>{T(s, dil)}</li>)}</ul>
            <div class="qtdm"><span class="qtrole">{T(dm.role, dil)}</span>
              <b class="qtname">{dm.name || ''}</b>
              <span class="qtcon"><i data-c="0" style="--i:0">{dm.mail || ''}</i>
                <i data-c="1" style="--i:1">{dm.tel || ''}</i>
                <i data-c="2" style="--i:2">{dm.li || ''}</i></span></div>
          </div>
        </section>

        {/* perde 4 — ilk temas */}
        <section class="qtact" data-a="3" style="--i:3">
          <div class="qtmail">
            <div class="qtmh"><i>{M('Kime', 'To')}</i><b>{dm.mail || ''}</b></div>
            <div class="qtmh"><i>{M('Konu', 'Subject')}</i><b>{T((t.mail || {}).sub, dil)}</b></div>
            <p class="qtbody" style={`--n:${KN}`}>{jetonlar.map(j => j.br
              ? <br />
              : <span class="qtw" style={`--k:${++ki}`}>{j.k}{' '}</span>)}</p>
            <div class="qtsend"><b>{M('AI yazdı · gönderildi', 'Written by AI · sent')}</b></div>
          </div>
          <div class="qtreply"><b />{T((t.mail || {}).reply, dil)}</div>
        </section>

      </div></div>
    </div>
    {t.note && <div class="fnnote">{T(t.note, dil)}</div>}
  </div>
</div>
)}

<style>
  /* ═══ KAP · kaynak 3746-3775 birebir ═══ */
  .sdsec { margin-top: clamp(44px, 6vw, 72px); }
  .sdsec .mono { display: block; margin-bottom: 18px;
