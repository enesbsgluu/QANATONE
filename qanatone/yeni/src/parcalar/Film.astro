  { bas: 70.34, son: 73.94, tr: 'Fazlası kanalı aşındırır. Azı suyu durdurur.', en: 'Too much and the channel erodes. Too little and the water stops.' },
  { bas: 76.09, son: 79.69, tr: 'Otuz üç kilometre boyunca yüzlerce dikey kuyu açılır.', en: 'Across thirty-three kilometres, hundreds of vertical shafts are sunk.' },
  { bas: 84.84, son: 88.44, tr: 'Kazı, ancak ölçülebildiği yerde ilerler.', en: 'Digging only advances where it can be measured.' },
  { bas: 92.14, son: 95.74, tr: 'İki bin beş yüz yıl geçti. Problem yerinde duruyor.', en: 'Two and a half thousand years on, the problem is unchanged.' },
  { bas: 99.64, son: 103.24, tr: 'Kanal hâlâ kanal. Değişen, içinden akan şey.', en: 'The channel is still a channel. What runs through it is not.' },
