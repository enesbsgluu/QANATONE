---
/* FILM · SCROLL-SCRUB ADASI — ISKELET (27 Agu 2026).
   39 klip tek zaman cizelgesine dikilir; kaydirma filmi oynatir
   (DEVIR-SPESIFIKASYONU §3, Secenek B: klipler ayri yuklenir, sinirda el
   degisimi — HIGGSFIELD motorunun multi-leg kurgusu, §5 esleme).
   Secenek A (tek mp4) BILEREK secilmedi: motor sozlesmesinin poster/klip
   basina degismezleri ve seri on-yukleme yalniz B'de anlamli; montaj-
   duzenek E7/E11 tek filmin yavas hatta sarmaya uygun olmadigini olctu.

   BU TURDA YOK (bilerek): hikaye metni · giris Q sahnesi · final devri.
   Motor nav/dugme/ipucu/baslik kurmaz (sert degismez #6) — sayfanin isi.

   SAYILAR DOM'A KUNYEDEN INER: sure/kare/bas `sahneler.ts` -> ffprobe.
   Tarayiciya kanon.json inmez; motor data-* okur.

   IKI YOL, AYNI MARKUP:
     JS + hareket acik  -> `<html class="fl-js">`, motor `import()` ile
                          iner, sahneler ust uste yapisik kare, yalniz
                          etkin + iki komsu yerlesik.
     hareket azaltma / JS yok -> motor HIC inmez, hicbir video fetch
                          edilmez (sert degismez: reduced-motion'da sifir
                          video); 39 poster duz sutun olarak okunur.
   `<video>` etiketlerinde src YOK: kaynak yalniz motor tarafindan Blob
   olarak verilir. Bu, V1'in ("veri derlemede piser") ruhuyla uyumlu:
   sayfa kendiliginden hicbir sey cekmez.

   POSTER <img>: yalniz ilk sahne eager (ilk boya), obur 38'i lazy — ve
   JS yolunda `display:none` sarmal icinde oldukları icin HIC INMEZ
   (prolog katmanlarinin dersi: gizli tembel gorsel istek atmaz). */
import '../stil/film.css';
import { SAHNELER, FPS, TOPLAM_SN, PX_SN, SERTLIK, SONUM, TAVAN, AKIS, MOMENT, HIZALA } from '../film/sahneler';
/* DEVIR KUNYESI (31 Agu 2026, v3): son karedeki ekran dortgeni + son kare
   BUYUME HIZI. ELLE YAZILMIYOR — `film/ekran-kose.cjs` iz modunun (f20db52)
   k119/k120 KOSE olcumunden turetiliyor. Kutu olcumu (ekran-dikdortgen.json)
   artik kullanilmiyor: oz-dogrulamasi kendisi "AYRISMADI" diyordu, kose
   olcumu ise dortgenin dikdortgenligini de (ic acilar 90 +- 0,3) kanitladi.
   Oran olarak tasinir: video `object-fit: cover` ile olceklendigi icin
   tasinabilir olan sey piksel degil orandir. */
import KOSE from '../../film/ekran-kose.json';

/* k119 + k120 yoksa DERLEME KIRMIZI: kunye olcumsuz kalamaz. (ekran-kose.cjs
   tek-kare modunda kosulursa dosyada `kare: 120` kalmaz — sessiz eskime
   yerine derleme burada durur.) */
const kareBul = (n: number) => (KOSE as any).kareler.find((k: any) => k.kare === n && k.kose);
const K120 = kareBul(120), K119 = kareBul(119);
if (!K120 || !K119) throw new Error('ekran-kose.json k119/k120 yok — devir künyesi ölçümsüz kalamaz (node yeni/film/ekran-kose.cjs iz modu, f20db52)');
/* dort koseden eksen-hizali dortgen: olcum ic acilari 90 +- 0,3 verdi,
   kose ciftlerinin ortalamasi dortgenin kendisidir (alt kenar +-4 px
   gurultulu, ortalama onu da yumusatir). */
const eksen = (k: any) => {
  const K = k.kose;
  return {
    sol: (K.solUst[0] + K.solAlt[0]) / 2, sag: (K.sagUst[0] + K.sagAlt[0]) / 2,
    ust: (K.solUst[1] + K.sagUst[1]) / 2, alt: (K.solAlt[1] + K.sagAlt[1]) / 2,
  };
};
const e120 = eksen(K120), e119 = eksen(K119);
const DEVIR = {
  sol: e120.sol / K120.W, ust: e120.ust / K120.H,
  gen: (e120.sag - e120.sol) / K120.W, yuk: (e120.alt - e120.ust) / K120.H,
  /* SON KARE HIZI: dortgen son karede hala buyuyor (k119->k120 genislik
     farki ~0,5 px/kare). 1x okumada olcek hizi (1/s) olarak tasinir;
     surucu bunu varis temposuyla carpar (hiz surekliligi). */
  hiz: ((e120.sag - e120.sol) - (e119.sag - e119.sol)) * FPS / (e120.sag - e120.sol),
};

interface Props { dil?: 'tr' | 'en' }
const { dil = 'tr' } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="fl" aria-label={dil === 'en' ? 'Film' : 'Film'} data-kok={B}
  data-fps={FPS} data-pxsn={PX_SN} data-toplam={TOPLAM_SN} data-sert={SERTLIK} data-sonum={SONUM} data-tavan={TAVAN} data-akis={AKIS} data-moment={MOMENT} data-hizala={HIZALA}
  data-devir={`${DEVIR.sol.toFixed(6)},${DEVIR.ust.toFixed(6)},${DEVIR.gen.toFixed(6)},${DEVIR.yuk.toFixed(6)},${DEVIR.hiz.toFixed(7)}`}
  style={`--fl-sn:${TOPLAM_SN};--fl-pxsn:${PX_SN}`}>
  <div class="fl-ray">
    <div class="fl-yapis">
      {/* KUMANDA: tek dugme `.fl-gec` (PROLOGU GEC — filmi tumden atlar,
          motoru soker, oturum boyu atlanmis kalir; her zaman gorunur).
          `.fl-atla` YETIS DUGMESI KALKTI (Enes, 1 Eyl): hiz tavani
          gerisinde kalinca cikan "+N sn" rozeti gereksiz duruyordu.
          Motorun `atla()` API'si ve `fl-geride` olayi motor yuzeyinde
          DURUYOR (olcum duzenekleri kullanir) — kalkan yalniz UI.
          Motor UI kurmaz (sert degismez #6) — dugme sayfanin. */}
      {/* IBARE (Enes, 1 Eyl — davranis degisti): film BOYUNCA sayfanin
          alt ortasinda DURUR, bastan vardir (finalde-belirme + oturumda
          bir kez + ilk-girdide sonme mekanizmasi KALKTI — o kurgu ibareyi
          canlida hic gosterememisti). Yalniz devir baslayinca sonumlenerek
          kaybolur (CSS: html.fl-devir .fl-ipucu). Metin 14px (gec ile
          esit); OK GERI GELDI, SADECE KIRMIZI (Enes, 3. duzeltme) ve
          metinle BERABER yanip soner — 3,6 s halka ritmi (film.css). */}
      <p class="fl-ipucu"><span>{dil === 'en' ? 'SCROLL' : 'KAYDIR'}</span><svg viewBox="0 0 12 7" aria-hidden="true"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></p>
      <div class="fl-kumanda">
        {/* DONEN CIZGI (Enes, 31 Agu gece): kaynak eski site .void .ring —
            fl-halka ayni dil, degerler bekcide (film-halka.test.mjs) */}
        <a class="fl-gec" href="#fl-son"><i class="fl-halka" aria-hidden="true"></i><span>{dil === 'en' ? 'Skip prologue' : 'Prologu geç'}</span></a>
      </div>
      {SAHNELER.map((s, j) => (
        <div class={`fl-sahne${j === 0 ? ' fl-etkin' : (j === 1 ? ' fl-komsu' : '')}`}
          data-n={s.n} data-sure={s.sure} data-kare={s.kare} data-bas={s.bas}
          data-clip={s.clip} data-poster={s.poster}
          data-mclip={s.mobileClip} data-mposter={s.mobilePoster}>
          <picture>
            <source media="(max-width: 900px)" type="image/webp" srcset={`${B}/${s.mobilePoster}`}
              width={s.mgen} height={s.myuk} />
            <img class="fl-poster" src={`${B}/${s.poster}`} width={s.gen} height={s.yuk}
              alt="" aria-hidden="true" decoding="async"
              loading={j === 0 ? 'eager' : 'lazy'}
              fetchpriority={j === 0 ? 'high' : undefined} />
          </picture>
          <video class="fl-video" muted playsinline disableremoteplayback preload="none"
            width={s.gen} height={s.yuk} aria-hidden="true" tabindex="-1"></video>
          {s.acilis && (
            <video class="fl-video fl-acilis" muted playsinline disableremoteplayback preload="none"
              width={s.gen} height={s.yuk} aria-hidden="true" tabindex="-1"
              data-acilis={s.acilis.clip} data-macilis={s.acilis.mobileClip} data-asn={s.acilis.sn}></video>
          )}
        </div>
      ))}
    </div>
    {/* RAY SONU: "prologu gec" baginin hedefi. Ray'in en dibinde durur;
        buraya inen kaydirma filmi bitirmis demektir. */}
    <div id="fl-son" class="fl-son" tabindex="-1"></div>
  </div>
  {/* EFEKT A · TV ACMA katmanlari (Enes, 31 Agu aksam). Paneller (z 4)
      coken filmin ALTINDA kalan alani orter, kizil cizgi (z 6) coken
      goruntunun USTUNDE parlar. Transformlu yapis'in DISINDA dururlar
      (fixed'in atasi transformlu olamaz). */}
  <div class="fl-tv" aria-hidden="true"><i class="fl-tv-ust"></i><i class="fl-tv-alt"></i></div>
  <div class="fl-tv-cizgi" aria-hidden="true"></div>
</section>

<script>
  /* ADA — sayfaya inen tek betik. Motor (`src/film/motor.ts`) dinamik
     ithal: J1 tavaninin disinda, kendi tavani denetimde FM ailesi.
     Hareket azaltmada motor HIC inmez -> sifir video fetch.

     PROLOGU GEC — OTURUMDA BIR KEZ (31 Agu 2026, PROLOG-ISKELET 5. adim).
     Yazili davranis, uc madde:
       1. Kullanici `.fl-gec` bagina basarsa: motorun `sok()`u cagrilir
          (blob'lar revoke, dinleyiciler cozulur, DONGU DURUR), oturum
          bayragi yazilir, `<html data-film="atlandi">` isaretlenir ve
          bag kendi isini yapip ray sonuna (#fl-son) gider.
       2. AYNI OTURUMDA sayfa yeniden acilirsa motor HIC INDIRILMEZ ve
          film katmani hic kurulmaz: sifir video fetch, sifir poster,
          sifir kare. Prolog bir kez atlandiysa oturum boyu atlanmistir.
       3. Bayrak `sessionStorage` — sekme kapaninca dusen kapsam; kalici
          tercih degil (perde `qanat-splash-seen` ile ayni ev deseni).
     NEDEN SOKUM SART: `sok()` cagrilmazsa gorunmeyen film icin rAF
     donmeye devam eder — sessiz pil sizintisi. Motor tarafinda da
     `durdu` kapisi eklendi (motor.ts), yoksa `kare` kendini yeniden
     kuruyordu. */
  const bolum = document.querySelector<HTMLElement>('.fl');
  /* J1 kirpmasi: minifier property zincirini kisaltamaz; takma ad ~600 B kazandirdi (olculdu) */
  const KOKE = document.documentElement;
  const AN = () => performance.now();
  const azalt = matchMedia('(prefers-reduced-motion:reduce)').matches;
  const ANAHTAR = 'qanat-prolog-atlandi';
  let atlandi = false;
  try { atlandi = sessionStorage.getItem(ANAHTAR) === '1'; } catch {}

  if (bolum && atlandi) {
    /* 2. madde: oturumda zaten atlanmis — hicbir sey kurulmaz. */
    KOKE.dataset.film = 'atlandi';
  } else if (bolum && !azalt) {
    KOKE.classList.add('fl-js');
    /* YETIS DUGMESI KALKTI (1 Eyl, Enes) — `fl-geride` olayini dinleyen
       kalmadi; olay motor yuzeyinde duruyor (olcum kullanir). */
    import('../film/motor').then((m) => {
      const sok = m.baslat(bolum);
      /* PROLOGU GEC: bag JS'siz de calisir (#fl-son'a gider). JS varsa
         once zinciri sokeriz, sonra tarayici bagi kendi isler. */
    /* ---- NAV KOREOGRAFISI + DEVIR v3 (31 Agu 2026, Enes) ----
       YAKLASIM DEGISTI: sayfa ekrana KUCULTULMUYOR, VIDEO ekrana
       YAKINLASTIRILIYOR. `.fl-yapis` ekran dortgeninin merkezine
       transform-origin verilerek olceklenir; dortgen goruntu alaninin
       tami tamina kendisi oldugu anda gercek sayfa FADE_MS'lik capraz
       gecisle videonun USTUNDE netlesir. SAYFA HIC OLCEKLENMEZ (kapi:
       devir aninda sayfa olcegi tam 1,0) — govdeye transform yazan kod
       ve CSS kalmadi.

       OLCEK SABIT SAYI DEGIL: hedef olcek her acilista (ve resize'da)
       goruntu alani oranindan hesaplanir — DAIMA COVER: dortgen dort
       kenari da ortecek en kucuk olcekte durur; kapanan eksen tam
       oturur, oteki tasar, bosluk kalmaz. Tasma olcum yuzeyine yazilir.

       MIKRO ORTALAMA: dortgen merkezi kare merkezinden 0,5 / 5,9 px
       kayik (f20db52). Saf olcek bu kaykligi kapanan eksende iki katina
       tasiyip kapinin (fark < 2 px) ustune cikarirdi (1,6 oraninda dikey
       ~10 px). Olcekle orantili kucuk kaydirma (ucta <= 6 px) dortgeni
       devir aninda goruntu alanina TAM ortalar.

       HIZ SUREKLILIGI: video SON karesinde hala buyuyor (kunye: k119->
       k120 ~0,5 px/kare, data-devir 5. sayi = 1x'te olcek hizi 1/s).
       Video son karesine oturdugu anda buyumeyi yay devralir: baslangic
       hizi = kunye hizi x varis temposu (motor hizT; akisla ~0,08x,
       okumayla ~1x). Kritik sonumlu yay hedef olcege varirken hiz sifira
       iner — "sonra sonumlenerek sifira inecek". Iki hiz da olcum
       yuzeyine yazilir (kapi: fark yazilir).

       AYNI KARE SARTI: nav inisi devir tetigiyle ayni rAF tikinde
       (devirKare icinde navBak) — ayri dinleyici yok.

       DUZEN OKUMASI KARE BASINA DEGIL: geometri bir kez (ve resize'da)
       olculur; dongude yalniz scrollY ve __fl okunur. getComputedStyle
       yalniz fade basinda BIR kez (kayit icin). */
    const ipucu = bolum.querySelector<HTMLElement>('.fl-ipucu');
    const govde = document.getElementById('fl-govde');
    const yapis = bolum.querySelector<HTMLElement>('.fl-yapis')!;
    /* IBARE SONMESI OLCUMU (kapi: devirde sonme ani ms cinsinden):
       fl-devir sinifi ibareyi CSS gecisiyle sondurur; gecisin bitisi
       gercek olaydan okunur, sure varsayilmaz. */
    ipucu?.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'opacity' && KAYIT.ibareSonduMs === null && KOKE.classList.contains('fl-devir')) KAYIT.ibareSonduMs = AN();
    });

    /* kunye: sol,ust,gen,yuk (oran) + son kare buyume hizi (1/s, 1x) —
       Film.astro frontmatter'i ekran-kose.json k119/k120'den turetir. */
    const dk = (bolum.dataset.devir || '0,0,1,1,0').split(',').map(Number);
    const DK = { sol: dk[0], ust: dk[1], gen: dk[2], yuk: dk[3], hiz: dk[4] };
    /* Devir yayi sertligi — 60 SECILDI (Enes, 31 Agu aksam, gozle;
       adaylar 25/60/120 denendi). k=60 kritik sonumde oturma ~0,75 s,
       tepe kenar hizi filmin kendi dolly zarfinin icinde. ?dsert= kolu
       deneme icin durur. */
    const DSERT = (() => { const u = new URLSearchParams(location.search).get('dsert'); return u !== null && Number(u) > 0 && Number(u) <= 1000 ? Number(u) : 60; })();
    const FADE_MS = 140;                       /* SADE yol (hareket azaltma): duz capraz gecis */
    const KAPANMA_PX = 2;                      /* kapi esigi: kapanan eksende fark < 2 px */
    /* EFEKT A — TV ACMA (Enes, 31 Agu aksam; ?gecis=patlama KALKTI, flas
       patlama gibi okunmuyordu): video son karesine oturup dortgen
       goruntu alanini ortunce goruntu dikeyde parlak KIZIL CIZGIYE coker
       (cizgi filmin kizil cizgisi: #ef233c/#ff4d63 paleti), cizgi kisa
       bir an parlar, sonra dikeyde acilarak site belirir. Hedef 250-350:
       130 cokus + 50 parlama + 130 acilis = 310 ms. Hareket azaltmada
       sade sonumleme (FADE_MS capraz gecis, flas yok). */
    const TV_PARLA_MS = 50, TV_AC_MS = 130;
    /* BOZ=1 — OLCUM DUZENEGININ KIRMIZI KONTROLU (kapi: "kontrol once
       kasten kirmiziya dondurulur"). Cokusu 4 katina uzatir (sure kapisi
       kirmizi) ve gec tepesinde 60 ms ana is parcacigini kilitler (dusen
       kare kapisi kirmizi). Urun yolunda hicbir etkisi yok. */
    const BOZ = new URLSearchParams(location.search).get('boz') === '1';
    const TV_COK_MS = BOZ ? 520 : 130;
    const tvEl = bolum.querySelector<HTMLElement>('.fl-tv');
    const azaltMi = () => matchMedia('(prefers-reduced-motion:reduce)').matches;

    let vw = 0, vh = 0, vidO = 16 / 9, devirBas = 0;
    interface DevirGeo { qg: number; qh: number; cx: number; cy: number; S: number; kapanan: 'yatay' | 'dikey'; txSon: number; tySon: number }
    let G: DevirGeo | null = null;
    const olcDevir = () => {
      vw = innerWidth; vh = innerHeight;
      const v = bolum.querySelector<HTMLElement>('.fl-sahne:last-of-type video');
      vidO = (Number(v?.getAttribute('width')) || 1920) / (Number(v?.getAttribute('height')) || 1080);
      const f = (window as any).__fl;
      devirBas = f ? f.konum(f.toplam) : 0;
      /* `cover` cizimi -> dortgenin ekran pikseli -> hedef olcek */
      const cizG = vw / vh > vidO ? vw : vh * vidO;
      const cizH = vw / vh > vidO ? vw / vidO : vh;
      const ox = (vw - cizG) / 2, oy = (vh - cizH) / 2;
      const qg = DK.gen * cizG, qh = DK.yuk * cizH;
      const cx = ox + (DK.sol + DK.gen / 2) * cizG, cy = oy + (DK.ust + DK.yuk / 2) * cizH;
      const Sx = vw / qg, Sy = vh / qh;
      G = { qg, qh, cx, cy, S: Math.max(Sx, Sy), kapanan: Sx >= Sy ? 'yatay' : 'dikey', txSon: vw / 2 - cx, tySon: vh / 2 - cy };
      yapis.style.transformOrigin = `${cx.toFixed(2)}px ${cy.toFixed(2)}px`;
    };

    /* ---- devir yayi: motorla ayni disiplin (sabit 4 ms adim + harman) ---- */
    let s = 1, sv = 0, sOnce = 1, birikimD = 0, sonMs = 0;
    let aktif = false, fadeAcik = false, devirRaf = 0, navKalkti = false;
    let tvFaz = 0, tvT0 = 0;   /* EFEKT A fazi: 0 yok · 1 cokus · 2 parlama · 3 acilis */
    /* olcum yuzeyi kaydi — yalniz devir penceresinde dolar */
    const KAYIT: {
      v0: null | { video_1x: number; tempo: number; video: number; bizim: number; fark: number };
      basMs: number | null; fadeBasMs: number | null; tamMs: number | null;
      eskiYuklendiMs: number | null;
      fadeGeo: null | Record<string, unknown>; kareler: number[]; iz: [number, number, number][];
      /* EFEKT A fazlari (tv acma) + kapanis yolu ('tv' | 'sade') */
      tv: { basMs: number | null; parlaMs: number | null; acMs: number | null; sonMs: number | null };
      kapanisYolu: string | null;
      /* EFEKT B (prologu gec): yol 'isinlanma' | 'sade', nokta bilgi icin */
      gec: null | { basMs: number; tepeMs: number | null; sonMs: number | null; yol: string; kareler: number[] };
      ibareSonduMs: number | null;   /* devirde ibarenin sonme ani (transitionend) */
    } = { v0: null, basMs: null, fadeBasMs: null, tamMs: null, eskiYuklendiMs: null, fadeGeo: null, kareler: [], iz: [],
      tv: { basMs: null, parlaMs: null, acMs: null, sonMs: null }, kapanisYolu: null, gec: null, ibareSonduMs: null };

    /* NAV: film basladiysa kalkar ve DEVIRDE DE KALKIK KALIR (v2'de devirde
       geri iniyordu; govde artik eski sitenin TAM sayfasi — kendi navi var,
       dis nav inerse CIFT nav gorunurdu). Sayfanin navi devirle birlikte
       iframe'den gelir. Gorsel hukum Enes'te. */
    const navBak = () => {
      const kalk = scrollY > 4;
      if (kalk !== navKalkti) { navKalkti = kalk; KOKE.classList.toggle('fl-nav-kalk', kalk); }
    };
    /* TUTUNMA (CSS fl-tutun): scrollY ray sonundaysa yapis sabitlenir —
       savurmada scrollY sonu gecip film geride kalinca yapis kacmasin.
       Scroll dinleyicisinde ESZAMANLI cagrilir (rAF bekleyen surumde
       kacis bir kare gorunurdu). */
    let tutundu = false, hazirlandi = false;
    const tutunBak = () => {
      const tut = devirBas > 0 && scrollY >= devirBas - 1;
      if (tut !== tutundu) { tutundu = tut; KOKE.classList.toggle('fl-tutun', tut); }
      /* ON HAZIRLIK: govdenin ilk boyamasi devir karesine binmesin
         (olculdu: 44-70 ms sistematik takilma). Ray sonuna 1,5 ekran
         kala hazirlanir, 3 ekran uzaklasinca birakilir (histerezis). */
      const haz = devirBas > 0 && scrollY >= devirBas - 1.5 * vh;
      if (haz !== hazirlandi && (haz || scrollY < devirBas - 3 * vh)) {
        hazirlandi = haz;
        KOKE.classList.toggle('fl-hazirla', haz);
        /* ESKI GIRIS GEC YUKLEME (Enes, 31 Agu): govde eski sitenin
           girisi; 845 KB'lik sayfa film boyunca inmesin, ilk hazirlikta
           insin. Perde bayragi ONCE yazilir — acilis torenini prolog
           filmi ustlendi, devirde eski #boot perdesi oynamaz (sitenin
           kendi 'oturumda bir kez' mekanizmasi). */
        const eski = document.getElementById('fl-eski') as HTMLIFrameElement | null;
        if (haz && eski && !eski.src) {
          try { sessionStorage.setItem('qanat-splash-seen', '1'); } catch {}
          eski.addEventListener('load', () => {
            KAYIT.eskiYuklendiMs = AN();
            /* ESKI SAYFANIN KENDI YUMUSAK-HAREKET ANAHTARI: t-mo-soft
               (noise+stars+tubes kapali — sitenin motion panel kipi).
               Olculdu: huzme canvas'i acikken devirin hizli fazinda
               15-20 dusen kare. Devir boyunca takili durur; tamYap
               kaldirir ve sayfa devralinca huzmeler kendi 1,8 s'lik
               gecisiyle dogar (__tubesInit — panelin kullandigi ayni
               kurulum cagrisi). Ayni origin; olmazsa sessiz gecilir. */
            try { eski.contentDocument?.documentElement.classList.add('t-mo-soft'); } catch {}
          }, { once: true });
          eski.src = eski.dataset.src || '/';
        }
      }
    };
    /* dortgenin o olcekteki ekran kenarlari (mikro ortalama dahil) */
    const kenarlar = (ss: number) => {
      const g = G!;
      const u = g.S > 1 ? Math.min(1, (ss - 1) / (g.S - 1)) : 1;
      const mx = g.cx + g.txSon * u, my = g.cy + g.tySon * u;
      return { sol: mx - g.qg * ss / 2, sag: mx + g.qg * ss / 2, ust: my - g.qh * ss / 2, alt: my + g.qh * ss / 2, u };
    };
    /* eski girisi canlandirma: etkilesim + huzmelerin dogusu. TV yolunda
       efektin SONUNA ertelenir — olculdu: __tubesInit parlama karesine
       binince efekt penceresinde 1-2 dusen kare uretiyordu. */
    const eskiCanlandir = () => {
      const eski = document.getElementById('fl-eski') as HTMLIFrameElement | null;
      if (!eski) return;
      eski.removeAttribute('aria-hidden'); eski.removeAttribute('tabindex');
      try {
        eski.contentDocument?.documentElement.classList.remove('t-mo-soft');
        (eski.contentWindow as any)?.__tubesInit?.();
      } catch {}
    };
    const tamYap = () => {
      if (!fadeAcik || KOKE.dataset.devir === 'tam') return;
      KOKE.dataset.devir = 'tam';
      if (KAYIT.tamMs === null) KAYIT.tamMs = AN();
      if (!tvFaz) eskiCanlandir();            /* sade yol; tv yolu faz3 sonunda */
    };
    /* capraz gecis FILM katmaninin fade-out'u (film.css katman duzeni) —
       bitis o katmanin transitionend'inden dinlenir */
    yapis.addEventListener('transitionend', (e) => { if (e.propertyName === 'opacity') tamYap(); });

    const devirKare = () => {
      devirRaf = 0;
      const f = (window as any).__fl;
      if (!f || !G) return;
      const simdi = AN();
      const dt = sonMs ? Math.min(100, simdi - sonMs) : 16.7;
      sonMs = simdi;
      /* video SON karesini gosteriyor mu (kareNo tavani: toplam - 1/fps) */
      const sonda = f.toplam - f.gosterilenT < 1 / f.fps;
      const uzak = f.toplam - f.gosterilenT > 2 / f.fps;      /* histerezis */
      if (!aktif && sonda) {
        /* DEVIR TETIGI: videonun icindeki buyume bu karede bitti; buyumeyi
           yay devralir. Ayni tikte nav geri iner (navBak asagida). */
        aktif = true;
        const tempo = Math.max(0, Math.min(3, f.hizT || 0));
        sv = DK.hiz * tempo;
        KAYIT.basMs = simdi; KAYIT.kareler.length = 0; KAYIT.iz.length = 0;
        /* onceki devrin (geri sarilmis) efekt kayitlari kalmasin — olculdu:
           isinmali kosumda tv.sonMs eski devirden kalinca sure negatif cikti */
        KAYIT.tv.basMs = KAYIT.tv.parlaMs = KAYIT.tv.acMs = KAYIT.tv.sonMs = null;
        KAYIT.kapanisYolu = null; KAYIT.ibareSonduMs = null;
        KAYIT.v0 = { video_1x: DK.hiz, tempo: +tempo.toFixed(4), video: +(DK.hiz * tempo).toFixed(7), bizim: +sv.toFixed(7), fark: 0 };
        KOKE.classList.add('fl-devir');
      }
      if (aktif) {
        if (uzak && fadeAcik && !tvFaz) {
          /* GERI: kullanici filmi geri sardi — sayfa cozulur, film gorunur.
             TV efekti SURERKEN girilmez (310 ms'lik koreografi bolunmez;
             bitince ayni dal calisir). */
          fadeAcik = false;
          KOKE.classList.remove('fl-devir-net', 'fl-tv-goster', 'fl-tv-ac', 'fl-tv-parla');
          delete KOKE.dataset.devir;
          KAYIT.fadeBasMs = null; KAYIT.tamMs = null;
        }
        if (uzak && !tvFaz && yapis.style.opacity !== '') yapis.style.opacity = '';   /* ortme kiricinin kalintisi */
        const hedefS = uzak && !tvFaz ? 1 : G.S;
        const k = DSERT, c = 2 * Math.sqrt(k);
        birikimD = Math.min(0.1, birikimD + dt / 1000);
        while (birikimD >= 0.004) {
          birikimD -= 0.004; sOnce = s;
          const a = -k * (s - hedefS) - c * sv;
          sv += a * 0.004; s += sv * 0.004;
          if (s < 1) { s = 1; if (sv < 0) sv = 0; }
        }
        const cizS = Math.max(1, sOnce + (s - sOnce) * (birikimD / 0.004));
        const kn = kenarlar(cizS);
        /* ---- EFEKT A · TV ACMA koreografisi (tek yazici: transform hep
           buradan cikar; cokus normal yazimin YERINE gecer) ---- */
        if (tvFaz === 1) {
          const kk = Math.min(1, (simdi - tvT0) / TV_COK_MS);
          const sy = Math.max(0.004, cizS * (1 - kk * kk));      /* ease-in cokus */
          yapis.style.transform = `translate3d(${(G.txSon * kn.u).toFixed(2)}px, ${(G.tySon * kn.u).toFixed(2)}px, 0) scale(${cizS.toFixed(5)}, ${sy.toFixed(5)})`;
          if (kk >= 1) {
            tvFaz = 2; tvT0 = simdi; KAYIT.tv.parlaMs = simdi;
            KOKE.classList.add('fl-tv-parla');
            KOKE.classList.add('fl-devir-net');
            tamYap();                                            /* film gizli; cizgi sahnede */
          }
        } else if (tvFaz === 2) {
          if (simdi - tvT0 >= TV_PARLA_MS) {
            tvFaz = 3; tvT0 = simdi; KAYIT.tv.acMs = simdi;
            KOKE.classList.add('fl-tv-ac');  /* paneller acilir, site belirir */
          }
        } else if (tvFaz === 3) {
          if (simdi - tvT0 >= TV_AC_MS + 10) {   /* +10: transition bitisi; +40 tamponu sureyi 350 sinirina dayiyordu (olculdu) */
            tvFaz = 0; KAYIT.tv.sonMs = simdi;
            KOKE.classList.remove('fl-tv-goster', 'fl-tv-ac', 'fl-tv-parla');
            setTimeout(eskiCanlandir, 40);     /* huzme kurulumu efekt penceresinin disinda */
          }
        } else {
          yapis.style.transform = `translate3d(${(G.txSon * kn.u).toFixed(2)}px, ${(G.tySon * kn.u).toFixed(2)}px, 0) scale(${cizS.toFixed(5)})`;
        }
        /* kayit penceresi: devir basindan EFEKT sonuna kadar (tv yolunda
           tamMs efektin ortasinda duser; pencere efektle biter) */
        const kayitBitti = KAYIT.tamMs !== null && (KAYIT.tv.basMs === null || KAYIT.tv.sonMs !== null);
        if (!kayitBitti && KAYIT.kareler.length < 900) { KAYIT.kareler.push(simdi); KAYIT.iz.push([+simdi.toFixed(1), +cizS.toFixed(6), +(AN() - simdi).toFixed(1)]); }
        /* CAPRAZ GECIS: dortgen goruntu alanini ortunce (en buyuk bosluk
           < KAPANMA_PX) gercek sayfa ustte netlesir. Kapanan eksen mikro
           ortalamayla iki kenardan birden kapanir; oteki eksen coktan
           tasmistir (S = max secimi), yani bosluk kalmamistir. */
        const bosluk = Math.max(kn.sol, vw - kn.sag, kn.ust, vh - kn.alt);
        /* ORTME KIRICI (olculdu: film tam opakken kompozitor alttaki
           govdeyi HIC boyamiyor — occlusion; ilk boyama fade karesine
           binip 40-78 ms yiyordu). Fade'e yaklasirken film opakligi
           gorunmez bicimde 0,996'ya iner: ortme kalkar, govde erken
           boyanir. Satir-ici deger fade aninda silinir ki sinifin 0'a
           gecisi (transition) devralsin. */
        if (!fadeAcik && hedefS === G.S && bosluk < KAPANMA_PX * 8 && yapis.style.opacity === '') yapis.style.opacity = '0.996';
        if (!fadeAcik && hedefS === G.S && bosluk < KAPANMA_PX) {
          fadeAcik = true;
          yapis.style.opacity = '';
          KAYIT.fadeBasMs = simdi;
          KAYIT.fadeGeo = {
            s: +cizS.toFixed(5), hedefS: +G.S.toFixed(5), kapanan: G.kapanan,
            bosluk_px: { sol: +kn.sol.toFixed(2), sag: +(vw - kn.sag).toFixed(2), ust: +kn.ust.toFixed(2), alt: +(vh - kn.alt).toFixed(2) },
            sayfa_transform: 'okunmadi',
          };
          /* getComputedStyle sicak kareden cikti (dusen kare olcumu):
             fade aninin sayfa olcegi bir sonraki gorev diliminde okunur. */
          const fg = KAYIT.fadeGeo;
          setTimeout(() => { fg.sayfa_transform = govde ? getComputedStyle(govde).transform : 'yok'; }, 0);
          if (!azaltMi() && tvEl) {
            /* EFEKT A: cokus baslar; paneller aninda sahnede (film hala
               her seyi ortuyor — gorunmez degisim), cizgi cokusle belirir */
            KAYIT.kapanisYolu = 'tv';
            tvFaz = 1; tvT0 = simdi; KAYIT.tv.basMs = simdi;
            KOKE.classList.add('fl-tv-goster');
          } else {
            /* SADE yol (hareket azaltma): flassiz duz sonumleme */
            KAYIT.kapanisYolu = 'sade';
            KOKE.classList.add('fl-devir-net');
            setTimeout(tamYap, FADE_MS + 80);          /* transitionend yedegi */
          }
        }
        /* oturma: hedefte ve durgun */
        if (Math.abs(s - hedefS) < 0.0004 && Math.abs(sv) < 0.004) {
          s = hedefS; sv = 0;
          if (hedefS === 1) {
            /* cozulme: transform kalkar, katmanlar normale doner */
            aktif = false; fadeAcik = false;
            yapis.style.transform = ''; yapis.style.opacity = '';
            KOKE.classList.remove('fl-devir', 'fl-devir-net');
            delete KOKE.dataset.devir;
            birikimD = 0;
          }
        }
      }
      navBak();
      tutunBak();
      /* dongu surme karari: devir oturup TAMAMLANDIYSA durur (pil);
         geri sarma scroll olayindan yeniden kurulur. Sona yakinken
         donmeye devam eder — tetik kaydirmasiz da gelebilir (yay/akis).
         TV efekti surerken durmaz (koreografi bu donguden surulur). */
      const oturduTam = aktif && s === G.S && sv === 0 && KAYIT.tamMs !== null && tvFaz === 0;
      if (!oturduTam && (aktif || (devirBas > 0 && scrollY > devirBas - 2 * vh))) devirTik();
      else sonMs = 0;
    };
    const devirTik = () => { if (!devirRaf) devirRaf = requestAnimationFrame(devirKare); };

    /* IBARE ARTIK HEP EKRANDA (1 Eyl, Enes): finalde-belirme + oturumda
       bir kez + ilk-girdide sonme + 250 ms yoklama mekanizmasi TUMDEN
       KALKTI — o kurgu ibareyi canlida hic gosterememisti ("ibare
       yazisini goremiyorum"). Ibare bastan gorunur, yalniz devirde
       soner (CSS). DEVIR IZLEYICISININ yoklamasi da gereksizlesti:
       tetik kaydirmasiz gelebilir (yay/akis) ama akis scrollBy yapar,
       scroll olayi devirTik'i zaten durtuyor; yayla varis ise scroll
       durduktan sonra en cok ~1 sn surer ve son scroll olayinda kurulan
       rAF dongusu (sona-yakin kosulu) o pencereyi zaten tasiyor. */
    olcDevir();
    addEventListener('scroll', () => { navBak(); tutunBak(); devirTik(); }, { passive: true });
    addEventListener('resize', () => { olcDevir(); tutunBak(); devirTik(); }, { passive: true });
    navBak(); tutunBak(); devirTik();
    /* OLCUM YUZEYI (olc-devir.cjs okur): kunye + geometri + yay durumu +
       devir penceresi kaydi (v0, fade/tam anlari, rAF zamanlari, olcek izi). */
    (window as any).__devir = {
      kunye: DK, sert: DSERT, fadeMs: FADE_MS, kapanmaPx: KAPANMA_PX,
      geo: () => G, s: () => s, hiz: () => sv, aktif: () => aktif,
      kayit: KAYIT, bas: () => devirBas, olc: olcDevir,
    };

      /* ---- EFEKT B · ISINLANMA (prologu gec; Enes, 31 Agu aksam) ----
         Efekt katmani videonun konumundan BAGIMSIZ: filmin basinda,
         ortasinda, sonunda ayni calisir — cunku ortu sayfanin ustune
         cizilir, sayfa dokuya cizilmez. Asil gecis isi (gecYap) efektin
         TEPESINDE kosulur: ekran tamamen ortuluyken takas gorunmez.
         Cizim ayri parcada (src/film/gecis.ts, motor emsali: J1 disi,
         bosta isitilir); modul inmemisse ya da hareket azaltma acikken
         SADE yol: flassiz duz sonumleme (ayni ortu, yalniz opaklik). */
      let gecisModul: { isinla: (o: { tepe: () => void; bitti: () => void; kareler?: number[] }) => void } | null = null;
      const bosta = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 300));
      bosta(() => { import('../film/gecis').then((m) => { gecisModul = m; (m as any).hazirla?.(); }).catch(() => {}); });
      const gecYap = () => {
        try { sessionStorage.setItem(ANAHTAR, '1'); } catch {}
        /* MOTOR SOKUMU SONRAKI DILIMDE (olculdu: sok'un 39 blob/revoke'u
           + yeniden duzen tek karede 25 ms'i asiyordu). Gorsel takas bu
           karede; sokum ortu HALA tam kapaliyken (~50 ms sonra, sonus
           150 ms'te basliyor) kosulur — izleyici iki isi de gormez. */
        setTimeout(sok, 50);
        KOKE.classList.remove('fl-js');
        /* devir ortasinda basilirsa devir/efekt kalintilari da sokulur */
        KOKE.classList.remove('fl-devir', 'fl-devir-net', 'fl-tutun', 'fl-nav-kalk',
          'fl-hazirla', 'fl-tv-goster', 'fl-tv-ac', 'fl-tv-parla');
        delete KOKE.dataset.devir;
        KOKE.dataset.film = 'atlandi';
        scrollTo(0, 0);                          /* isinlanma sitenin basina */
      };
      const sadeGec = (tepe: () => void, bitti: () => void) => {
        const ortu = document.createElement('div');
        ortu.style.cssText = 'position:fixed;inset:0;z-index:70;background:#050505;opacity:0;transition:opacity .12s ease';
        document.body.appendChild(ortu);
        requestAnimationFrame(() => { ortu.style.opacity = '1'; });
        setTimeout(() => {
          tepe();
          ortu.style.opacity = '0';
          setTimeout(() => { ortu.remove(); bitti(); }, 140);
        }, 140);
      };
      let gecKostu = false;
      const gec = bolum.querySelector<HTMLAnchorElement>('.fl-gec');
      gec?.addEventListener('click', (e) => {
        e.preventDefault();                      /* capa isini efekt ustlenir (JS'siz yol capayla kalir) */
        if (gecKostu) return;
        gecKostu = true;
        const kayitG = { basMs: AN(), tepeMs: null as number | null, sonMs: null as number | null, yol: '', kareler: [] as number[], execler: [] as number[] };
        KAYIT.gec = kayitG;
        const tepe = () => {
          kayitG.tepeMs = AN();
          /* BOZ: kirmizi kontrol — tepe karesinde ana is parcacigi 60 ms
             kilitlenir, dusen kare kapisi kirmiziya donmek ZORUNDA */
          if (BOZ) { const t0 = AN(); while (AN() - t0 < 60) { /* kasti */ } }
          gecYap();
        };
        const bitti = () => { kayitG.sonMs = AN(); };
        if (!azaltMi() && gecisModul) { kayitG.yol = 'isinlanma'; gecisModul.isinla({ tepe, bitti, kareler: kayitG.kareler, execler: kayitG.execler } as any); }
        else { kayitG.yol = 'sade'; sadeGec(tepe, bitti); }
      });
    }).catch((e) => {
      KOKE.classList.remove('fl-js');
      KOKE.dataset.film = 'motor-inmedi';
      console.warn('[film] motor inmedi', e);
    });
  } else if (bolum) {
    KOKE.dataset.film = 'hareket-azaltma';
  }
</script>
