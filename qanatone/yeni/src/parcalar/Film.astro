/* FILM · SCROLL-SCRUB ADASI — ISKELET (27 Agu 2026).
   39 klip tek zaman cizelgesine dikilir; kaydirma filmi oynatir
   (DEVIR-SPESIFIKASYONU §3, Secenek B: klipler ayri yuklenir, sinirda el
   degisimi — HIGGSFIELD motorunun multi-leg kurgusu, §5 esleme).
   Secenek A (tek mp4) BILEREK secilmedi: motor sozlesmesinin poster/klip
   basina degismezleri ve seri on-yukleme yalniz B'de anlamli; montaj-
   duzenek E7/E11 tek filmin yavas hatta sarmaya uygun olmadigini olctu.

   BU TURDA YOK (bilerek): hikaye metni · giris Q sahnesi · final devri.
   Motor nav/dugme/ipucu/baslik kurmaz (sert degismez #6) — sayfanin isi.

   SAYILAR DOM'A KUNYEDEN INER: sure/kare/bas `sahneler.ts` -> ffprobe.
   Tarayiciya kanon.json inmez; motor data-* okur.

   IKI YOL, AYNI MARKUP:
     JS + hareket acik  -> `<html class="fl-js">`, motor `import()` ile
                          iner, sahneler ust uste yapisik kare, yalniz
                          etkin + iki komsu yerlesik.
     hareket azaltma / JS yok -> motor HIC inmez, hicbir video fetch
                          edilmez (sert degismez: reduced-motion'da sifir
                          video); 39 poster duz sutun olarak okunur.
   `<video>` etiketlerinde src YOK: kaynak yalniz motor tarafindan Blob
   olarak verilir. Bu, V1'in ("veri derlemede piser") ruhuyla uyumlu:
   sayfa kendiliginden hicbir sey cekmez.

   POSTER <img>: yalniz ilk sahne eager (ilk boya), obur 38'i lazy — ve
   JS yolunda `display:none` sarmal icinde oldukları icin HIC INMEZ
   (prolog katmanlarinin dersi: gizli tembel gorsel istek atmaz). */
import '../stil/film.css';
import { SAHNELER, FPS, TOPLAM_SN, PX_SN, SERTLIK, SONUM, TAVAN, AKIS, MOMENT, HIZALA } from '../film/sahneler';
/* DEVIR KUNYESI (31 Agu 2026, v3): son karedeki ekran dortgeni + son kare
   BUYUME HIZI. ELLE YAZILMIYOR — `film/ekran-kose.cjs` iz modunun (f20db52)
   k119/k120 KOSE olcumunden turetiliyor. Kutu olcumu (ekran-dikdortgen.json)
   artik kullanilmiyor: oz-dogrulamasi kendisi "AYRISMADI" diyordu, kose
   olcumu ise dortgenin dikdortgenligini de (ic acilar 90 +- 0,3) kanitladi.
   Oran olarak tasinir: video `object-fit: cover` ile olceklendigi icin
   tasinabilir olan sey piksel degil orandir. */
import KOSE from '../../film/ekran-kose.json';

/* k119 + k120 yoksa DERLEME KIRMIZI: kunye olcumsuz kalamaz. (ekran-kose.cjs
   tek-kare modunda kosulursa dosyada `kare: 120` kalmaz — sessiz eskime
   yerine derleme burada durur.) */
const kareBul = (n: number) => (KOSE as any).kareler.find((k: any) => k.kare === n && k.kose);
const K120 = kareBul(120), K119 = kareBul(119);
if (!K120 || !K119) throw new Error('ekran-kose.json k119/k120 yok — devir künyesi ölçümsüz kalamaz (node yeni/film/ekran-kose.cjs iz modu, f20db52)');
/* dort koseden eksen-hizali dortgen: olcum ic acilari 90 +- 0,3 verdi,
   kose ciftlerinin ortalamasi dortgenin kendisidir (alt kenar +-4 px
   gurultulu, ortalama onu da yumusatir). */
const eksen = (k: any) => {
  const K = k.kose;
  return {
    sol: (K.solUst[0] + K.solAlt[0]) / 2, sag: (K.sagUst[0] + K.sagAlt[0]) / 2,
    ust: (K.solUst[1] + K.sagUst[1]) / 2, alt: (K.solAlt[1] + K.sagAlt[1]) / 2,
  };
};
const e120 = eksen(K120), e119 = eksen(K119);
const DEVIR = {
  sol: e120.sol / K120.W, ust: e120.ust / K120.H,
  gen: (e120.sag - e120.sol) / K120.W, yuk: (e120.alt - e120.ust) / K120.H,
  /* SON KARE HIZI: dortgen son karede hala buyuyor (k119->k120 genislik
     farki ~0,5 px/kare). 1x okumada olcek hizi (1/s) olarak tasinir;
     surucu bunu varis temposuyla carpar (hiz surekliligi). */
  hiz: ((e120.sag - e120.sol) - (e119.sag - e119.sol)) * FPS / (e120.sag - e120.sol),
};

/* PROLOG ANA SAYFAYA (3 Eyl 2026, ANAYASA istisna 4 'Prolog. Yeni'):
   sayfa='ana' -> film ana sayfanin ONUNDE; devir tamamlaninca (TV acilisi
   bitince) film katmani SOKULUR ve site normal akisa gecer (atlama yolunun
   sokumuyle ayni: sok + siniflar + scrollTo(0,0)). sayfa='film' -> /film
   olcum zemini, davranis DEGISMEDI (govde sabit katman, tubes). */
interface Props { dil?: 'tr' | 'en'; sayfa?: 'film' | 'ana' }
const { dil = 'tr', sayfa = 'film' } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');

/* TUR 5 v2 · ANLATI METNI (2 Eyl 2026 gece, Enes yeniden yazdi —
   v1'in alti cumlesi 113 saniyeye cok seyrek dusuyordu ve teklif duz
   soylenmiyordu). 21 metin blogu (18 vurus; 1/5/13 cift cumleli tek
   vurus) + 6 perde kunyesi, iki dil. Metin kaynagi:
   PROLOG-ANLATI-METNI.md (BIREBIR — #20 kilitli). PENCERELER ELLE
   SECILMEDI: vurus-harita.py, kamera-fark olcumunden DP ile; harita ve
   gerekceler yeni/film/TUR5-METIN-HARITASI.md. Gorunurlugu MOTOR surer
   (kaydirma konumuna bagli — geri sarilirsa geri gelir); kunyeler de
   ayni mekanizma (fl-soz sinifini paylasir), perde araligi boyunca
   surekli. RAKAM KAPISI KAPANDI (Enes, 1 Eyl dogrulamasi + 3 Eyl
   metin duzeltmesi): 33 km ve 300 m Gonabad'dan; "50 m'de kuyu"
   UYDURMA KESINLIKTI -> "yuzlerce dikey kuyu"; "3000 yil" yuvarlamaydi
   -> "iki bin bes yuz"; derinlestirme iddiasi dogrulanamadi -> "bakimi
   birakilirsa dolar"; #20 pompa cumlesi yeniden yazildi. Kaynak satiri
   .fl-kaynak (son perde). Ayrinti: PROLOG-ANLATI-METNI.md "RAKAMLAR". */
const SOZLER = [
  { bas: 0.30, son: 3.90, tr: 'Su dağın altında. Şehir çölün ortasında. Arada otuz üç kilometre kaya.', en: 'The water is under the mountain. The city is in the middle of the desert. Thirty-three kilometres of rock between them.' },
