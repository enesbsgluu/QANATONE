/* IS B (3 Eyl 2026, Enes): VI PERDESININ RAYI YEREL YAVASLAR — film
   ayni hizda akar ama ayni film-sn icin 1,4 kat kaydirma gerekir.
   k SECIMI OLCUMLE: tur kapisi (<=120 sn) k<=1,5'e sinirlar (ek yol
   (k-1)*28,2sn*450px / ~1035px-s tur temposu); 900 px/s okunurluk
   kapisi k=1,4 + 4,4 sn pencereyle saglaniyor (olc-soz vi_okunurluk).
   Ray yuksekligi sanal sureyle buyur (--fl-sn); motor parcali haritayi
   data-yavas'tan okur (bas,son,k — film-sn). */
const YAVAS = { bas: 228.43, son: TOPLAM_SN, k: 1.4 };
const RAY_SN = +(TOPLAM_SN + (YAVAS.k - 1) * (YAVAS.son - YAVAS.bas)).toFixed(3);

/* ALTYAZI TEMASI (4 Eyl 2026, Enes onayli yapi — referans altyazi-son.html):
   perde kunyesi ARTIK AYRI SUREKLI KATMAN DEGIL, her blogun ilk satiri
   (sol ustteki surekli kunye KALKTI). Araliklar yalniz blogun hangi
   perdeye dustugunu secmek icin durur; kunye blokla gelir, blokla gider.
   Blok yapisi (yukaridan asagi, ortalanmis): kunye · kizil cizgi · satirlar
   (her satir kendi overflow:hidden maskesinde) — stil film.css. */
const KUNYELER = [
  { bas: 0.30, son: 13.08, tr: 'I · KAYNAK · 0 km · yüzeyden 300 m', en: 'I · THE SOURCE · 0 km · 300 m below' },
  { bas: 13.38, son: 53.29, tr: 'II · İKİ YOL · 0 km · 300 m', en: 'II · TWO WAYS · 0 km · 300 m' },
  { bas: 53.59, son: 88.59, tr: 'III · EĞİM · 8 km · 210 m · 1:1000', en: 'III · THE GRADIENT · 8 km · 210 m · 1:1000' },
  { bas: 88.89, son: 121.84, tr: 'IV · KANAL', en: 'IV · THE CHANNEL' },
  { bas: 122.14, son: 228.43, tr: 'V · ÖLÇEK · 33 km', en: 'V · SCALE · 33 km' },
  { bas: 228.73, son: 256.64, tr: 'VI · KENT · 33 km · yüzey', en: 'VI · THE CITY · 33 km · surface' },
];
const kunyeBul = (z: { bas: number }) => {
  const k = KUNYELER.find((p) => z.bas >= p.bas - 0.01 && z.bas <= p.son);
  if (!k) throw new Error(`blok ${z.bas} hicbir perdeye dusmuyor — kunyesiz blok olamaz`);
  return k;
};
/* SATIRLAMA: satir cumledir. Cok cumleli blok EN DENGELI noktadan iki
   satira bolunur (karakter farki en az); tek cumle tek satir (dar
   ekranda kendi maskesinin icinde sarar). Metin BIREBIR kalir — bolme
   yalniz cumle sinirinda, PROLOG-ANLATI-METNI.md kaynagi degismez.
   Kelime kelime DEGIL (talimat: kelime basina oge + bulaniklik elendi). */
const satirla = (m: string): string[] => {
  const c = (m.match(/[^.!?]+[.!?]+(?=\s|$)/g) || [m]).map((s) => s.trim()).filter(Boolean);
  if (c.length < 2) return [m];
  let enIyi = 1, fark = Infinity;
  for (let i = 1; i < c.length; i++) {
    const f = Math.abs(c.slice(0, i).join(' ').length - c.slice(i).join(' ').length);
    if (f < fark) { fark = f; enIyi = i; }
  }
  return [c.slice(0, enIyi).join(' '), c.slice(enIyi).join(' ')];
};
