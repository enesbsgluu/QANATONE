---
/* ANA SAYFA (Faz 2) — storyboard: iddia → kayıp → mekanizma → kanıt →
   süreç → sektör → araç → çağrı. Her sahne kendi bileşeni; hareket
   bütçesi ve görünürlük sözleşmesi yeni/denetim.cjs H ailesinde. */
import '../stil/font.css';
import '../stil/ana.css';
import Temel from '../layouts/Temel.astro';
