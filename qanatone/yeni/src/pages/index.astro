---
/* ANA SAYFA (Faz 2) — storyboard: iddia → kayıp → mekanizma → kanıt →
   süreç → sektör → araç → çağrı. Her sahne kendi bileşeni; hareket
   bütçesi ve görünürlük sözleşmesi yeni/denetim.cjs H ailesinde. */
import '../stil/ana.css';
import Temel from '../layouts/Temel.astro';
import S1Acilis from '../sahneler/S1Acilis.astro';
import S2Kayip from '../sahneler/S2Kayip.astro';
import S3Mekanizma from '../sahneler/S3Mekanizma.astro';
import S4Kanit from '../sahneler/S4Kanit.astro';
import S5Surec from '../sahneler/S5Surec.astro';
import S6Sektor from '../sahneler/S6Sektor.astro';
import S7Arac from '../sahneler/S7Arac.astro';
import S8Cagri from '../sahneler/S8Cagri.astro';
import { KOK } from '../icerik';
---
<Temel dil="tr" baslik="QANATONE — Talebi yakalayan sistem"
  aciklama="Talep var, yakalayan yok. QANATONE gelen talebi yakalayan sistemi kurar: SEO, GEO, reklam ve yapay zekâ otomasyonu tek ölçüm altında."
  canonical={`${KOK}/`} heleftr={`${KOK}/`} helefen={`${KOK}/en`}>
  {/* Govde fontu on yuklenir: `font-display:optional` engelleme
      penceresi ~100 ms, on yukleme tam o pencereyi kazandirir. */}
  <link slot="bas" rel="preload" as="font" type="font/woff2" crossorigin
    href="/yeni/font/nunito-sans-latin.woff2" />
  <div class="ana">
    <S1Acilis />
    <S2Kayip />
    <S3Mekanizma />
    <S4Kanit />
    <S5Surec />
    <S6Sektor />
    <S7Arac />
    <S8Cagri />
  </div>
</Temel>
