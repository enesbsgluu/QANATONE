  canonical={`${KOK}/`} heleftr={`${KOK}/`} helefen={`${KOK}/en`}>
  <link slot="bas" rel="preload" as="font" type="font/woff2" crossorigin
    href="/yeni/font/playfair-display-600-latin.woff2" />
  <link slot="bas" rel="preload" as="font" type="font/woff2" crossorigin
    href="/yeni/font/manrope-400-latin.woff2" />
  <div class="ana">
    <S1Acilis />
  </div>
</Temel>
