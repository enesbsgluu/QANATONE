---
/* Yazı sayfaları (TR). Şema rota turu kapanışında @graph'a çevrildi:
   eski taraf üçlü + Article (dateModified/author/image/mainEntityOfPage
   dahil) + BreadcrumbList basıyordu, Faz 1 tekil Article yazmıştı —
   parite açığıydı (yaziSema). */
import { getCollection } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import YaziGovde from '../../parcalar/YaziGovde.astro';
import { icerik, T, KOK, kes, basAd, sl } from '../../icerik';
import { yaziSema } from '../../sema.mjs';

export async function getStaticPaths() {
  return (await getCollection('yazilar')).map(e => ({ params: { slug: e.id }, props: { p: e.data } }));
}
const { p } = Astro.props;
const canon = sl(`${KOK}/bulten/${p.slug}`);
const baslik = basAd(p.title);
const aciklama = kes(p.lede);
const sema = yaziSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'tr' }, p);
---
<Temel dil="tr" baslik={baslik}
  aciklama={aciklama} canonical={canon}
  heleftr={canon} helefen={sl(`${KOK}/en/bulten/${p.slug}`)}
  sema={sema} etiket="BÜLTEN">
  <YaziGovde p={p} dil="tr" />
</Temel>
