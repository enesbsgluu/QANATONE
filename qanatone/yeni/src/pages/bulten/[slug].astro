---
/* Yazı sayfaları (TR) — Article şeması mevcut sözleşmeye eşdeğer. */
import { getCollection } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import YaziGovde from '../../parcalar/YaziGovde.astro';
import { T, KOK, kes, basAd } from '../../icerik';

export async function getStaticPaths() {
  return (await getCollection('yazilar')).map(e => ({ params: { slug: e.id }, props: { p: e.data } }));
}
const { p } = Astro.props;
const canon = `${KOK}/bulten/${p.slug}`;
const sema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: T(p.title), description: T(p.lede).slice(0, 300),
  datePublished: p.date, inLanguage: 'tr', url: canon,
  publisher: { '@id': `${KOK}/#org` }
};
---
<Temel dil="tr" baslik={basAd(p.title)}
  aciklama={kes(p.lede)} canonical={canon}
  heleftr={canon} helefen={`${KOK}/en/bulten/${p.slug}`}
  sema={sema} etiket="BÜLTEN">
  <YaziGovde p={p} dil="tr" />
</Temel>
