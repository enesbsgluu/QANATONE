---
/* Bülten dizini (TR) — rota turu. Rota adı eskiyle BİREBİR (/bulten +
   /bulten/<slug>; detaylar Faz 1'den beri bu adta). Baş sözleşmesi eski
   /bulten ile eşdeğer (S1): title/desc kök ROUTER.PAGES.bulten'den
   birebir. Şema eski üçlü @graph + ItemList (bilinçli süperküme,
   bultenDizinSema). Bekçisi R4. */
import Temel from '../../layouts/Temel.astro';
import BolumDizin from '../../parcalar/BolumDizin.astro';
import { icerik, KOK, sl } from '../../icerik';
import { bultenDizinSema } from '../../sema.mjs';
import { SAYFA_BOYU, bolumDilimi } from '../../sayfalama';

const canon = sl(`${KOK}/bulten`);
const baslik = 'Bülten — QANATONE';
const aciklama = 'Yapay zekâ, arama ve talep yönetiminde işine dokunan gelişmeler.';
const { yazilar: semaDilim, bas: semaBas } = await bolumDilimi('yazilar', { sayfa: 1, konu: '' });
const sema = bultenDizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'tr', sayfaNo: 1, sayfaBoyu: SAYFA_BOYU }, semaDilim, semaBas);
---
<Temel genis dil="tr" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={canon} helefen={sl(`${KOK}/en/bulten`)} sema={sema}
  etiket="Bülten">
  <BolumDizin dil="tr" />
</Temel>
