---
/* KONU ARSIVI · 2. VE SONRAKI SAYFALAR (TR) — `/bulten/konu/<k>/sayfa/<n>`.
   Gerekce ve kapi notlari `../[k].astro` icinde. 1. sayfa BURADA
   URETILMEZ: o `/bulten/konu/<k>`. Kanonik kendine. */
import Temel from '../../../../../layouts/Temel.astro';
import BolumDizin from '../../../../../parcalar/BolumDizin.astro';
import { icerik, KOK, sl } from '../../../../../icerik';
import { bultenDizinSema } from '../../../../../sema.mjs';
import { konuSayfaYollari, SAYFA_BOYU, bolumDilimi } from '../../../../../sayfalama';
import { konuAdi } from '../../../../../konular';

export async function getStaticPaths() {
  return await konuSayfaYollari();
}

const { k, n } = Astro.params;
const konu = String(k);
const sayfa = Number(n);
const ad = konuAdi(konu, 'tr');
const canon = sl(`${KOK}/bulten/konu/${konu}/sayfa/${sayfa}`);
const baslik = `${ad} — Sayfa ${sayfa} — Bülten — QANATONE`;
/* 9 Eyl 2026 · 1.000 yazılık ölçekte ölçüldü: bu satır 1. sayfanın
   açıklamasını KISALTIYORDU (`${ad} başlığında yazdıklarımız — sayfa N.`)
   ve dört konu etiketinin dördü de S1'in 50 karakterlik tabanına
   dayanıyordu — "Sektör verisi"nde 49 çıkıp kırmızı yandı. Kusur ancak
   bir konunun 13. yazısında doğduğu için 6 yazılık bugünkü sitede
   görünmüyordu. Kural: sayfa N açıklaması 1. sayfanınkinin AYNISI +
   sayfa numarası (öteki bölümlerin hepsi zaten böyle yapıyor). */
const aciklama = `${ad} başlığında yazdıklarımız: yapay zekâ, arama ve talep yönetiminde işine dokunan gelişmeler. Sayfa ${sayfa}.`;
const { yazilar: semaDilim, bas: semaBas } = await bolumDilimi('yazilar', { sayfa: sayfa, konu: konu });
const sema = bultenDizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'tr', konu, sayfaNo: sayfa, sayfaBoyu: SAYFA_BOYU }, semaDilim, semaBas);
---
<Temel genis dil="tr" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={canon} helefen={sl(`${KOK}/en/bulten/konu/${konu}/sayfa/${sayfa}`)} sema={sema}
  etiket="Bülten">
  <BolumDizin dil="tr" konu={konu} sayfa={sayfa} />
</Temel>
