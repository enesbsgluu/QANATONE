---
/* SEKTÖR ARŞİVİ (EN) — `/en/sektor/<k>` · Enes, 9 Eyl 2026:
   "hangi yazı hangi sektörde… o sektöre yerleşmeli, böylece içeriğin ne
   içeriği olduğu bilinir".

   BÖLÜM ÜSTÜ KESİT: bülten, nedir ve haber içeriği bir arada. Konu
   arşivi (`/bulten/konu/<k>`) bir bölümün İÇİNDE süzer; sektör arşivi
   bölümleri AŞAR. `/sektor/` adı bu iş için bilinçli boş tutulmuştu —
   çip arşivleri `/bulten/konu/` altına konurken alınan karar.

   Yalnız İÇERİĞİ OLAN sektörün sayfası üretilir: boş bir sektör
   sayfası Google'a ince içerik sunmak olurdu. Kanonik kendine.
   Bekçi: T14. */
import Temel from '../../../layouts/Temel.astro';
import SektorDizin from '../../../parcalar/SektorDizin.astro';
import { icerik, T, KOK, sl } from '../../../icerik';
import { sektorYollari, sektorDilim } from '../../../sayfalama';
import { sektorDizinSema } from '../../../sema.mjs';

export async function getStaticPaths() {
  return await sektorYollari();
}

const { k } = Astro.params;
const anahtar = String(k);
const kayit = (icerik.sectors || []).find((s) => String(s.k) === anahtar) || {};
const ad = T(kayit.n, 'en') || anahtar;
const canon = sl(`${KOK}/en/sektor/${anahtar}`);
const baslik = `${ad} — Sector — QANATONE`;
/* Composed from the sector name — NOT `sectors[].d`, which holds the
   homepage pain-point line, not a description. See the TR twin. */
const aciklama = `${ad} sector coverage — bulletin, explainers and news together. With numbers.`;
const dilim = await sektorDilim(anahtar, 1);
const sema = sektorDizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'en' }, dilim.gorunen, dilim.bas);
---
<Temel genis dil="en" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={sl(`${KOK}/sektor/${anahtar}`)} helefen={sl(`${KOK}/en/sektor/${anahtar}`)} sema={sema}
  etiket="Sector">
  <SektorDizin dil="en" k={anahtar} />
</Temel>
