---
/* EN ANA SAYFA — TR ana sayfanın aynı sahne dizisi, dil='en'.
   Kuruluş gerekçesi: rota kapanış envanterindeki son kaçak sınıfı
   (13× '/en#iletisim' + 1× '/en#lead') bu sayfaya bağlanıyordu; ada
   kurulunca hepsi ${B}/en'e döndü. Sahne anlatıları (S2/S3/S5) TR
   metnin sadık çevirisi — kendi dosyalarında iki dil yan yana.
   Perde dil-bağımsız (QANATONE harfleri) ve eski /en'de de vardı.
   Baş sözleşmesi TR ana sayfanın EN karşılığı; eski PAGES.home EN desc
   25 karakterdi (S1 tabanı altı), TR'deki tam cümlenin çevirisi
   kullanıldı. NOT: H ailesi bekçileri (H1-H23, gzip/JS tavanları)
   yalnız TR ana sayfayı ölçer — EN'e genişletilmesi ayrı iş, raporda. */
import '../../stil/ana.css';
import Temel from '../../layouts/Temel.astro';
import SHHero from '../../sahneler/SHHero.astro';
import STSerit from '../../sahneler/STSerit.astro';
import SPDeste from '../../sahneler/SPDeste.astro';
import STETespit from '../../sahneler/STETespit.astro';
import SSBSozBandi from '../../sahneler/SSBSozBandi.astro';
import SKUKurucu from '../../sahneler/SKUKurucu.astro';
import SILIletisim from '../../sahneler/SILIletisim.astro';
import { KOK, icerik } from '../../icerik';
import { anaSema } from '../../sema.mjs';

const BASLIK = 'QANATONE — The system that catches demand';
const ACIKLAMA = 'Demand exists; nothing catches it. QANATONE builds the system that does: SEO, GEO, ads and AI automation under one measurement.';
const sema = anaSema(icerik, { url: `${KOK}/en`, ad: BASLIK, aciklama: ACIKLAMA, dil: 'en' });
---
<Temel dil="en" baslik={BASLIK} aciklama={ACIKLAMA} sema={sema}
  canonical={`${KOK}/en`} heleftr={`${KOK}/`} helefen={`${KOK}/en`}>
  {/* Ön yükleme TR ana sayfayla aynı — yüzler latin altkümesi,
      dil-bağımsız; gerekçeler orada. */}
  <link slot="bas" rel="preload" as="font" type="font/woff2" crossorigin
    href="/yeni/font/uncut-sans-latin.woff2" />
  <link slot="bas" rel="preload" as="font" type="font/woff2" crossorigin
    href="/yeni/font/playfair-display-500-latin.woff2" />
  <link slot="bas" rel="preload" as="font" type="font/woff2" crossorigin
    href="/yeni/font/playfair-display-500i-latin.woff2" />
  {/* PERDE artik KABUKTA (Temel.astro, 4 Eyl sokum turu): eski sitede 58
      sayfanin hepsindeydi; film sayfasi haric her sayfada. */}
  <div class="ana">
    {/* TUR 9 (3 Eyl 2026, Enes): eski duzen — anlati sahneleri ve R13'un
        dort bolumu kalkti; sira TR ana sayfayla ayni. */}
    <SHHero dil="en" />
    <STSerit dil="en" />
    <SPDeste dil="en" />
    <STETespit dil="en" />
    <SSBSozBandi dil="en" />
    <SKUKurucu dil="en" />
    <SILIletisim dil="en" />
  </div>
</Temel>
