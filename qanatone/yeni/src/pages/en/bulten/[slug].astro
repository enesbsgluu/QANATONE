---
/* Yazı sayfaları (EN). */
import { getCollection } from 'astro:content';
import Temel from '../../../layouts/Temel.astro';
import YaziGovde from '../../../parcalar/YaziGovde.astro';
import { T, KOK, kes, basAd } from '../../../icerik';

export async function getStaticPaths() {
  return (await getCollection('yazilar')).map(e => ({ params: { slug: e.id }, props: { p: e.data } }));
}
const { p } = Astro.props;
const canon = `${KOK}/en/bulten/${p.slug}`;
const sema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: T(p.title, 'en'), description: T(p.lede, 'en').slice(0, 300),
  datePublished: p.date, inLanguage: 'en', url: canon,
  publisher: { '@id': `${KOK}/#org` }
};
---
<Temel dil="en" baslik={basAd(p.title, 'en')}
  aciklama={kes(p.lede, 'en')} canonical={canon}
  heleftr={`${KOK}/bulten/${p.slug}`} helefen={canon}
  sema={sema} etiket="NEWSLETTER">
  <YaziGovde p={p} dil="en" />
</Temel>
