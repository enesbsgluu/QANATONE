---
/* Konu arşivi (EN) — TR eşinin aynısı, dil='en'. Gerekçe TR eşinde. */
import Temel from '../../../../layouts/Temel.astro';
import BolumDizin from '../../../../parcalar/BolumDizin.astro';
import { icerik, KOK, sl } from '../../../../icerik';
import { bultenDizinSema } from '../../../../sema.mjs';
import { konuYollari, SAYFA_BOYU } from '../../../../sayfalama';
import { konuAdi } from '../../../../konular';

export async function getStaticPaths() {
  return await konuYollari();
}

const { k } = Astro.params;
const konu = String(k);
const ad = konuAdi(konu, 'en');
const canon = sl(`${KOK}/en/bulten/konu/${konu}`);
const baslik = `${ad} — Bulletin — QANATONE`;
const aciklama = `What we write under ${ad}: what is changing in AI, search and demand handling — with the sources.`;
const sema = bultenDizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'en', konu, sayfaNo: 1, sayfaBoyu: SAYFA_BOYU });
---
<Temel genis dil="en" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={sl(`${KOK}/bulten/konu/${konu}`)} helefen={canon} sema={sema}
  etiket="Bulletin">
  <BolumDizin dil="en" konu={konu} />
</Temel>
