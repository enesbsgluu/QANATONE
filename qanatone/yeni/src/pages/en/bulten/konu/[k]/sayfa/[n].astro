---
/* Konu arşivi · 2. ve sonraki sayfalar (EN). Gerekçe TR eşinde. */
import Temel from '../../../../../../layouts/Temel.astro';
import BolumDizin from '../../../../../../parcalar/BolumDizin.astro';
import { icerik, KOK, sl } from '../../../../../../icerik';
import { bultenDizinSema } from '../../../../../../sema.mjs';
import { konuSayfaYollari, SAYFA_BOYU } from '../../../../../../sayfalama';
import { konuAdi } from '../../../../../../konular';

export async function getStaticPaths() {
  return await konuSayfaYollari();
}

const { k, n } = Astro.params;
const konu = String(k);
const sayfa = Number(n);
const ad = konuAdi(konu, 'en');
const canon = sl(`${KOK}/en/bulten/konu/${konu}/sayfa/${sayfa}`);
const baslik = `${ad} — Page ${sayfa} — Bulletin — QANATONE`;
const aciklama = `What we write under ${ad} — page ${sayfa}.`;
const sema = bultenDizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'en', konu, sayfaNo: sayfa, sayfaBoyu: SAYFA_BOYU });
---
<Temel genis dil="en" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={sl(`${KOK}/bulten/konu/${konu}/sayfa/${sayfa}`)} helefen={canon} sema={sema}
  etiket="Bulletin">
  <BolumDizin dil="en" konu={konu} sayfa={sayfa} />
</Temel>
