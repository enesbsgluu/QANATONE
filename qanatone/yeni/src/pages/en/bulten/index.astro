---
/* Bülten dizini (EN) — aynı gövde parçası, dil='en'. */
import Temel from '../../../layouts/Temel.astro';
import BolumDizin from '../../../parcalar/BolumDizin.astro';
import { icerik, KOK, sl } from '../../../icerik';
import { bultenDizinSema } from '../../../sema.mjs';
import { SAYFA_BOYU } from '../../../sayfalama';

const canon = sl(`${KOK}/en/bulten`);
const baslik = 'Bulletin — QANATONE';
const aciklama = 'What is changing in AI, search and demand handling — with the sources.';
const sema = bultenDizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'en', sayfaNo: 1, sayfaBoyu: SAYFA_BOYU });
---
<Temel genis dil="en" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={sl(`${KOK}/bulten`)} helefen={canon} sema={sema}
  etiket="Bulletin">
  <BolumDizin dil="en" />
</Temel>
