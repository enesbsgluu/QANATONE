---
/* Explainers yazısı (EN) — `/en/nedir/<slug>`.
   Gövde bültenle AYNI bileşen (`YaziGovde`), `bolum` propuyla: geri
   bağı, kart yolları ve "diğer yazılar" şeridi o bölümün kendi
   koleksiyonundan doğar. Şerit tavanı 8 (T10). */
import Temel from '../../../layouts/Temel.astro';
import YaziGovde from '../../../parcalar/YaziGovde.astro';
import { icerik, T, KOK, sl, yaziBas } from '../../../icerik';
import { yaziSema } from '../../../sema.mjs';
import { bolumYaziYollari } from '../../../sayfalama';

export async function getStaticPaths() {
  return await bolumYaziYollari('nedir');
}

const { p } = Astro.props;
const canon = sl(`${KOK}/en/nedir/${p.slug}`);
const { baslik, aciklama } = yaziBas(p, 'en');
/* 15 Eyl 2026: arguman sirasi duzeldi (sayfa, yazi) — once TERSti ve Article
   basligi bos, @id "undefined#article" basiliyordu. Breadcrumb bolumu buradan. */
const sema = yaziSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'en', dizin: '/nedir', bolumAd: 'Explainers' }, p);
---
<Temel dil="en" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={sl(`${KOK}/nedir/${p.slug}`)} helefen={sl(`${KOK}/en/nedir/${p.slug}`)} sema={sema}
  etiket="Explainers">
  <YaziGovde p={p} dil="en" bolum="nedir" />
</Temel>
