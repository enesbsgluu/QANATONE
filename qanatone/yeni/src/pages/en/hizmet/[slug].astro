---
/* 9 hizmet sayfası (EN) — aynı gövde parçası, dil='en'. */
import { getCollection } from 'astro:content';
import Temel from '../../../layouts/Temel.astro';
import HizmetGovde from '../../../parcalar/HizmetGovde.astro';
import { T, KOK, kes, basAd } from '../../../icerik';

export async function getStaticPaths() {
  return (await getCollection('hizmetler')).map(e => ({ params: { slug: e.id }, props: { s: e.data } }));
}
const { s } = Astro.props;
const canon = `${KOK}/en/hizmetler/${s.slug}`;
const sema = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: T(s.title, 'en'), description: T(s.text, 'en').slice(0, 300),
  url: canon, inLanguage: 'en',
  provider: { '@id': `${KOK}/#org` }
};
---
<Temel dil="en" baslik={basAd(s.det.h, 'en')}
  aciklama={kes(s.text, 'en')} canonical={canon}
  heleftr={`${KOK}/hizmetler/${s.slug}`} helefen={canon}
  sema={sema} etiket={s.tag}>
  <HizmetGovde s={s} dil="en" />
</Temel>
