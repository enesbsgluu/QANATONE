---
/* News dizini · 2. ve sonraki sayfalar (EN). 1. sayfa
   `/en/haber`; `/sayfa/1` bilinçli YOK (kopya içerik). Kanonik
   kendine. Gerekçe: `../[...kok].astro`. */
import Temel from '../../../../layouts/Temel.astro';
import BolumDizin from '../../../../parcalar/BolumDizin.astro';
import { icerik, KOK, sl } from '../../../../icerik';
import { bultenDizinSema } from '../../../../sema.mjs';
import { bolumSayfaYollari, SAYFA_BOYU, bolumDilimi } from '../../../../sayfalama';

export async function getStaticPaths() {
  return await bolumSayfaYollari('haberler');
}

const { n } = Astro.params;
const sayfa = Number(n);
const canon = sl(`${KOK}/en/haber/sayfa/${sayfa}`);
const baslik = `News — Page ${sayfa} — QANATONE`;
const aciklama = `What is happening in AI, search and digital marketing — with the sources. Page ${sayfa}.`;
const { yazilar: semaDilim, bas: semaBas } = await bolumDilimi('haberler', { sayfa: sayfa, konu: '' });
const sema = bultenDizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'en', sayfaNo: sayfa, sayfaBoyu: SAYFA_BOYU, dizin: '/haber', tip: 'Article' }, semaDilim, semaBas);
---
<Temel genis dil="en" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={sl(`${KOK}/haber/sayfa/${sayfa}`)} helefen={sl(`${KOK}/en/haber/sayfa/${sayfa}`)} sema={sema}
  etiket="News">
  <BolumDizin dil="en" bolum="haberler" sayfa={sayfa} />
</Temel>
