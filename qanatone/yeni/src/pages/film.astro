---
/* FILM ISKELETI — /yeni/film (27 Agu 2026).
   39 kliplik scroll-scrub adasinin OLCUM ZEMINI; urun sayfasi degil.
   DEVIR-SPESIFIKASYONU'nun tam kurgusu (giris Q sahnesi + film + final
   devri) ana sayfaya oturacak; bu sayfa yalniz motor/dikis/butce/savurma
   olcumleri icin var. Hikaye metni yok, giris yok, devir yok — bilerek.
   Canonical deneme-react deseni: canli kokte karsiligi yok -> kendine;
   noindex kabuk geneli; sitemap/R8 disinda (KOK'suz canonical). */
import Temel from '../layouts/Temel.astro';
import Film from '../parcalar/Film.astro';
import EskiGiris from '../parcalar/EskiGiris.astro';
const canon = 'https://qanatone.netlify.app/yeni/film';
---
{/* GOVDE = ESKI SITENIN GIRISI (31 Agu 2026, Enes): "Videonun son sahnesi
    eski — yani ilk versiyon — sitenin giris goruntusu. O siteye oturt.
    Siteyi yeni haline getirirken o versiyonu kullanacagiz zaten."
    GECE TUR 2 (birlesme): iframe SOKULDU. Govde artik EskiGiris —
    eski sitenin nav+hero'su DERLEMEDE kokten cekilip Shadow DOM'a
    gomuluyor (kopya degil kaynaga bagli; ayrinti EskiGiris.astro).
    Boot perdesi/oturum bayragi gereksizlesti (perde gomulmedi);
    tubes devir tamamlaninca surucuden baslatilir. */}
<Temel dil="tr" baslik="Film iskeleti — QANATONE"
  aciklama="Prolog filminin 39 kliplik scroll-scrub iskeleti; motor, dikiş, bütçe ve savurma ölçüm zemini. Ürün sayfası değildir."
  canonical={canon}>
  <h1 class="fl-gizli">Film iskeleti</h1>
  {/* GIRIS SAHNESI SOKULDU (1-2 Eyl 2026 gece, Enes karari; 2 Eyl
      talimatiyla KALICI): amblem prologu (dag sahnesi + logonun nav'a
      yukselip oturmasi, PRDag + halka.ts zinciri) once sayfadan, sonra
      KAYNAKTAN cikti — "Direkt video girisiyle baslayacak ve hikaye
      anlatisi baslayacak." Akis: video girisi (yukleme tamponu motorda,
      amblemsiz) -> film (hikaye metinleri TUR 5) -> TV kapanisi ->
      site. Kalici bekci: denetim R23. src/prolog/ yalniz amblem.json
      tasir (nav logosu kaynagi, R19). */}
  <Film dil="tr" />
  <div class="fl-govde" id="fl-govde">
    <EskiGiris />
  </div>
</Temel>

<style>
  /* baslik belge agaci icin var, gorunmez (metin yok karari) */
  .fl-gizli { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); margin: -1px; }
</style>
