---
/* Yeni kabuğun 404'ü. Kesmeye (Faz 4) kadar Netlify'ın 404'ü eski
   sitede kalır; bu sayfa dist/yeni/404.html olarak hazır bekler. */
import Temel from '../layouts/Temel.astro';
const canon = 'https://qanatone.netlify.app/yeni/404';
---
<Temel dil="tr" baslik="Sayfa bulunamadı — QANATONE"
  aciklama="Aradığın sayfa burada değil. Ana sayfadan ya da hizmetlerden devam edebilirsin."
  canonical={canon}>
  <div class="b404">
    <b>404</b>
    <h1>Bu sayfa burada değil</h1>
    <p class="lede" style="margin:12px auto 24px">Adres değişmiş ya da hiç var olmamış olabilir.</p>
    <a class="dugme" href="/">Ana sayfaya dön</a>
  </div>
</Temel>
