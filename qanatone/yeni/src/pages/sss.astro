---
/* SSS (TR) — rota turu. Rota adı eskiyle BİREBİR (/sss). Baş sözleşmesi
   eski ROUTER.PAGES.sss'ten; desc 47 karakterdi (S1 tabanı 50 altı,
   ölçüldü) — soru sayısından türetilen kuyrukla uzatıldı, bilinçli
   süperküme (hizmetler EN desc kararının aynısı; sayı veriden gelir,
   panel soru ekleyince kendiliğinden günceldir). Şema eski üçlü @graph
   + FAQPage birebir (sssSema). Bekçisi R5. */
import Temel from '../layouts/Temel.astro';
import SssGovde from '../parcalar/SssGovde.astro';
import { icerik, KOK, sl } from '../icerik';
import { sssSema } from '../sema.mjs';

const canon = sl(`${KOK}/sss`);
const baslik = 'Sık sorulan sorular — QANATONE';
const aciklama = `Fiyat, süre, sözleşme hakkında dürüst cevaplar. En çok sorulan ${(icerik.faq || []).length} sorunun net karşılığı.`;
const sema = sssSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'tr' });
---
<Temel dil="tr" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={canon} helefen={sl(`${KOK}/en/sss`)} sema={sema}
  etiket="SSS">
  <SssGovde dil="tr" />
</Temel>
