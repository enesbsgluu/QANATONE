---
/* Faz 0 kanıt sayfası: en yalın hizmet sayfası (geo), sıfır JS.
   İçerik content.json'dan (Content Collections) — kıyas kapısı:
   bu sayfanın Lighthouse mobil skoru ↔ /hizmetler/geo skoru. */
import { getEntry } from 'astro:content';
const s = (await getEntry('hizmetler', 'geo'))!.data;
const T = (v: any): string => typeof v === 'string' ? v : (v && v.tr) || '';
const d = s.det;
---
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" /><!-- Faz 0 önizleme: kök siteyle kopya içerik doğurmasın -->
  <title>{T(d.h)} — QANATONE</title>
  <meta name="description" content={T(s.text).slice(0, 155)} />
</head>
<body>
  <header class="ust">
    <a class="logo" href="/">QANATONE</a>
    <span class="tag">{s.tag}</span>
  </header>

  <main>
    <section class="giris">
      <h1>{T(d.h)}</h1>
      <p class="lede">{T(d.lede)}</p>
      <ul class="hits">
        {d.hits.map((h: any) => <li>{T(h)}</li>)}
      </ul>
    </section>

    <section>
      <h2>Dert nerede</h2>
      <div class="kartlar">
        {d.pains.map((p: any) => (
          <article class="kart">
            <h3>{T(p.t)}</h3>
            <p>{T(p.d)}</p>
            {p.x && <p class="not">{T(p.x)}</p>}
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Nasıl çalışırız</h2>
      <ol class="adimlar">
        {d.steps.map((a: any) => (
          <li>
            <b>{a.n}</b>
            <div><h3>{T(a.t)}</h3><p>{T(a.d)}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>Eline ne geçer</h2>
      <ul class="teslim">
        {(d.del.tr || []).map((t: string) => <li>{t}</li>)}
      </ul>
    </section>

    <section class="olcu">
      {d.met.map((m: any) => (
        <div class="mk"><b>{T(m.v)}</b><span>{T(m.l)}</span></div>
      ))}
    </section>

    <section>
      <h2>Sık sorulanlar</h2>
      {d.faq.map((f: any) => (
        <details>
          <summary>{T(f.q)}</summary>
          <p>{T(f.a)}</p>
        </details>
      ))}
    </section>

    <section class="cta">
      <h2>{T(d.cta.t)}</h2>
      <p>{T(d.cta.s)}</p>
      <a class="dugme" href="/#iletisim">Konuşalım</a>
    </section>
  </main>

  <footer>© 2026 QANATONE · <a href="/">ana site</a></footer>
</body>
</html>

<style>
  :root{--bg:#050505;--tx:#f5f5f5;--tx2:rgba(255,255,255,.72);--tx3:rgba(255,255,255,.5);
    --red:#ef233c;--red-soft:#ff4d63;--line:rgba(255,255,255,.1);--card:#101010}
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:var(--bg);color:var(--tx);
    font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;line-height:1.65}
  .ust{display:flex;align-items:center;justify-content:space-between;
    max-width:840px;margin:0 auto;padding:22px 20px}
  .logo{color:var(--tx);text-decoration:none;font-weight:800;letter-spacing:.14em;font-size:.95rem}
  .tag{font-family:ui-monospace,monospace;font-size:.7rem;letter-spacing:.18em;color:var(--red-soft);
    border:1px solid rgba(239,35,60,.45);border-radius:999px;padding:5px 12px}
  main{max-width:840px;margin:0 auto;padding:24px 20px 60px}
  section{margin-bottom:56px}
  h1{font-size:clamp(1.7rem,5.4vw,2.6rem);letter-spacing:-.03em;line-height:1.15;margin-bottom:16px}
  h2{font-size:clamp(1.15rem,3vw,1.45rem);letter-spacing:-.02em;margin-bottom:18px}
  h3{font-size:1rem;margin-bottom:6px}
  .lede{color:var(--tx2);font-size:1.05rem;max-width:62ch}
  .hits{list-style:none;margin-top:18px;display:flex;flex-direction:column;gap:8px}
  .hits li{padding-left:18px;position:relative;color:var(--tx2)}
  .hits li::before{content:'';position:absolute;left:0;top:.55em;width:8px;height:2px;background:var(--red)}
  .kartlar{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
  .kart{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
  .kart p{color:var(--tx2);font-size:.92rem}
  .kart .not{margin-top:10px;color:var(--tx3);font-size:.84rem}
  .adimlar{list-style:none;display:flex;flex-direction:column;gap:14px}
  .adimlar li{display:flex;gap:14px;border:1px solid var(--line);border-radius:14px;padding:16px}
  .adimlar b{font-family:ui-monospace,monospace;color:var(--red-soft)}
  .adimlar p{color:var(--tx2);font-size:.92rem}
  .teslim{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:8px}
  .teslim li{border:1px solid var(--line);border-radius:10px;padding:11px 14px;color:var(--tx2);font-size:.92rem}
  .olcu{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
  .mk{border:1px solid var(--line);border-radius:14px;padding:16px}
  .mk b{display:block;color:var(--red-soft);margin-bottom:4px}
  .mk span{color:var(--tx3);font-size:.85rem}
  details{border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:10px}
  summary{cursor:pointer;font-weight:600}
  details p{margin-top:10px;color:var(--tx2);font-size:.93rem}
  .cta{border:1px solid rgba(239,35,60,.4);border-radius:18px;padding:28px;text-align:center;
    background:linear-gradient(180deg,rgba(239,35,60,.09),transparent)}
  .cta p{color:var(--tx2);max-width:56ch;margin:10px auto 20px}
  .dugme{display:inline-block;background:var(--red);color:#fff;text-decoration:none;
    padding:12px 26px;border-radius:999px;font-weight:600}
  footer{max-width:840px;margin:0 auto;padding:20px;color:var(--tx3);font-size:.85rem;
    border-top:1px solid var(--line)}
  footer a{color:var(--tx3)}
  @media(prefers-color-scheme:light){/* marka koyu — bilinçli tek görünüm */}
</style>
