---
/* Hizmetler dizini (TR) — rota turunun ilk sayfası. Baş sözleşmesi
   eski /hizmetler ile eşdeğer (S1): title/desc birebir, canonical
   canlı kök karşılığı, hreflang çifti. Şema eski @graph'ın göçü
   (dizinSema). Bekçisi R1. */
import Temel from '../layouts/Temel.astro';
import HizmetDizin from '../parcalar/HizmetDizin.astro';
import { icerik, KOK, sl } from '../icerik';
import { dizinSema } from '../sema.mjs';

const canon = sl(`${KOK}/hizmetler`);
const baslik = 'Hizmetler — QANATONE';
/* 15 Eyl 2026: açıklama EN eşiyle hizalandı (eskisi 53 karakterdi). Google
   site bağlantısının altında bu cümleyi gösterir. */
const aciklama = `SEO, GEO, Google ve Meta reklamları, yapay zekâ ajanları, otomasyon, web tasarımı ve çalışan araçlar: her biri tek bir sorunu çözen ${(icerik.services || []).length} hizmet.`;
const sema = dizinSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'tr' });
---
<Temel lead={false} dil="tr" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={canon} helefen={sl(`${KOK}/en/hizmetler`)} sema={sema}
  etiket="Ne yapıyoruz" genis>
  <HizmetDizin dil="tr" />
</Temel>
