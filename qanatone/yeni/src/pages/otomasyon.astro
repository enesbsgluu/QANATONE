---
/* Otomasyon (TR) — rota turunun SON sayfası. Rota adı eskiyle BİREBİR
   (/otomasyon). Baş sözleşmesi ROUTER.PAGES.ajan'dan; desc'in "canlı
   akış diyagramı" parçası BİLİNÇLİ değişti — akış statik doğuyor,
   olmayan canlılığı vadetmek H21/H22 ruhuna aykırı (perdenin sahte
   dolum kararıyla aynı ilke); yerine sayfanın gerçek üç bloğu yazıldı.
   Şema eski üçlü @graph birebir (özel blok yoktu). Bekçisi R7. */
import Temel from '../layouts/Temel.astro';
import OtomasyonGovde from '../parcalar/OtomasyonGovde.astro';
import { icerik, KOK } from '../icerik';
import { anaSema } from '../sema.mjs';

const canon = `${KOK}/otomasyon`;
const baslik = 'Otomasyon & AI Ajanları — QANATONE';
const aciklama = 'Talebi karşılayan ajan sistemi: akış mantığı, sızıntı haritası ve kendi rakamınla huni hesabı.';
const sema = anaSema(icerik, { url: canon, ad: baslik, aciklama, dil: 'tr' });
---
<Temel dil="tr" baslik={baslik} aciklama={aciklama} canonical={canon}
  heleftr={canon} helefen={`${KOK}/en/otomasyon`} sema={sema}
  etiket="Otomasyon">
  <OtomasyonGovde dil="tr" />
</Temel>
