.onbellek/
dist/
node_modules/
holding/.veri/
yeni/.astro/

# uretilebilir ana dosyalar: gorsel-kompoze.cjs / gorsel-kanal.cjs bunlari
# img/ altindaki kaynaklardan yeniden basar; yayina giren .webp varyantlar depoda
gorsel-kaynak/

# Local Netlify folder
.netlify

# GECE TUR 2c (1-2 Eyl 2026): film medyasi git disi kalir; onu getiren
# kurulum adimi yeni/film/kur-medya.cjs, kunyesi medya-manifest.json
# (TAKIPTE). Damga makineye ozgu, git disi — denetim MEDYA kapisi okur.
yeni/film/.medya-kurulum.json
# film uretim hattinin OLCUM artiklari (yeni/film/uret.cjs `bounds` + dikis.cjs
# kiyas kareleri, ~150 MB PNG): yeniden uretilir, hukmu dikis.json tasir.
# olcum/ `/*` ile dislanir ki FM1'in HUKUM kaydi sonuc.json ISTISNAYLA
# takibe girebilsin — "Sonuc JSON'lari takipte, uretim artiklari degil".
yeni/film/dikis/
yeni/film/dikis-ham/
yeni/film/olcum/*
!yeni/film/olcum/sonuc.json
# PNG posterler ARA URUN: sayfa WebP okur. public/ disinda tutulur ki
# dist'e kopyalanip yayina cikmasin (olculdu: 87,9 MiB bos yuk).
yeni/film/poster-ham/
yeni/film/taban-cikti.txt
yeni/film/taban-log.txt
yeni/film/.404.cjs
# kontak sayfasi + CRF tarama ornek kareleri: Enes'in goz karari icin
# uretilir, hukmu taban.json / crf-tarama.json tasir.
yeni/film/kontak/
yeni/film/crf-tarama/

# PROLOG-ISKELET (31 Agu 2026) olcum artiklari — kare PNG'leri ve deneme
# encode'lari. Sonuc JSON'lari takipte, uretim artiklari degil.
yeni/film/butce-gecici/
yeni/film/.dikis-yerel/
yeni/film/.dogrula/

# PROLOG-KAPANIS-v2 (31 Agu 2026): olcum dizini commit'lenir ama ARTIKLARI
# degil. Kural sudur: .cjs/.json/.md takipte (temiz klonda FM1 girdi bulur),
# uretilen kare/encode yiginlari takipte DEGIL — 1,4 GB'lik PNG ve mp4
# yeniden uretilebilir, depoya girmez.
yeni/film/kesit-dikis/
yeni/film/kesit-poster-ham/
yeni/film/kesit-elenen/
yeni/film/deneme-fps/
yeni/film/kontak/
yeni/film/.kontak39/
yeni/film/.kesit-dikis-kare/
yeni/public/varlik/kesit/
yeni/film/.kodek/

# kare hizi turu aday setleri (400 MB, olcum kaydi json'larda)
yeni/film/karehizi/
