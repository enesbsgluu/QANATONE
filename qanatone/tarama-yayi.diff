+/* ============ TARAMA YAYI — "Sitemi ücretsiz kontrol et" (2026-08) ============
+   Enes'in isteği + kararı: buton çerçevesinde dönen kırmızı ışık,
+   biçimi "taramalı" — sürekli parlayan halka değil, birkaç saniyede
+   bir turlayan KUYRUKLU kıvılcım. Teknik: ::after inset:-2px, konik
+   gradyanın yalnız son ~%22'si dolu (kuyruk), maske xor'u ile 2px'lik
+   çerçeve bandına kırpılır, @property'li --taraA açısı döner. Döngünün
+   son ~%38'i karanlık: "aralıklı" hissi buradan. Kayıtlı özellik
+   desteklemeyen eski tarayıcıda açı animasyonu çalışmaz, yay statik
+   soluk kalır — buton bozulmaz. REDUCE'da tamamen kapalı.            */
+@property --taraA{syntax:'<angle>';initial-value:0deg;inherits:false}
+.btn[data-t="cta1"]{position:relative;isolation:isolate}
+.btn[data-t="cta1"]::after{content:'';position:absolute;inset:-2.5px;z-index:-1;
+  border-radius:999px;padding:2.5px;pointer-events:none;
+  background:conic-gradient(from var(--taraA),
+    transparent 0 76%,
+    rgba(239,35,60,.14) 82%,
+    rgba(239,35,60,.85) 93%,
+    #ff96a6 99.2%,
+    transparent 100%);
+  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
+  -webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
+  mask-composite:exclude;
+  animation:btnTara 3.6s linear infinite}
+@keyframes btnTara{
+  0%{--taraA:0deg;opacity:1}
+  58%{--taraA:360deg;opacity:1}
+  63%{--taraA:360deg;opacity:0}
+  100%{--taraA:360deg;opacity:0}}
+@media(prefers-reduced-motion:reduce){.btn[data-t="cta1"]::after{animation:none;opacity:0}}
+
 /* dönen kenarlıklı CTA */
 @property --ga{syntax:"<angle>";initial-value:0deg;inherits:false}
